<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:tab="sap.ui.table">
    <Dialog id="IDOCParamMap"
            icon="sap-icon://share"
            title="{i18n>FlowParamMapTitle}"
            contentWidth="80%"
            contentHeight="80%">
        <content>
            <Table id="table-idoc-param-map" noDataText="{i18n>commonNoData}" items="{/Row}" class="sapUiSizeCompact" sticky="ColumnHeaders,HeaderToolbar">
                <headerToolbar>
                    <Toolbar>
                        <ToolbarSpacer></ToolbarSpacer>
                        <Button id="table-idoc-param-add" icon="sap-icon://add" type="Transparent" press="fnAddParamMap" />
                    </Toolbar>
                </headerToolbar>
                <columns>
                    <Column hAlign="Left" width="40%">
                        <Text text="{i18n>FlowParamMapSource}"/>
                    </Column>
                    <Column hAlign="Left" width="40%">
                        <Text text="{i18n>FlowParamMapDest}"/>
                    </Column>
                    <Column hAlign="Center" width="8%">
                        <Text text="{i18n>FlowParamMapDyn}"/>
                    </Column>
                    <Column hAlign="Center" width="8%" visible="{/Repeat}">
                        <Text text="{i18n>FlowParamMapRep}"/>
                    </Column>
                    <Column hAlign="Center" width="6%">
                        <Text text="{i18n>commonDelete}"/>
                    </Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Input value="{DS_SOURCE_MAP}" width="100%" visible="true"/>
                            <Input value="{DS_DESTINATION_MAP}" width="100%" visible="true"/>
                            <CheckBox selected="{FL_DYNAMIC}"/>
                            <CheckBox selected="{FL_REPEAT}"/>
                            <Button icon="sap-icon://delete" tooltip="{i18n>commonDelete}" type="Transparent" press="fnDeleteParamMap"/>
                         </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Dialog>
</core:FragmentDefinition>