<core:FragmentDefinition xmlns:core="sap.ui.core"
                         xmlns="sap.m"
                         xmlns:tab="sap.ui.table">
    <Dialog id="AffectedDataFlows"
            title="{/DialogTitle}"
            contentWidth="70%">
        <content>
            <MessageStrip
            text="{/Message}"
            type="{/MessageType}"
            showIcon="true"
            class="sapUiTinyMargin">
</MessageStrip>	
            <Table id="table-affected-flows" width="auto" noDataText="{i18n>commonNoData}" items="{path: '/Row'}" showSeparators="All">
                <columns>
                    <Column hAlign="Left" width="20%" vAlign="Middle" minScreenWidth="Desktop" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
                        <header>
                            <Text text="{i18n>commonLabelPlant}" width="auto" maxLines="1" wrapping="false" textAlign="Begin" textDirection="Inherit" visible="true"/>
                        </header>
                        <footer/>
                    </Column>
                    <Column hAlign="Left" width="auto" vAlign="Middle" minScreenWidth="Desktop" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
                        <header>
                            <Text text="{i18n>commonLabelDataSource}" width="auto" maxLines="1" wrapping="false" textAlign="Begin" textDirection="Inherit" visible="true"/>
                        </header>
                        <footer/>
                    </Column>
                    <Column  visible="{= ! ${/TagColumnDisplay}}" hAlign="Left" width="20%" vAlign="Middle" minScreenWidth="Desktop" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
                        <header>
                            <Text text="{i18n>flowType}" width="auto" maxLines="1" wrapping="false" textAlign="Begin" textDirection="Inherit" visible="true"/>
                        </header>
                        <footer/>
                    </Column>
                    <Column  visible="{= ! ${/TagColumnDisplay}}" hAlign="Left" width="auto" vAlign="Middle" minScreenWidth="Tablet" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
                        <header>
                            <Text text="{i18n>flowName}" width="auto" maxLines="1" wrapping="false" textAlign="Begin" textDirection="Inherit" visible="true"/>
                        </header>
                        <footer/>
                    </Column>  
	       <Column visible="{/TagColumnDisplay}" hAlign="Left" width="20%" vAlign="Middle" minScreenWidth="Desktop" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
                        <header>
                            <Text text="{i18n>tagInfoOriginalTagName}" width="auto" maxLines="1" wrapping="false" textAlign="Begin" textDirection="Inherit" visible="true"/>
                        </header>
                        <footer/>
                    </Column>
                    <Column visible="{/TagColumnDisplay}" hAlign="Left" width="auto" vAlign="Middle" minScreenWidth="Tablet" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
                        <header>
                            <Text text="{i18n>commonLabelRenamedTag}" width="auto" maxLines="1" wrapping="false" textAlign="Begin" textDirection="Inherit" visible="true"/>
                        </header>
                        <footer/>
                    </Column>               
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                       	   <Text text="{PLANT}" width="auto" textAlign="Begin" textDirection="Inherit" visible="true"/>
                            <Text text="{SOURCE}" width="auto" textAlign="Begin" textDirection="Inherit" visible="true"/>
                            <Text text="{ID_FLOW_TYPE}" width="auto" textAlign="Begin" textDirection="Inherit" visible="true"/>
                            <Text text="{FLOW}" width="auto" textAlign="Begin" textDirection="Inherit" visible="true"/>
		  <Text text="{ORIGINAL_NAME}" width="auto" textAlign="Begin" textDirection="Inherit" visible="true"/>
		  <Text text="{RENAMED_TAG}" width="auto" textAlign="Begin" textDirection="Inherit" visible="true"/>
                         </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
        <buttons>
            <Button id="affected-flows-confirm" enabled="{/ConfirmButtonEnabled}"  type="Accept" icon="sap-icon://accept" text="{i18n>commonConfirm}" press="fnConfirmDisableDataDestination"/>
            <Button id="affected-flows-close"  type="Reject" icon="sap-icon://decline" text="{i18n>commonCancel}" press="fnCancelDisableDataDestination"/>			
        </buttons>
    </Dialog>
</core:FragmentDefinition>