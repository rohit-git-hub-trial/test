<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
	<Dialog id="dialog-request-comment" title="{RequestCommentView>/Title}" class="sapUiContentPadding" contentWidth="28rem">
		<f:SimpleForm id="form-request-comment" editable="true" layout="ResponsiveGridLayout" labelSpanXL="12" labelSpanL="12"
			labelSpanM="12" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0"
			columnsXL="1" columnsL="1" columnsM="1" singleContainerFullSize="false">
			<f:content>
				<Label text="{i18n>historicalUploadStatusComment}" required="true"/>
				<TextArea id="textarea-request-comment" rows="4" width="100%" value="{RequestCommentView>/Comment}"
					placeholder="{i18n>historicalUploadStatusCommentPlaceholder}" liveChange="fnCommentChanged"/>
				<Text id="text-request-comment-error" text="{i18n>historicalUploadStatusCommentMandatory}" class="sapUiTinyMarginTop"
					visible="false"/>
			</f:content>
		</f:SimpleForm>
		<buttons>
			<Button id="button-request-comment-confirm" type="Emphasized" text="{RequestCommentView>/ConfirmText}" press="fnConfirmRequestComment"/>
			<Button id="button-request-comment-cancel" icon="sap-icon://sys-cancel" text="{i18n>commonClose}" press="fnCloseRequestCommentDialog"/>
		</buttons>
	</Dialog>
</core:FragmentDefinition>
