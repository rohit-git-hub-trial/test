<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
    <Dialog title="{i18n>tagCatalogInitialLoadSummary}">
        <Table id="historical-upload-report" noDataText="{i18n>commonNoData}" title="{i18n>tagCatalogInitialLoadSummary}" items="{/Row}">
            <ColumnListItem>
                <cells>
 	       <Text text="{Plant}" width="auto" textAlign="Begin" textDirection="Inherit" visible="true" />
                    <Text text="{DataSourceName}" width="auto" textAlign="Begin" textDirection="Inherit" visible="true" />
                    <Text text="{FlowName}" width="auto" textAlign="Begin" textDirection="Inherit" visible="true" />
                    <core:Icon src="{ path:'Status', formatter: '.formatter.statusIconInitialLoad' }" size="20px" color="{ path:'Status', formatter: '.formatter.statusColorInitialLoad' }" visible="true" />
                    <Text text="{ResponseMessage}" width="auto" textAlign="Begin" textDirection="Inherit" visible="true" />
                </cells>
            </ColumnListItem>
            <columns>
	 <Column width="20%" hAlign="Center" vAlign="Top" minScreenWidth="Desktop" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
                    <header>
                        <Text text="{i18n>commonLabelPlant}" width="auto" maxLines="1" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true" />
                    </header>
                    <footer />
                </Column>
                <Column width="20%" hAlign="Center" vAlign="Top" minScreenWidth="Desktop" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
                    <header>
                        <Text text="{i18n>commonLabelDataSource}" width="auto" maxLines="1" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true" />
                    </header>
                    <footer />
                </Column>
                <Column width="30%" hAlign="Left" vAlign="Top" minScreenWidth="Tablet" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
                    <header>
                        <Text text="{i18n>flowInfoName}" width="auto" maxLines="1" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true" />
                    </header>
                    <footer />
                </Column>
                <Column width="10%" hAlign="Center" vAlign="Top" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" mergeDuplicates="false">
                    <header>
                        <Text text="{i18n>tagCatalogInitialLoadTagIdStatus}" width="auto" maxLines="1" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true" />
                    </header>
                    <footer />
                </Column>
                <Column width="30%" hAlign="Left" vAlign="Top" minScreenWidth="Tablet" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
                    <header>
                        <Text text="{i18n>tagCatalogInitialLoadTagMessage}" width="auto" maxLines="1" wrapping="false" textAlign="Begin" textDirection="Inherit" visible="true" />
                    </header>
                    <footer />
                </Column>
            </columns>
        </Table>
        <buttons>
            <Button id="historical-load-close" type="Reject" icon="sap-icon://decline" text="{i18n>commonClose}" press="fnCloseHistoricalUploadPopUp" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>