<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<TableSelectDialog id="table-select-restore-value" noDataText="{i18n>commonRestoreNoPrevValuesFound}" title="{i18n>commonRestoreTitle}" search="fnSearchRestorePopup" items="{/Row}" confirm="fnConfirmRestore"
		cancel="fnCancelRestore">
		<ColumnListItem>
			<cells>
				<Text text="{DT_TIMESTAMP}"/>
				<Text text="{DS_USERNAME}"/>
				<Text text="{DS_VALUE_NEW}"/>
			</cells>
		</ColumnListItem>
		<columns>
			<Column hAlign="Left">
				<header>
					<Text text="{i18n>commonRestoreDateTime}"/>
				</header>
			</Column>
			<Column hAlign="Left">
				<header>
					<Text text="{i18n>commonRestoreUser}"/>
				</header>
			</Column>
			<Column hAlign="Left">
				<header>
					<Text text="{i18n>commonRestorePreviousValue}"/>
				</header>
			</Column>
		</columns>
	</TableSelectDialog>
</core:FragmentDefinition>