<mvc:View id="view-File-Flows" controllerName="StreamingEngine.StreamingEngine.controller.FileFlows" xmlns:mvc="sap.ui.core.mvc" xmlns:fb="sap.ui.comp.filterbar"
	xmlns:core="sap.ui.core" xmlns:html="http://www.w3.org/1999/xhtml" xmlns="sap.m" width="100%">
	<App>
		<pages>
			<Page id="page-File-flows" visible="false" showHeader="false" showFooter="{= ${message>/}.length > 0 }" floatingFooter="true">
			<content>
			<fb:FilterBar id="filterbar-File-flows" reset="onSearch" search="onSearch" showRestoreButton="false" showClearButton="true" showFilterConfiguration="false" useToolbar="false" class="filterBar">
				<fb:filterGroupItems>
					<fb:FilterGroupItem groupName="GroupFileFlowsFilter" name="A" label="{i18n>commonLabelPlant}" visibleInFilterBar="true">
						<fb:control>
							<ComboBox id="combobox-plant" placeholder="Select a Plant" required="true"  items="{/Row}" selectionChange="fnPlantSelected">
							     <items>
							        <core:Item key="{ID_PLANT}" text="{DS_NAME}"/>
							     </items>
							</ComboBox>	
						</fb:control>
					</fb:FilterGroupItem>
					<fb:FilterGroupItem groupName="GroupFileFlowsFilter" name="B" label="{i18n>commonLabelDataSource}" visibleInFilterBar="true">
						<fb:control>
							<ComboBox id="combobox-data-source" placeholder="Select a Plant" required="true"  items="{/Row}" selectionChange="onSearch">
							     <items>
							        <core:Item key="{ID_SOURCE}" text="{DS_NAME}"/>
							     </items>
							</ComboBox>	
						</fb:control>
					</fb:FilterGroupItem>
					<fb:FilterGroupItem groupName="GroupFileFlowsFilter" name="C" label="{i18n>commonLabelDataFlow}" visibleInFilterBar="true">
						<fb:control>
							<Input id="input-data-flow" type="Text" width="100px" change="onSearch"/>
						</fb:control>
					</fb:FilterGroupItem>
				</fb:filterGroupItems>							
		    </fb:FilterBar>
	    	<MessageStrip
					id="messagestrip-run-flow-manually"
					visible="false"
					text="{i18n>commonBackgroundProcessMessage}"
					type="Success"
					showIcon="true"
					showCloseButton="true"
					class="sapUiTinyMargin"/>
		    <core:Fragment fragmentName="StreamingEngine.StreamingEngine.view.BusyDialog" type="XML">
			</core:Fragment>
		    <Table id="table-File-flows" sticky= "ColumnHeaders,HeaderToolbar"  width="auto" noDataText="{i18n>commonNoData}" mode="SingleSelectLeft" selectionChange="fnSelectionChanged" items="{/Row}" showSeparators="All" growing="true" growingThreshold="20" growingScrollToLoad="true" class="sapUiResponsiveMargin tableStyle">
		    	<headerToolbar>
                    <OverflowToolbar>
							<Button text="{i18n>fileFlowAdd}" type="Default" press="fnAddNew" icon="sap-icon://add" iconFirst="true">
							</Button>
							<!--Button id="button-run-flow-manually" text="{i18n>flowRunManually}" icon="sap-icon://play" iconFirst="true" width="auto" enabled="true" visible="true" iconDensityAware="false" press="fnRunFlowManually"/-->
						<ToolbarSpacer/>
						<OverflowToolbarButton text="{i18n>commonSort}" type="Transparent" icon="sap-icon://sort" iconFirst="true" width="auto" enabled="true" visible="true"
							iconDensityAware="false" press="fnViewSettingsButtonPressed"/>
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
               		 <Column hAlign="Left" vAlign="Top" minScreenWidth="Desktop" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
                        <header>
                            <Text text="{i18n>commonLabelPlant}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
                        </header>
                        <footer/>
                    </Column>
                    <Column hAlign="Left" vAlign="Top" minScreenWidth="Desktop" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
                        <header>
                            <Text text="{i18n>flowDS}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
                        </header>
                        <footer/>
                    </Column>
                    <Column hAlign="Left" vAlign="Top" minScreenWidth="Tablet" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
                        <header>
                            <Text text="{i18n>flowType}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
                        </header>
                        <footer/>
                    </Column>
                    <Column hAlign="Left" vAlign="Top" minScreenWidth="Tablet" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
                        <header>
                            <Text text="{i18n>flowName}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
                        </header>
                        <footer/>
                    </Column>
                    <Column hAlign="Left" vAlign="Top" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" mergeDuplicates="false">
                        <header>
                            <Text text="{i18n>flowDesc}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
                        </header>
                        <footer/>
                    </Column>
                    <Column width="5%" hAlign="Center" vAlign="Top" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" mergeDuplicates="false">
                        <header>
                            <Text text="{i18n>flowCompressed}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
                        </header>
                        <footer/>
                    </Column>
                    <Column width="5%" hAlign="Center" vAlign="Top" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" mergeDuplicates="false">
                        <header>
                            <Text text="{i18n>flowEnabled}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
                        </header>
                        <footer/>
                    </Column>
                </columns>
                <items>
                    <ColumnListItem type="Navigation" press="fnRowPress">
                        <cells>
                       		<Text text="{PLANT}" />
                            <Text text="{SOURCE_NAME}" />
                            <Text text="{FLOW_TYPE}" />
                            <Text text="{DS_NAME}" class="textHighlight" />
                            <Text text="{DS_DESCRIPTION}" />
                           <core:Icon src="sap-icon://attachment-zip-file" size="20px" visible="{=${FL_COMPRESSED}==='1'}" color="{=${FL_COMPRESSED}==='1'?'green':'red'}"/>
                            <core:Icon src="sap-icon://circle-task-2" size="20px" color="{=${FL_ENABLED}==='1'?'green':'red'}" visible="true"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
		</content>
		<headerContent>
            <Image src="images/sanofi_logo.png" height="auto" width="100px" visible="true" densityAware="false"/>
        </headerContent>
				<footer>
					<Toolbar visible="{= ${message>/}.length > 0 }">
						<content>
								<Button icon="sap-icon://message-popup" text="{= ${message>/}.length }" visible="{= ${message>/}.length > 0 }"  press="onMessagePopoverPress" />
						</content>
					</Toolbar>
				</footer>
        </Page>
        </pages>
	</App>
</mvc:View>