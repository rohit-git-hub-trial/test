<mvc:View id="view-flow-monitoring" controllerName="StreamingEngine.StreamingEngine.controller.FlowMonitoring" xmlns:mvc="sap.ui.core.mvc"
	xmlns:fb="sap.ui.comp.filterbar" xmlns:core="sap.ui.core" xmlns:html="http://www.w3.org/1999/xhtml" xmlns="sap.m" width="100%">
	<App>
		<pages>
			<Page id="page-flow-monitoring" visible="false" showHeader="false" showFooter="{= ${message>/}.length > 0 }" floatingFooter="true">
				<content>
					<fb:FilterBar id="filterbar-flow-monitoring" showRestoreButton="false" showClearButton="false" search="fnLoadFlowMonitoring" showFilterConfiguration="false" useToolbar="false" class="filterBar">
						<fb:filterGroupItems>
							<fb:FilterGroupItem groupName="GroupFlowMonitoringFilter" name="A" label="{i18n>commonLabelPlant}" visibleInFilterBar="true">
								<fb:control>
									<ComboBox id="combobox-plant" placeholder="{i18n>commonSelectAPlantPlaceHolder}" items="{/Row}" selectionChange="fnPlantSelected">
										<items>
											<core:Item key="{DS_NAME}" text="{DS_NAME}"/>
										</items>
									</ComboBox>
								</fb:control>
							</fb:FilterGroupItem>
							<fb:FilterGroupItem groupName="GroupFlowMonitoringFilter" name="B" label="{i18n>commonLabelDataSource}" visibleInFilterBar="true">
								<fb:control>
									<ComboBox id="combobox-data-source" placeholder="Select a Data Source" items="{/Row}" selectionChange="fnLoadFlowMonitoring">
										<items>
											<core:Item key="{DS_NAME}" text="{DS_NAME}"/>
										</items>
									</ComboBox>
								</fb:control>
							</fb:FilterGroupItem>
							<fb:FilterGroupItem groupName="GroupFlowMonitoringFilter" name="C" label="{i18n>flowMonitoringAggregate}" visibleInFilterBar="true">
								<fb:control>
									<Switch id="switch-aggregate" state="false" customTextOn="{i18n>commonYes}" customTextOff="{i18n>commonNo}" change="fnLoadFlowMonitoring" />
								</fb:control>
							</fb:FilterGroupItem>
						</fb:filterGroupItems>
					</fb:FilterBar>
					<core:Fragment fragmentName="StreamingEngine.StreamingEngine.view.BusyDialog" type="XML"></core:Fragment>
					<Table id="table-flow-monitoring" sticky= "ColumnHeaders,HeaderToolbar"  width="auto" noDataText="No data" mode="None" items="{/Row}"
						showSeparators="All" growing="true" growingThreshold="20" growingScrollToLoad="true"
						updateStarted="fnGrowingStarted" class="sapUiResponsiveMargin tableStyle">
						<headerToolbar>
							<OverflowToolbar>
								<!-- <Title text="{i18n>flowMonitoring}" level="H4"/> -->
								<!-- <Title id="title-time" text="{i18n>auditLogDefaultDuration}" level="H4" visible="false"/> -->
							</OverflowToolbar>
						</headerToolbar>
						<columns>
							<Column hAlign="Center" vAlign="Top" width="10%" minScreenWidth="Desktop" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>commonLabelPlant}" width="auto" maxLines="1" wrapping="false" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column hAlign="Left" vAlign="Top" width="10%" minScreenWidth="Desktop" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>commonLabelDataSource}" width="auto" maxLines="1" wrapping="false" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column hAlign="Left" vAlign="Top" width="10%" minScreenWidth="Desktop" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>flowName}" width="auto" maxLines="1" wrapping="false" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column hAlign="Left" vAlign="Top" minScreenWidth="Tablet" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>flowMonitoringExecutionDate}" width="auto" maxLines="1" wrapping="false" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column hAlign="Left" vAlign="Top" minScreenWidth="Tablet" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>jobsMonitoringStartDate}" width="auto" maxLines="1" wrapping="false" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column hAlign="Left" vAlign="Top" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>jobsMonitoringEndDate}" width="auto" maxLines="1" wrapping="false" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column hAlign="Left" vAlign="Top" width="15%" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>flowMonitoringSourceRowCount}" width="auto" maxLines="2" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column hAlign="Left" vAlign="Top" width="15%" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>flowMonitoringJSONRowCount}" width="auto" maxLines="2" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
						</columns>
						<items>
							<ColumnListItem>
								<cells>
									<Text text="{DS_PLANT}" width="auto" textAlign="Begin" textDirection="Inherit" visible="true"/>
									<Text text="{DS_SOURCE}" width="auto" textAlign="Begin" textDirection="Inherit" visible="true"/>
									<Text text="{DS_FLOW}" width="auto" textAlign="Begin" textDirection="Inherit" visible="true"/>
									<Text text="{DT_RUN_TIME}" width="auto" textAlign="Begin" textDirection="Inherit" visible="true"/>
									<Text text="{DT_START_DATE}" width="auto" textAlign="Begin" textDirection="Inherit" visible="true"/>
									<Text text="{DT_END_DATE}" width="auto" textAlign="Begin" wrapping="true" wrappingType="Hyphenated" textDirection="Inherit" visible="true"/>
									<ObjectStatus text="{QT_SOURCE_ROWCOUNT}" state="{= ${QT_SOURCE_ROWCOUNT} === ${QT_JSON_ROWCOUNT} ? 'Success' : 'Error'}" width="auto" textAlign="Begin" wrapping="true" wrappingType="Hyphenated" textDirection="Inherit" visible="true"/>
									<ObjectStatus text="{QT_JSON_ROWCOUNT}" state="{= ${QT_SOURCE_ROWCOUNT} === ${QT_JSON_ROWCOUNT} ? 'Success' : 'Error'}" width="auto" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</cells>
							</ColumnListItem>
						</items>
					</Table>
				</content>
				<headerContent>
					<Image src="images/sanofi_logo.png" height="auto" width="100px" visible="true" densityAware="false"/>
				</headerContent>
				<footer>
					<Toolbar visible="{= ${message>/}.length > 0 }">
						<content>
							<Button icon="sap-icon://message-popup" text="{= ${message>/}.length }" visible="{= ${message>/}.length > 0 }"  press="onMessagePopoverPress" />
						</content>
					</Toolbar>
				</footer>
			</Page>
		</pages>
	</App>
</mvc:View>