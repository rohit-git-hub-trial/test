<mvc:View id="view-pco-monitoring" controllerName="StreamingEngine.StreamingEngine.controller.PcoMonitoring" xmlns:mvc="sap.ui.core.mvc"
	xmlns:fb="sap.ui.comp.filterbar" xmlns:core="sap.ui.core" xmlns:html="http://www.w3.org/1999/xhtml" xmlns="sap.m" width="100%">
	<App>
		<pages>
			<Page id="page-pco-monitoring" visible="false" showHeader="false" showFooter="{= ${message>/}.length > 0 }" floatingFooter="true">
				<content>
					<fb:FilterBar id="filterbar-pco-monitoring" reset="onSearch" search="fnLoadPcoMonitoring" showRestoreButton="false" showClearButton="true"
						showFilterConfiguration="false" useToolbar="false" class="filterBar">
						<fb:filterGroupItems>
							<fb:FilterGroupItem groupName="GroupDataSourceFilter" name="A" label="{i18n>commonLabelPlant}" visibleInFilterBar="true">
								<fb:control>
									<ComboBox id="combobox-plant" placeholder="{i18n>commonSelectAPlantPlaceHolder}" items="{/Row}" selectionChange="fnLoadPcoMonitoring">
										<items>
											<core:Item key="{ID_PLANT}" text="{DS_NAME}"/>
										</items>
									</ComboBox>
								</fb:control>
							</fb:FilterGroupItem>
						</fb:filterGroupItems>
					</fb:FilterBar>
					<core:Fragment fragmentName="StreamingEngine.StreamingEngine.view.BusyDialog" type="XML"></core:Fragment>
					<Table id="table-pco-monitoring" sticky= "ColumnHeaders,HeaderToolbar" width="auto" noDataText="{i18n>commonNoData}" mode="SingleSelectMaster" selectionChange="fnSelectionChanged"
						items="{/Row}" showSeparators="All" growing="true" growingThreshold="20" growingScrollToLoad="true" class="sapUiResponsiveMargin tableStyle">
						<headerToolbar>
							<OverflowToolbar>
								<Title text="{i18n>pcoMonitoringPcoAgentsList}" level="H4"/>
								<ToolbarSpacer/>
								<Button id="button-restart-agent" text="{i18n>pcoMonitoringRestartAgent}" icon="sap-icon://restart" iconFirst="true" width="auto" enabled="false"
									visible="false" iconDensityAware="false" press="fnRestartAgent"/>
								<Button id="button-tag-list" text="{i18n>pcoMonitoringViewTagList}" icon="sap-icon://message-information" iconFirst="true" width="auto" enabled="false"
									visible="true" iconDensityAware="false" press="fnViewTagsList"/>
							</OverflowToolbar>
						</headerToolbar>
						<columns>
							<Column hAlign="Center" vAlign="Top" minScreenWidth="Desktop" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>pcoMonitoringID}" width="auto"  wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column hAlign="Left" vAlign="Top" minScreenWidth="Desktop" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>commonLabelPlant}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column hAlign="Left" vAlign="Top" minScreenWidth="Tablet" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>commonLabelDataSource}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column hAlign="Left" vAlign="Top" minScreenWidth="Tablet" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>pcoMonitoringPcoAgent}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column hAlign="Right" vAlign="Top" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>pcoMonitoringTags}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column hAlign="Right" vAlign="Top" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>pcoMonitoringAgentState}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column hAlign="Center" vAlign="Top" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>pcoMonitoringStatus}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
						</columns>
						<items>
							<ColumnListItem>
								<cells>
									<Text text="{ROW_ID}" />
									<Text text="{PLANT}" />
									<Text text="{SOURCE}"/>
									<Text text="{AGENT}" />
									<Text text="{QT_TAG_COUNT}" />
									<Text text="{ path:'STATUS', formatter: '.formatter.statusPcoMonitoringText' }" />
									<core:Icon src="{ path:'STATUS', formatter: '.formatter.statusPcoMonitoringIcon' }" size="20px"
										color="{ path:'STATUS', formatter: '.formatter.statusPcoMonitoring' }" />
								</cells>
							</ColumnListItem>
						</items>
					</Table>
				</content>
				<headerContent>
					<Image src="images/sanofi_logo.png" height="auto" width="100px" visible="true" densityAware="false"/>
				</headerContent>
<footer>
					<Toolbar visible="{= ${message>/}.length > 0 }">
						<content>
								<Button icon="sap-icon://message-popup" text="{= ${message>/}.length }" visible="{= ${message>/}.length > 0 }"  press="onMessagePopoverPress" />
						</content>
					</Toolbar>
				</footer>
			</Page>
		</pages>
	</App>
</mvc:View>