<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
		<Dialog
		title="{i18n>flowSqlTestResult}" stretch="true">
		<Table id="table-sql-test" growing="true" columns="{/Rowset/0/Columns/Column}"  growingThreshold="15">
				<columns>
					<Column>
						<Text text="{Name}" />
					</Column>
				</columns>
				<items>

				</items>
		</Table>
		<Table id="table-sql-test-error" growing="true" visible="false" growingThreshold="15">
				<columns>
					<Column hAlign="Center">
						<Text id="text-error-column-name" text="" />
					</Column>
				</columns>
				<items>
					<ColumnListItem>
						<cells>
							<Text id="text-error-text" text="" />
						</cells>
					</ColumnListItem>
				</items>
		</Table>
		<buttons>
				<Button
					id="button-close"
					type="Reject"
					icon="sap-icon://decline"
					text="{i18n>commonClose}"
					press="fnClosePopOver" />
		</buttons>
	</Dialog>
</core:FragmentDefinition>