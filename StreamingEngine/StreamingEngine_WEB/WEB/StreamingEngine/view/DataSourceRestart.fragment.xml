<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
	<Dialog title="{i18n>dsPCoConnectionsAvailable}">
		<f:SimpleForm id="form-data-server-type" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="4" labelSpanM="12" labelSpanS="12"
			adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="2" columnsM="2"
			singleContainerFullSize="false">
			<f:content>
				<CheckBox id="FLAG_PROCESS" text="{i18n>dsDataServerProcess}"/>
				<CheckBox id="FLAG_CONTEXTUAL" text="{i18n>dsDataServerContextual}"/>		
			</f:content>
		</f:SimpleForm>
		<buttons>
		
			<Button id="button-restart-data-server-type" type="Accept" icon="sap-icon://restart" text="{i18n>commonRestart}" press="fnRestart"/>
			<Button id="button-close-data-server-type" type="Reject" icon="sap-icon://decline" text="{i18n>commonClose}" press="fnClosePopOver"/>
		</buttons>
	</Dialog>
</core:FragmentDefinition>