<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
		<Dialog
		title="{i18n>queueMonitoringDeleteExpiredMessageTitle}"
		class="sapUiContentPadding">
		<f:SimpleForm id="SPCUpdateTargetForm2"
			editable="false"
			layout="ResponsiveGridLayout"
			labelSpanXL="4"
			labelSpanL="4"
			labelSpanM="12"
			labelSpanS="12"
			adjustLabelSpan="false"
			emptySpanXL="0"
			emptySpanL="0"
			emptySpanM="0"
			emptySpanS="0"
			columnsXL="2"
			columnsL="2"
			columnsM="2"
			singleContainerFullSize="false">
			<f:content>

				<Label text="{i18n>commonLabelPlant}" required="true" />
				<ComboBox id="combobox-plant-popup2" placeholder="{i18n>commonSelectAPlantPlaceHolder}"  items="{/Row}" selectionChange="fnPlantSelectedPopup2">
				     <items>
				        <core:Item key="{ID_PLANT}" text="{DS_NAME}"/>
				     </items>
				</ComboBox>	
			</f:content>
		</f:SimpleForm>
		<buttons>
			
				<Button
					id="button-save2"
					type="Accept"
					icon="sap-icon://reset"
					text="{i18n>queueMonitoringDeleteMessagesPopUpButton}"
					press="fnDeleteQueue" />
	<Button
					id="button-close2"
					icon="sap-icon://sys-cancel" 
					text="{i18n>commonClose}"
					press="fnClosePopOver2" />
		</buttons>
	</Dialog>
</core:FragmentDefinition>