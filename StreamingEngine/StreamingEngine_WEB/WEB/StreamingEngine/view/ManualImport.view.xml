<mvc:View id="view-manual-import" controllerName="StreamingEngine.StreamingEngine.controller.ManualImport" xmlns:mvc="sap.ui.core.mvc"
	xmlns:fb="sap.ui.comp.filterbar" xmlns:core="sap.ui.core" xmlns:html="http://www.w3.org/1999/xhtml" xmlns="sap.m" width="100%">
	<App>
		<pages>
			<Page id="page-manual-import" visible="false" showHeader="false" showFooter="{= ${message>/}.length > 0 }" floatingFooter="true">
				<content>
					<fb:FilterBar id="filterbar-manual-import" reset="onReset" search="onSearch" showRestoreButton="false" showClearButton="false"
						showFilterConfiguration="false" useToolbar="false" class="filterBar">
					</fb:FilterBar>
					<core:Fragment fragmentName="StreamingEngine.StreamingEngine.view.BusyDialog" type="XML"></core:Fragment>
					<Table id="table-manual-import" sticky= "ColumnHeaders,HeaderToolbar"  width="auto" noDataText="{i18n>commonNoData}" mode="Delete" items="{/Row}" showSeparators="All" growing="true"
						growingThreshold="20" growingScrollToLoad="true" class="sapUiResponsiveMargin tableStyle" delete="fnRowDelete">
						<headerToolbar>
							<OverflowToolbar>
								<Button text="{i18n>manualImportExportExcel}" type="Default" icon="sap-icon://upload" iconFirst="true" width="auto" enabled="true" visible="true"
									iconDensityAware="false" press="fnExportToExcel"/>
								<Button text="{i18n>manualImportImportExcel}" type="Default" icon="sap-icon://download" iconFirst="true" width="auto" enabled="true" visible="true"
									iconDensityAware="false" press="fnImportFromExcel"/>
								<ToolbarSpacer width=""/>
                           						<Text id="SelectedEquipment" text="" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
								<OverflowToolbarButton text="{i18n>commonSort}" type="Transparent" icon="sap-icon://sort" iconFirst="true" width="auto" enabled="true" visible="true"
									iconDensityAware="false" press="fnViewSettingsButtonPressed"/>
							</OverflowToolbar>
						</headerToolbar>
						<columns>
							<Column width="20%" hAlign="Left" vAlign="Top" minScreenWidth="Desktop" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>commonFileName}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column width="10%" hAlign="Center" vAlign="Top" minScreenWidth="Desktop" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>commonUploadDate}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column width="10%" hAlign="Center" vAlign="Top" minScreenWidth="Desktop" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>commonUsername}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column width="10%" hAlign="Right" vAlign="Top" minScreenWidth="Desktop" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>commonRunningJobs}" width="auto" wrapping="true" textAlign="End" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column width="10%" hAlign="Right" vAlign="Top" minScreenWidth="Desktop" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>commonPendingQueue}" width="auto" wrapping="true" textAlign="End" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column width="10%" hAlign="Right" vAlign="Top" minScreenWidth="Desktop" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>commonPendingRecords}" width="auto" wrapping="true" textAlign="End" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column width="10%" hAlign="Center" vAlign="Top" minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>commonStatus}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column width="20%" hAlign="Left" vAlign="Top" minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>commonMessage}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
 
								<footer/>
							</Column>
						</columns>
						<items>
							<ColumnListItem>
								<cells>
									<Text text="{DS_FILE_NAME}"  class="textHighlight"  />
									<Text text="{DT_UPLOAD}"  />
									<Text text="{DS_USERNAME}"  />
									<Text text="{RUNNING_JOBS}"  class="textHighlight"  />
									<Text text="{PENDING_QUEUE}" class="textHighlight"  />
									<Text text="{PENDING_RECORDS}" class="textHighlight"  />
									<core:Icon src="{ path:'DS_STATUS', formatter: '.formatter.statusIconManualImport' }" size="20px"
  color="{ path:'DS_STATUS', formatter: '.formatter.statusColorManualImport' }" visible="true"/>
									<Text text="{DS_MESSAGE}"  />
								</cells>
							</ColumnListItem>
						</items>
					</Table>
				</content>
				<headerContent>
					<Image src="images/sanofi_logo.png" height="auto" width="100px" visible="true" densityAware="false"/>
				</headerContent>
				<footer>
					<Toolbar visible="{= ${message>/}.length > 0 }">
						<content>
								<Button icon="sap-icon://message-popup" text="{= ${message>/}.length }" visible="{= ${message>/}.length > 0 }"  press="onMessagePopoverPress" />
						</content>
					</Toolbar>
				</footer>
			</Page>
		</pages>
	</App>
</mvc:View>