<mvc:View id="view-plant-parameters" controllerName="StreamingEngine.StreamingEngine.controller.PlantParameters" xmlns:mvc="sap.ui.core.mvc"
	xmlns:fb="sap.ui.comp.filterbar" xmlns:core="sap.ui.core" xmlns:html="http://www.w3.org/1999/xhtml" xmlns="sap.m" width="100%">
	<App>
		<pages>
			<Page id="page-plant-parameters" visible="false" showHeader="false" showFooter="{= ${message>/}.length > 0 }"  floatingFooter="true">
				<content>
					<fb:FilterBar id="filterbar-plant-parameters" reset="onReset" search="fnFilterPlant" showRestoreButton="false" showClearButton="false"
						showFilterConfiguration="false" useToolbar="false" class="filterBar">
						<fb:filterGroupItems>
							<fb:FilterGroupItem groupName="GroupPlantFilter" name="A" label="{i18n>commonLabelPlant}" visibleInFilterBar="true">
								<fb:control>
									<Input id="input-plant-id" type="Text" width="100px" change="fnFilterPlant"/>
								</fb:control>
							</fb:FilterGroupItem>
						</fb:filterGroupItems>
					</fb:FilterBar>
					<core:Fragment fragmentName="StreamingEngine.StreamingEngine.view.BusyDialog" type="XML"></core:Fragment>
					<Table id="table-plant-parameters" sticky= "ColumnHeaders,HeaderToolbar" width="auto" noDataText="{i18n>commonNoData}" mode="SingleSelectMaster" items="{/Row}" itemPress="fnRowPress"
						showSeparators="All" growing="true" growingThreshold="20" growingScrollToLoad="true" class="sapUiResponsiveMargin tableStyle">
						<headerToolbar>
							<OverflowToolbar>
								<Button text="{i18n>plantParamsAddPlant}" type="Default" press="fnAddNew" icon="sap-icon://add" iconFirst="true"></Button>
								<ToolbarSpacer/>
								<OverflowToolbarButton text="{i18n>commonSort}" type="Transparent" icon="sap-icon://sort" iconFirst="true" width="auto" enabled="true" visible="true"
									iconDensityAware="false" press="fnViewSettingsButtonPressed"/>
							</OverflowToolbar>
						</headerToolbar>
						<columns>
							<Column hAlign="Center" vAlign="Top" minScreenWidth="Desktop" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>plantParamsPlantID}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column hAlign="Left" vAlign="Top" minScreenWidth="Desktop" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>plantParamsName}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column hAlign="Right" vAlign="Top" minScreenWidth="Tablet" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>plantParamsTagsPerJob}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column hAlign="Right" vAlign="Top" minScreenWidth="Tablet" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>plantParamsTagsPerAgent}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column hAlign="Right" vAlign="Top" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>plantParamsJobDuration}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column hAlign="Right" vAlign="Top" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>plantParamsMaxQueueRetry}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column hAlign="Right" vAlign="Top" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>plantParamsRowCountRetry}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column hAlign="Right" vAlign="Top" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>plantInfoSuccessQueueSize}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column hAlign="Right" vAlign="Top" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>plantParamsFlowTimeout}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column hAlign="Right" vAlign="Top" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>plantParamsFlowMaxFileSizeKB}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
						</columns>
						<items>
							<ColumnListItem type="Navigation">
								<cells>
									<Text text="{ID_PLANT}"/>
									<Text text="{DS_NAME}" width="auto" class="textHighlight" textAlign="Begin" textDirection="Inherit" visible="true"/>
									<Text text="{QT_MAX_TAGS_PER_JOBS}"/>
									<Text text="{QT_MAX_TAGS_PER_AGENTS}"/>
									<Text text="{QT_RUN_DURATION_IN_MINS}"/>
									<Text text="{QT_MAX_QUEUE_RETRY}"/>
									<Text text="{QT_ROWCOUNT_RETRY}"/>
									<Text text="{QT_SUCCESS_QUEUE_SIZE}"/>
									<Text text="{QT_FLOW_TIMEOUT}"/>
									<Text text="{QT_FLOW_MAX_FILE_SIZE}"/>
								</cells>
							</ColumnListItem>
						</items>
					</Table>
				</content>
				<headerContent>
					<Image src="images/sanofi_logo.png" height="auto" width="100px" visible="true" densityAware="false"/>
				</headerContent>

				<footer>
					<Toolbar visible="{= ${message>/}.length > 0 }">
						<content>
								<Button icon="sap-icon://message-popup" text="{= ${message>/}.length }" visible="{= ${message>/}.length > 0 }"  press="onMessagePopoverPress" />
						</content>
					</Toolbar>
				</footer>
			</Page>
		</pages>
	</App>
</mvc:View>