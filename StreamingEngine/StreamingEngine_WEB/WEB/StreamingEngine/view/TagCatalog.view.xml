<mvc:View id="view-tag-catalog" controllerName="StreamingEngine.StreamingEngine.controller.TagCatalog" xmlns:mvc="sap.ui.core.mvc"
	xmlns:fb="sap.ui.comp.filterbar" xmlns:core="sap.ui.core" xmlns:html="http://www.w3.org/1999/xhtml" xmlns="sap.m" width="100%">
	<App>
		<pages>
			<Page id="page-tag-catalog" visible="false" showHeader="false" showFooter="{= ${message>/}.length > 0 }" floatingFooter="true">
				<content>
					<fb:FilterBar id="filterbar-tag-catalog" filterContainerWidth="7.75rem" reset="onReset" search="onSearch" showRestoreButton="false"
						showClearButton="false" showFilterConfiguration="false" useToolbar="false" class="filterBar sapUiSizeCompact" showGoOnFB="false">
						<fb:filterGroupItems>
							<fb:FilterGroupItem groupName="GroupTagFilter" name="A" label="{i18n>commonLabelPlant}" visibleInFilterBar="true">
								<fb:control>
									<ComboBox id="combobox-plant" placeholder="Select a Plant" required="true" items="{/Row}" selectionChange="fnPlantSelected">
										<items>
											<core:Item key="{ID_PLANT}" text="{DS_NAME}"/>
										</items>
									</ComboBox>
								</fb:control>
							</fb:FilterGroupItem>
							<fb:FilterGroupItem groupName="GroupTagFilter" name="B" label="{i18n>commonLabelDataSource}" visibleInFilterBar="true">
								<fb:control>
									<ComboBox id="combobox-data-source" placeholder="Select a data source" required="true" items="{/Row}" selectionChange="fnLoadTagCatalog">
										<items>
											<core:Item key="{ID_SOURCE}" text="{DS_NAME}"/>
										</items>
									</ComboBox>
								</fb:control>
							</fb:FilterGroupItem>
							<fb:FilterGroupItem groupName="GroupTagFilter" name="C" label="{i18n>commonLabelOriginalTag}" visibleInFilterBar="true">
								<fb:control>
									<Input id="input-original-tag" change="fnLoadTagCatalog"/>
								</fb:control>
							</fb:FilterGroupItem>
							<fb:FilterGroupItem groupName="GroupTagFilter" name="D" label="{i18n>commonLabelRenamedTag}" visibleInFilterBar="true">
								<fb:control>
									<Input id="input-renamed-tag" change="fnLoadTagCatalog"/>
								</fb:control>
							</fb:FilterGroupItem>
							<fb:FilterGroupItem groupName="GroupTagFilter" name="E" label="{i18n>commonLabelRealtime}" visibleInFilterBar="true">
								<fb:control>
									<ComboBox id="combobox-real-time" required="true" selectedKey="%" selectionChange="fnLoadTagCatalog" width="5rem">
										<items>
											<core:Item key="%" text="{i18n>commonAll}"/>
											<core:Item key="1" text="{i18n>commonYes}"/>
											<core:Item key="0" text="{i18n>commonNo}"/>
										</items>
									</ComboBox>
								</fb:control>
							</fb:FilterGroupItem>
							<fb:FilterGroupItem groupName="GroupTagFilter" name="F" label="{i18n>commonLabelArchive}" visibleInFilterBar="true" class="customArchive">
								<fb:control>
									<ComboBox id="combobox-archive" required="true" selectedKey="%" selectionChange="fnLoadTagCatalog" width="5rem">
										<items>
											<core:Item key="%" text="{i18n>commonAll}"/>
											<core:Item key="1" text="{i18n>commonYes}"/>
											<core:Item key="0" text="{i18n>commonNo}"/>
										</items>
									</ComboBox>
								</fb:control>
							</fb:FilterGroupItem>
							<fb:FilterGroupItem groupName="GroupTagFilter" name="H" label="{i18n>commonLabelWatch}" visibleInFilterBar="true" class="customArchive">
								<fb:control>
									<ComboBox id="combobox-watch" required="true" selectedKey="%" selectionChange="fnLoadTagCatalog" width="5rem">
										<items>
											<core:Item key="%" text="{i18n>commonAll}"/>
											<core:Item key="1" text="{i18n>commonYes}"/>
											<core:Item key="0" text="{i18n>commonNo}"/>
										</items>
									</ComboBox>
								</fb:control>
							</fb:FilterGroupItem>
							<fb:FilterGroupItem groupName="GroupTagFilter" name="I" label="{i18n>commonInitialLoad}" visibleInFilterBar="true" class="customArchive">
								<fb:control>
									<ComboBox id="combobox-initial-load" required="true" selectedKey="%" selectionChange="fnLoadTagCatalog" width="5rem">
										<items>
											<core:Item key="%" text="{i18n>commonAll}"/>
											<core:Item key="1" text="{i18n>commonYes}"/>
											<core:Item key="0" text="{i18n>commonNo}"/>
										</items>
									</ComboBox>
								</fb:control>
							</fb:FilterGroupItem>
							<fb:FilterGroupItem groupName="GroupTagFilter" name="G" label="{i18n>commonLabelHiddenTags}" visibleInFilterBar="true" class="customArchive">
								<fb:control>
									<Switch id="switch-hidden" state="false" customTextOn="{i18n>commonYes}" customTextOff="{i18n>commonNo}" change="fnLoadTagCatalog" />
								</fb:control>
							</fb:FilterGroupItem>
						</fb:filterGroupItems>
					</fb:FilterBar>
					<core:Fragment fragmentName="StreamingEngine.StreamingEngine.view.BusyDialog" type="XML"></core:Fragment>
					<Table id="table-tag-catalog" sticky= "ColumnHeaders,HeaderToolbar"  width="auto" noDataText="{i18n>commonNoData}" mode="MultiSelect" items="{/Row}" showSeparators="All" growing="true"
						growingThreshold="100" growingScrollToLoad="true" class="sapUiResponsiveMargin tableStyle" selectionChange="onSelectionChange" updateStarted="fnGrowingStarted">
						<headerToolbar>
							<OverflowToolbar>
								<Button text="{i18n>tagCatalogExportExcel}" type="Default" icon="sap-icon://upload" iconFirst="true" width="auto" enabled="true" visible="true"
									iconDensityAware="false" press="fnExportToExcel"/>
								<Button text="{i18n>tagCatalogImportExcel}" type="Default" icon="sap-icon://download" iconFirst="true" width="auto" enabled="true" visible="true"
									iconDensityAware="false" press="fnImportFromExcel"/>
									<Button text="{i18n>tagCatalogHideTags}" type="Default" icon="sap-icon://hide" iconFirst="true" width="auto" enabled="true" visible="true"
									iconDensityAware="false" press="fnHideTags"/>
									<Button text="{i18n>tagCatalogUnhideTags}" type="Default" icon="sap-icon://show" iconFirst="true" width="auto" enabled="true" visible="true"
									iconDensityAware="false" press="fnUnhideTags"/>
									<Button id="button-enable-data-load" text="{i18n>tagCatalogEnableDataLoad}" type="Default" icon="sap-icon://database" iconFirst="true" width="auto" enabled="true" visible="false"
									iconDensityAware="false" press="fnEnableInitialDataLoad"/>
									<Button id="button-disable-data-load"  text="{i18n>tagCatalogDisableDataLoad}" type="Default" icon="sap-icon://inspect-down" iconFirst="true" width="auto" enabled="true" visible="false"
									iconDensityAware="false" press="fnDisableInitialDataLoad"/>
									<Button id="button-reset-tags"  text="{i18n>tagCatalogResetTags}" type="Default" icon="sap-icon://reset" iconFirst="true" width="auto" enabled="false" visible="true"
									iconDensityAware="false" press="fnResetTags"/>
								<ToolbarSpacer width=""/>
								<Button type="Default" text="{= ${SelectedTags>/}.length}" press="fnShowSelectedTags"  icon="sap-icon://cart" iconFirst="true"></Button>
                           						
								<OverflowToolbarButton text="{i18n>commonSort}" type="Transparent" icon="sap-icon://sort" iconFirst="true" width="auto" enabled="true" visible="true"
									iconDensityAware="false" press="fnViewSettingsButtonPressed"/>
							</OverflowToolbar>
						</headerToolbar>
						<columns>
							<Column width="7%" hAlign="Center" vAlign="Top" minScreenWidth="Desktop" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>commonLabelPlant}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column width="8%" hAlign="Center" vAlign="Top" minScreenWidth="Desktop" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>commonLabelDataSource}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column width="28%" hAlign="Left" vAlign="Top" minScreenWidth="Tablet" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>commonLabelOriginalTag}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column width="20%" hAlign="Left" vAlign="Top" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>tagCatalogPlantHierarchy}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column width="16%" hAlign="Left" vAlign="Top" minScreenWidth="Tablet" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>commonLabelRenamedTag}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column width="8%" hAlign="Center" vAlign="Top" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>commonLabelRealtime}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column width="8%" hAlign="Center" vAlign="Top" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>commonLabelArchive}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column width="5%" hAlign="Center" vAlign="Top" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>tagCatalogConfigStatus}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
						</columns>
						<items>
							<ColumnListItem selected="{TAG_SELECTED}" type="Navigation" press="fnRowPress">
								<cells>
									<Text text="{PLANT}"  >
										<customData>
										<core:CustomData key="hiddenRecord" value="{FL_HIDDEN}" writeToDom="true" />
										<core:CustomData key="labelColor" value="{COLOR_STATUS}" writeToDom="true" />
										</customData>
									</Text>
									<Text text="{SOURCE_NAME}"  >
										<customData>
										<core:CustomData key="hiddenRecord" value="{FL_HIDDEN}" writeToDom="true" />
										<core:CustomData key="labelColor" value="{COLOR_STATUS}" writeToDom="true" />
										</customData>
									</Text>
									<Text text="{DS_NAME_ORIGINAL}" class="textHighlight"  >
										<customData>
										<core:CustomData key="hiddenRecord" value="{FL_HIDDEN}" writeToDom="true" />
										<core:CustomData key="labelColor" value="{COLOR_STATUS}" writeToDom="true" />
										</customData>
									</Text>
									<Text text="{PLANT_HIERARCHY}"  >
										<customData>
										<core:CustomData key="hiddenRecord" value="{FL_HIDDEN}" writeToDom="true" />
										<core:CustomData key="labelColor" value="{COLOR_STATUS}" writeToDom="true" />
										</customData>
									</Text>
									<Text text="{DS_NAME_RENAMED}"  >
										<customData>
										<core:CustomData key="hiddenRecord" value="{FL_HIDDEN}" writeToDom="true" />
										<core:CustomData key="labelColor" value="{COLOR_STATUS}" writeToDom="true" />
										</customData>
									</Text>
									<core:Icon src="sap-icon://opportunity" size="20px" visible="{=${FLAG_REALTIME}===1}"/>
									<core:Icon src="sap-icon://upload-to-cloud" size="20px" visible="{=${FLAG_ARCHIVE}===1}"/>
									<core:Icon src="{ path:'COLOR_STATUS', formatter: '.formatter.statusIconTagCatalog' }" size="20px"
										color="{ path:'COLOR_STATUS', formatter: '.formatter.statusColorTagCatalog' }" visible="true"/>
								</cells>
							</ColumnListItem>
						</items>
					</Table>
				</content>
				<headerContent>
					<Image src="images/sanofi_logo.png" height="auto" width="100px" visible="true" densityAware="false"/>
				</headerContent>
				<footer>
					<Toolbar visible="{= ${message>/}.length > 0 }">
						<content>
								<Button icon="sap-icon://message-popup" text="{= ${message>/}.length }" visible="{= ${message>/}.length > 0 }"  press="onMessagePopoverPress" />
						</content>
					</Toolbar>
				</footer>
			</Page>
		</pages>
	</App>
</mvc:View>