<mvc:View id="view-Data-Destinations"
	controllerName="StreamingEngine.StreamingEngine.controller.DataDestinations"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:fb="sap.ui.comp.filterbar" xmlns:core="sap.ui.core"
	xmlns:html="http://www.w3.org/1999/xhtml" xmlns="sap.m" width="100%">
	<App>
		<pages>
			<Page id="page-data-destinations" visible="false" showHeader="false"
				showFooter="{= ${message>/}.length > 0 }" floatingFooter="true">
				<content>
					<fb:FilterBar id="filterbar-data-destinationw" reset="onSearch" search="onSearch"
						showRestoreButton="false" showClearButton="true"
						showFilterConfiguration="false" useToolbar="false" class="filterBar">
						<fb:filterGroupItems>
							<fb:FilterGroupItem groupName="GroupDataDestinationFilter" name="A"
								label="{i18n>dataDestinationName}" visibleInFilterBar="true">
								<fb:control>
									<Input id="input-data-destination" type="Text" width="100px"
										change="onSearch" />
								</fb:control>
							</fb:FilterGroupItem>
							<fb:FilterGroupItem groupName="GroupDataDestinationFilter" name="B"
								label="{i18n>dataDestinationType}" visibleInFilterBar="true">
								<fb:control>
									<ComboBox id="combobox-data-dest-type" items="{/Row}" selectionChange="onSearch">
										<items>
										   <core:Item key="{CD_TYPE}" text="{path: 'CD_TYPE', formatter: '.getText'}"/>
										</items>
								   </ComboBox>	
								</fb:control>
							</fb:FilterGroupItem>
						</fb:filterGroupItems>
					</fb:FilterBar>
					<core:Fragment fragmentName="StreamingEngine.StreamingEngine.view.BusyDialog"
						type="XML"></core:Fragment>
					<Table id="table-datadestinations" sticky="ColumnHeaders,HeaderToolbar"
						width="auto" noDataText="{i18n>commonNoData}"
						selectionChange="fnSelectionChanged" items="{/Row}"
						showSeparators="All" growing="true" growingThreshold="20"
						growingScrollToLoad="true" class="sapUiResponsiveMargin tableStyle">
						<headerToolbar>
							<OverflowToolbar>
								<Button text="{i18n>dataDestinationsAddNewDD}" type="Default"
									press="fnAddNew" icon="sap-icon://add" iconFirst="true"></Button>
								<ToolbarSpacer />
								<OverflowToolbarButton text="{i18n>commonSort}" type="Transparent"
									icon="sap-icon://sort" iconFirst="true" width="auto"
									enabled="true" visible="true"
									iconDensityAware="false" press="fnViewSettingsButtonPressed" />
							</OverflowToolbar>
						</headerToolbar>
						<columns>
							<Column hAlign="Left" vAlign="Top" minScreenWidth="Desktop"
								demandPopin="false" popinDisplay="Inline" mergeDuplicates="false"
								width="20%">
								<header>
									<Text text="{i18n>dataDestinationName}" width="auto"
										wrapping="true" textAlign="Begin" textDirection="Inherit"
										visible="true" />
								</header>
								<footer />
							</Column>
							<Column hAlign="Left" vAlign="Top" minScreenWidth="Desktop"
								demandPopin="false" popinDisplay="Inline" mergeDuplicates="false"
								width="10%">
								<header>
									<Text text="{i18n>dataDestinationType}" width="auto"
										wrapping="true" textAlign="Begin" textDirection="Inherit"
										visible="true" />
								</header>
								<footer />
							</Column>
							<Column hAlign="Left" vAlign="Top" minScreenWidth="Tablet"
								demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>dataDestinationUrl}" width="auto"
										wrapping="true" textAlign="Begin" textDirection="Inherit"
										visible="true" />
								</header>
								<footer />
							</Column>
							<Column hAlign="Left" vAlign="Top" minScreenWidth="Tablet"
								demandPopin="false" popinDisplay="Inline" mergeDuplicates="false"
								width="5%">
								<header>
									<Text text="{i18n>dataDestinationHttpMethod}" width="auto"
										wrapping="true" textAlign="Begin" textDirection="Inherit"
										visible="true" />
								</header>
								<footer />
							</Column>
							<Column hAlign="Left" vAlign="Top" minScreenWidth="Tablet"
								demandPopin="true" popinDisplay="Inline" mergeDuplicates="false"
								width="8%">
								<header>
									<Text text="{i18n>dataDestinationAuthenMethod}" width="auto"
										wrapping="true" textAlign="Begin" textDirection="Inherit"
										visible="true" />
								</header>
								<footer />
							</Column>
							<Column width="5%" hAlign="Center" vAlign="Top" minScreenWidth="Tablet"
								demandPopin="true" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>dataDestinationDefaultPCoDestination}"
										width="auto"
										wrapping="true" textAlign="Begin" textDirection="Inherit"
										visible="true" />
								</header>
								<footer />
							</Column>
							<Column width="5%" hAlign="Center" vAlign="Top" minScreenWidth="Tablet"
								demandPopin="true" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>dataSourcesEnabled}" width="auto"
										wrapping="true" textAlign="Begin" textDirection="Inherit"
										visible="true" />
								</header>
								<footer />
							</Column>
						</columns>
						<items>
							<ColumnListItem type="Navigation" press="fnRowPress">
								<cells>
									<Text text="{parts: ['DS_NAME', 'CD_TYPE', 'PLANT'], formatter: '.getDestinationName'}" class="textHighlight" />
									<Text text="{path: 'CD_TYPE', formatter: '.getText'}" />
									<Text text="{DS_PATH}" />
									<Text text="{CD_HTTP_METHOD}" />
									<Text
										text="{path: 'CD_AUTHENTICATION_METHOD', formatter: '.getText' }" />
									<core:Icon src="sap-icon://favorite" size="20px"
										visible="{=${FL_DEFAULT}==='1'}" />
									<core:Icon src="sap-icon://circle-task-2" size="20px"
										color="{=${FL_ENABLED}==='1'?'green':'red'}" visible="true" />
								</cells>
							</ColumnListItem>
						</items>
					</Table>
				</content>
				<headerContent>
					<Image src="images/sanofi_logo.png" height="auto" width="100px" visible="true"
						densityAware="false" />
				</headerContent>
				<footer>
					<Toolbar visible="{= ${message>/}.length > 0 }">
						<content>
							<Button icon="sap-icon://message-popup" text="{= ${message>/}.length }"
								visible="{= ${message>/}.length > 0 }" press="onMessagePopoverPress" />
						</content>
					</Toolbar>
				</footer>
			</Page>
		</pages>
	</App>
</mvc:View>