<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<TableSelectDialog id="table-select-digital-app" noDataText="{i18n>digitalAppNoData}" title="{i18n>digitalAppSelectTitle}" search="fnSearch" confirm="fnConfirmSelection"
		cancel="fnClosePopOver" items="{/Row}">
		<ColumnListItem>
			<cells>
				<Text text="{ID_DIGITAL_APP}"/>
				<Text text="{DS_NAME}"/>
			</cells>
		</ColumnListItem>
		<columns>
			<Column hAlign="Left">
				<header>
					<Text text="{i18n>digitalApp}"/>
				</header>
			</Column>
			<Column hAlign="Left">
				<header>
					<Text text="{i18n>digitalAppDesc}"/>
				</header>
			</Column>
		</columns>
	</TableSelectDialog>
</core:FragmentDefinition>