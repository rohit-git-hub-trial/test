<mvc:View id="view-Contextual-Flows" controllerName="StreamingEngine.StreamingEngine.controller.ContextualFlows" xmlns:mvc="sap.ui.core.mvc" xmlns:fb="sap.ui.comp.filterbar" xmlns:core="sap.ui.core" xmlns:html="http://www.w3.org/1999/xhtml" xmlns="sap.m" width="100%">
    <App>
        <pages>
            <Page id="page-contextual-flows" visible="false" showHeader="false" showFooter="{= ${message>/}.length > 0 }" floatingFooter="true">
                <content>
                    <fb:FilterBar id="filterbar-contextual-flows" reset="onSearch" search="onSearch" showRestoreButton="false" showClearButton="true" showFilterConfiguration="false" useToolbar="false" class="filterBar">
                        <fb:filterGroupItems>
                            <fb:FilterGroupItem groupName="GroupContextualFlowsFilter" name="A" label="{i18n>commonLabelPlant}" visibleInFilterBar="true">
                                <fb:control>
                                    <ComboBox id="combobox-plant" placeholder="Select a Plant" required="true" items="{/Row}" selectionChange="fnPlantSelected">
                                        <items>
                                            <core:Item key="{ID_PLANT}" text="{DS_NAME}" />
                                        </items>
                                    </ComboBox>
                                </fb:control>
                            </fb:FilterGroupItem>
                            <fb:FilterGroupItem groupName="GroupContextualFlowsFilter" name="B" label="{i18n>commonLabelDataSource}" visibleInFilterBar="true">
                                <fb:control>
                                    <ComboBox id="combobox-data-source" placeholder="Select a Data Source" required="true" items="{/Row}" selectionChange="onSearch">
                                        <items>
                                            <core:Item key="{ID_SOURCE}" text="{DS_NAME}" />
                                        </items>
                                    </ComboBox>
                                </fb:control>
                            </fb:FilterGroupItem>
                            <fb:FilterGroupItem groupName="GroupContextualFlowsFilter" name="C" label="{i18n>commonLabelDataFlow}" visibleInFilterBar="true">
                                <fb:control>
                                    <Input id="input-data-flow" type="Text" width="100px" change="onSearch" />
                                </fb:control>
                            </fb:FilterGroupItem>
                        </fb:filterGroupItems>
                    </fb:FilterBar>
                    <MessageStrip id="messagestrip-run-flow-manually" visible="false" text="{i18n>commonBackgroundProcessMessage}" type="Success" showIcon="true" showCloseButton="true" class="sapUiTinyMargin" />
                    <core:Fragment fragmentName="StreamingEngine.StreamingEngine.view.BusyDialog" type="XML"></core:Fragment>
                    <Table id="table-contextual-flows" sticky= "ColumnHeaders,HeaderToolbar"  width="auto" noDataText="{i18n>commonNoData}" mode="SingleSelectLeft" selectionChange="fnSelectionChanged" items="{/Row}" showSeparators="All" growing="true" growingThreshold="20" growingScrollToLoad="true" class="sapUiResponsiveMargin tableStyle">
                        <headerToolbar>
                            <OverflowToolbar>
                                <Button text="{i18n>contextualFlowAdd}" type="Default" press="fnAddNew" icon="sap-icon://add" iconFirst="true"></Button>
                                <Button id="button-run-flow-manually" text="{i18n>flowRunManually}" icon="sap-icon://play" iconFirst="true" width="auto" enabled="true" visible="true" iconDensityAware="false" press="fnRunFlowManually" />
                                <Button id="button-enable-data-upload" text="{i18n>contextualFlowHistoricalDataUploadEnable}" type="Default" icon="sap-icon://database" iconFirst="true" width="auto" enabled="false" iconDensityAware="false" press="fnHistoricalDataUpload" />
                                <Button id="button-disable-data-upload" text="{i18n>contextualFlowHistoricalDataUploadCancel}" type="Default" icon="sap-icon://inspect-down" iconFirst="true" width="auto" enabled="false" iconDensityAware="false" press="fnCancelHistoricalDataUpload" />
		      <Button id="button-flow-logging" text="Flow logging" type="Default" icon="sap-icon://my-view" iconFirst="true" width="auto" enabled="true" iconDensityAware="false"  press="fnFlowLogging"/>
		       <Button id="button-desactivate-flow-logging" text="Desactivate Flow logging" type="Default" icon="sap-icon://cancel" iconFirst="true" width="auto" enabled="true" iconDensityAware="false" press="fnCancelConfirm" />
                                <ToolbarSpacer/>
                                <OverflowToolbarButton text="{i18n>commonSort}" type="Transparent" icon="sap-icon://sort" iconFirst="true" width="auto" enabled="true" visible="true"
                                    iconDensityAware="false" press="fnViewSettingsButtonPressed"/>
                            </OverflowToolbar>
                        </headerToolbar>
                        <columns>
                            <Column hAlign="Left" vAlign="Top" minScreenWidth="Desktop" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false" width="6rem" >
                                <header>
                                    <Text text="{i18n>commonLabelPlant}" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true" />
                                </header>
                                <footer />
                            </Column>
                            <Column width="10%" hAlign="Left" vAlign="Top" minScreenWidth="Desktop" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
                                <header>
                                    <Text text="{i18n>flowDS}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true" />
                                </header>
                                <footer />
                            </Column>
                            <Column hAlign="Left" vAlign="Top" minScreenWidth="Tablet" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false" width="6rem">
                                <header>
                                    <Text text="{i18n>flowType}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true" />
                                </header>
                                <footer />
                            </Column>
                            <Column hAlign="Left" vAlign="Top" minScreenWidth="Tablet" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
                                <header>
                                    <Text text="{i18n>flowName}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true" />
                                </header>
                                <footer />
                            </Column>
                            <Column hAlign="Left" vAlign="Top" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" mergeDuplicates="false">
                                <header>
                                    <Text text="{i18n>flowDesc}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true" />
                                </header>
                                <footer />
                            </Column>
<Column hAlign="Left" vAlign="Top" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" mergeDuplicates="false"  width="5rem">
                                <header>
                                    <Text text="{i18n>jobsMonitoringStartDate}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true" />
                                </header>
                                <footer />
                            </Column>
<Column hAlign="Left" vAlign="Top" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" mergeDuplicates="false"  width="5rem">
                                <header>
                                    <Text text="{i18n>jobsMonitoringEndDate}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true" />
                                </header>
                                <footer />
                            </Column>
<Column hAlign="Left" vAlign="Top" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" mergeDuplicates="false" width="5rem">
                                <header>
                                    <Text text="{i18n>contextualFlowCompletion}" width="auto"  wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true" />
                                </header>
                                <footer />
                            </Column>
                            <Column width="5%" hAlign="Center" vAlign="Top" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" mergeDuplicates="false">
                                <header>
                                    <Text text="{i18n>flowCompressed}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true" />
                                </header>
                                <footer />
                            </Column>
                            <Column width="5%" hAlign="Center" vAlign="Top" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" mergeDuplicates="false">
                                <header>
                                    <Text text="{i18n>flowEnabled}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true" />
                                </header>
                                <footer />
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem type="Navigation" press="fnRowPress">
                                <cells>
                                    <Text text="{PLANT}" >
                                        <customData>
                                            <core:CustomData key="labelColor" value="{DATA_FLOW_STATUS}" writeToDom="true" />
                                        </customData>
                                    </Text>
                                    <Text text="{SOURCE_NAME}" >
                                        <customData>
                                            <core:CustomData key="labelColor" value="{DATA_FLOW_STATUS}" writeToDom="true" />
                                        </customData>
                                    </Text>
                                    <Text text="{FLOW_TYPE}" >
                                        <customData>
                                            <core:CustomData key="labelColor" value="{DATA_FLOW_STATUS}" writeToDom="true" />
                                        </customData>
                                    </Text>
                                    <Text text="{DS_NAME}" class="textHighlight" >
                                        <customData>
                                            <core:CustomData key="labelColor" value="{DATA_FLOW_STATUS}" writeToDom="true" />
                                        </customData>
                                    </Text>
                                    <Text text="{DS_DESCRIPTION}" >
                                        <customData>
                                            <core:CustomData key="labelColor" value="{DATA_FLOW_STATUS}" writeToDom="true" />
                                        </customData>
                                    </Text>
<Text text="{=${DT_HISTORICAL_UPLOAD_START}==='TimeUnavailable'?'NA': ${DT_HISTORICAL_UPLOAD_START}}" >
                                        <customData>
                                            <core:CustomData key="labelColor" value="{DATA_FLOW_STATUS}" writeToDom="true" />
                                        </customData>
                                    </Text>
<Text text="{=${DT_HISTORICAL_UPLOAD_END}==='TimeUnavailable'?'NA': ${DT_HISTORICAL_UPLOAD_END}}" >
                                        <customData>
                                            <core:CustomData key="labelColor" value="{DATA_FLOW_STATUS}" writeToDom="true" />
                                        </customData>
                                    </Text>
<Text text="{=${ID_INITIAL_LOAD_PARENT}==='NA'?'NA':${QT_HISTORICAL_UPLOAD_COMPLETION}}" >
                                        <customData>
                                            <core:CustomData key="labelColor" value="{DATA_FLOW_STATUS}" writeToDom="true" />
                                        </customData>
                                    </Text>
                                    <core:Icon src="sap-icon://attachment-zip-file" size="20px" visible="{=${FL_COMPRESSED}==='1'}" color="{=${FL_COMPRESSED}==='1'?'green':'red'}" />
                                    <core:Icon src="sap-icon://circle-task-2" size="20px" color="{=${FL_ENABLED}==='1'?'green':'red'}" visible="true" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </content>
                <headerContent>
                    <Image src="images/sanofi_logo.png" height="auto" width="100px" visible="true" densityAware="false" />
                </headerContent>
                <footer>
                    <Toolbar visible="{= ${message>/}.length > 0 }">
                        <content>
                            <Button icon="sap-icon://message-popup" text="{= ${message>/}.length }" visible="{= ${message>/}.length > 0 }" press="onMessagePopoverPress" />
                        </content>
                    </Toolbar>
                </footer>
            </Page>
        </pages>
    </App>
</mvc:View>