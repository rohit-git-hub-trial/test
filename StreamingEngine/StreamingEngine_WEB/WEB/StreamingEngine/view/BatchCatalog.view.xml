<mvc:View id="view-batch-catalog" controllerName="StreamingEngine.StreamingEngine.controller.BatchCatalog" xmlns:mvc="sap.ui.core.mvc"
	xmlns:fb="sap.ui.comp.filterbar" xmlns:core="sap.ui.core" xmlns:html="http://www.w3.org/1999/xhtml" xmlns="sap.m" width="100%">
	<App>
		<pages>
			<Page id="page-batch-catalog" visible="false" showHeader="false" showFooter="{= ${message>/}.length > 0 }"  floatingFooter="true">
				<content>
					<fb:FilterBar id="filterbar-batch-catalog" filterContainerWidth="12rem" reset="onReset" search="onSearch" showRestoreButton="false"
						showClearButton="false" showFilterConfiguration="false" useToolbar="false" class="filterBar sapUiSizeCompact" showGoOnFB="false">
						<fb:filterGroupItems>
							<fb:FilterGroupItem groupName="GroupBatchFilter" name="A" label="{i18n>commonLabelPlant}" visibleInFilterBar="true">
								<fb:control>
									<ComboBox id="combobox-plant" placeholder="Select a Plant" required="true" items="{/Row}" selectionChange="fnPlantSelected">
										<items>
											<core:Item key="{ID_PLANT}" text="{DS_NAME}"/>
										</items>
									</ComboBox>
								</fb:control>
							</fb:FilterGroupItem>
							<fb:FilterGroupItem groupName="GroupBatchFilter" name="B" label="{i18n>commonLabelDataSource}" visibleInFilterBar="true">
								<fb:control>
									<ComboBox id="combobox-data-source" placeholder="Select a data source" required="true" items="{/Row}" selectionChange="fnLoadBatchCatalog">
										<items>
											<core:Item key="{ID_SOURCE}" text="{DS_NAME}"/>
										</items>
									</ComboBox>
								</fb:control>
							</fb:FilterGroupItem>
							<fb:FilterGroupItem groupName="GroupBatchFilter" name="C" label="{i18n>commonLabelOriginalBatch}" visibleInFilterBar="true">
								<fb:control>
									<Input id="input-original-batch" change="fnLoadBatchCatalog"/>
								</fb:control>
							</fb:FilterGroupItem>
							<fb:FilterGroupItem groupName="GroupBatchFilter" name="D" label="{i18n>commonLabelRenamedBatch}" visibleInFilterBar="true">
								<fb:control>
									<Input id="input-renamed-batch" change="fnLoadBatchCatalog"/>
								</fb:control>
							</fb:FilterGroupItem>
							<fb:FilterGroupItem groupName="GroupBatchFilter" name="I" label="{i18n>commonMapped}" visibleInFilterBar="true" class="customArchive">
								<fb:control>
									<ComboBox id="combobox-mapped" required="true" selectedKey="%" selectionChange="fnLoadBatchCatalog" width="5rem">
										<items>
											<core:Item key="%" text="{i18n>commonAll}"/>
											<core:Item key="1" text="{i18n>commonYes}"/>
											<core:Item key="0" text="{i18n>commonNo}"/>
										</items>
									</ComboBox>
								</fb:control>
							</fb:FilterGroupItem>
						</fb:filterGroupItems>
					</fb:FilterBar>
					<core:Fragment fragmentName="StreamingEngine.StreamingEngine.view.BusyDialog" type="XML"></core:Fragment>
					<Table id="table-batch-catalog" sticky= "ColumnHeaders,HeaderToolbar"  width="auto" noDataText="{i18n>commonNoData}" mode="MultiSelect" items="{BatchCatalogModel>/Row}" showSeparators="All" growing="true"
						growingThreshold="20" growingScrollToLoad="true" class="sapUiResponsiveMargin tableStyle" selectionChange="onSelectionChange" updateStarted="fnGrowingStarted">
						<headerToolbar>
							<OverflowToolbar>
								<Button text="{i18n>batchCatalogExportExcel}" type="Default" icon="sap-icon://upload" iconFirst="true" width="auto" enabled="true" visible="true"
									iconDensityAware="false" press="fnExportToExcel"/>
								<Button text="{i18n>batchCatalogImportExcel}" type="Default" icon="sap-icon://download" iconFirst="true" width="auto" enabled="true" visible="true"
									iconDensityAware="false" press="fnImportFromExcel"/>
								<ToolbarSpacer width=""/>
                           						<Text id="SelectedEquipment" text="" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
								<OverflowToolbarButton text="{i18n>commonSort}" type="Transparent" icon="sap-icon://sort" iconFirst="true" width="auto" enabled="true" visible="true"
									iconDensityAware="false" press="fnViewSettingsButtonPressed"/>
							</OverflowToolbar>
						</headerToolbar>
						<columns>
							<Column width="7%" hAlign="Center" vAlign="Top" minScreenWidth="Desktop" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>commonLabelPlant}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column width="13%" hAlign="Center" vAlign="Top" minScreenWidth="Desktop" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>commonLabelDataSource}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column width="25%" hAlign="Left" vAlign="Top" minScreenWidth="Tablet" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>commonLabelEquipmentPath}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column width="15%" hAlign="Left" vAlign="Top" minScreenWidth="Tablet" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>commonLabelEquipmentName}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column width="5%" hAlign="Left" vAlign="Top" minScreenWidth="Tablet" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>commonLabelLevel}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column width="30%" hAlign="Left" vAlign="Top" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>batchCatalogPlantHierarchy}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
							<Column width="5%" hAlign="Center" vAlign="Top" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" mergeDuplicates="false">
								<header>
									<Text text="{i18n>batchCatalogConfigStatus}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
								</header>
								<footer/>
							</Column>
						</columns>
						<items>
							<ColumnListItem type="Navigation" press="fnRowPress">
								<cells>
									<Text text="{BatchCatalogModel>PLANT}" />
									<Text text="{BatchCatalogModel>SOURCE}" />
									<Text text="{BatchCatalogModel>EQUIPMENT_PATH}" class="textHighlight" />
									<Text text="{BatchCatalogModel>EQUIPMENT_NAME}" class="textHighlight"  />
									<Text text="{BatchCatalogModel>EQUIPMENT_LEVEL}" class="textHighlight"  />
									<Text text="{BatchCatalogModel>PLANT_HIERARCHY}" />
									<core:Icon src="{ path:'BatchCatalogModel>COLOR_STATUS', formatter: '.formatter.statusIconBatchCatalog' }" size="20px"
  color="{ path:'BatchCatalogModel>COLOR_STATUS', formatter: '.formatter.statusColorBatchCatalog' }" visible="true"/>
								</cells>
							</ColumnListItem>
						</items>
					</Table>
				</content>
				<headerContent>
					<Image src="images/sanofi_logo.png" height="auto" width="100px" visible="true" densityAware="false"/>
				</headerContent>
				<footer>
					<Toolbar visible="{= ${message>/}.length > 0 }">
						<content>
								<Button icon="sap-icon://message-popup" text="{= ${message>/}.length }" visible="{= ${message>/}.length > 0 }"  press="onMessagePopoverPress" />
						</content>
					</Toolbar>
				</footer>
			</Page>
		</pages>
	</App>
</mvc:View>