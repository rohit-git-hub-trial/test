<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
		<Dialog
		title="Download Agent"
		class="sapUiContentPadding">
		<f:SimpleForm id="SPCUpdateTargetForm"
			editable="false"
			layout="ResponsiveGridLayout"
			labelSpanXL="4"
			labelSpanL="4"
			labelSpanM="12"
			labelSpanS="12"
			adjustLabelSpan="false"
			emptySpanXL="0"
			emptySpanL="0"
			emptySpanM="0"
			emptySpanS="0"
			columnsXL="2"
			columnsL="2"
			columnsM="2"
			singleContainerFullSize="false">
			<f:content>
				<core:Title id="title-form-download-agent"/>
				<Label text="Plant" required="true"/>
				<ComboBox id="combobox-plant-popup" placeholder="Select a Plant"  items="{/Row}" selectionChange="fnPlantSelectedPopup">
				     <items>
				        <core:Item key="{ID_PLANT}" text="{DS_NAME}"/>
				     </items>
				</ComboBox>	
				<Label text="Data Source" required="true"/>
				<ComboBox id="combobox-data-source-popup" placeholder="Select a Data Source" items="{/Row}">
				     <items>
				        <core:Item key="{ID_SOURCE}" text="{DS_NAME}"/>
				     </items>
				</ComboBox>	
			</f:content>
		</f:SimpleForm>
		<buttons>
			       <Button
					id="agent-button-save"
					type="Accept"
					icon="sap-icon://synchronize"
					text="Download Agent"
					press="fnDownloadAgent" />
				<Button
					id="agent-button-close"
					type="Reject"
					icon="sap-icon://decline"
					text="Close"
					press="fnClosePopOver" />
				
		</buttons>
	</Dialog>
</core:FragmentDefinition>