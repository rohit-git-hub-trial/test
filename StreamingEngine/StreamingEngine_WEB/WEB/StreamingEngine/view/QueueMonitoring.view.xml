<mvc:View id="view-queue-monitoring" controllerName="StreamingEngine.StreamingEngine.controller.QueueMonitoring" xmlns:mvc="sap.ui.core.mvc" xmlns:fb="sap.ui.comp.filterbar"
	xmlns:core="sap.ui.core" xmlns:html="http://www.w3.org/1999/xhtml" xmlns="sap.m" width="100%">
	<App>
		<pages>
			<Page id="page-queue-monitoring" visible="false" showHeader="false" showFooter="{= ${message>/}.length > 0 }" floatingFooter="true">
			<content>
			<fb:FilterBar id="filterbar-queue-monitoring" reset="onSearch" search="onSearch" showRestoreButton="false" showClearButton="true" showFilterConfiguration="false" useToolbar="false" class="filterBar">
				<fb:filterGroupItems>
					<fb:FilterGroupItem groupName="GroupDataSourceFilter" name="A" label="{i18n>commonLabelPlant}" visibleInFilterBar="true">
						<fb:control>
							<MultiComboBox id="combobox-plant" placeholder="Select a Plant" items="{/Row}" selectionFinish="fnPlantSelected">
							     <items>
							        <core:Item key="{ID_PLANT}" text="{DS_NAME}"/>
							     </items>
							</MultiComboBox>	
						</fb:control>					        
					</fb:FilterGroupItem>
					<fb:FilterGroupItem groupName="GroupDataSourceFilter" name="B" label="{i18n>commonLabelDataSource}" visibleInFilterBar="true">
						<fb:control>
							<MultiComboBox id="combobox-data-source" placeholder="Select a data source"  items="{/Row}" selectionFinish="fnLoadQueueMonitoring" >
								<items>
								 <core:Item key="{ID_SOURCE}" text="{DS_NAME}"/>
								</items>
							</MultiComboBox>
						</fb:control>					        
					</fb:FilterGroupItem>
					<fb:FilterGroupItem groupName="GroupDataSourceFilter" name="C" label="{i18n>flowType}" visibleInFilterBar="true">
						<fb:control>
							<MultiComboBox id="combobox-flow-type" placeholder="Select a flow type"  items="{/Row}" selectionFinish="fnLoadQueueMonitoring" >
								<items>
								 <core:Item key="{ID_FLOW_TYPE}" text="{DS_DESCRIPTION}"/>
								</items>
							</MultiComboBox>
						</fb:control>					        
					</fb:FilterGroupItem>
					<fb:FilterGroupItem groupName="GroupDataSourceFilter" name="D" label="{i18n>flowName}" visibleInFilterBar="true">
						<fb:control>
								<Input id="input-flow-name" type="Text" change="onSearch" />
                        </fb:control>
                    </fb:FilterGroupItem>
					<fb:FilterGroupItem groupName="GroupDataSourceFilter" name="E" label="{i18n>queueMonitoringFromExecutionDateTime}" visibleInFilterBar="true">
						<fb:control>
							<DateTimePicker id="datetime-from" displayFormat="MM/dd/yyyy HH:mm:ss" valueFormat="dd/MM/yyyy HH:mm:ss" 
								change="fnFromDateChanged"></DateTimePicker>
						</fb:control>
						</fb:FilterGroupItem>
					<fb:FilterGroupItem groupName="GroupDataSourceFilter" name="F" label="{i18n>queueMonitoringToExecutionDateTime}" visibleInFilterBar="true">
						<fb:control>
							<DateTimePicker id="datetime-to" displayFormat="MM/dd/yyyy HH:mm:ss" valueFormat="dd/MM/yyyy HH:mm:ss" 
								change="fnLoadQueueMonitoring"/>		
						</fb:control>					        
					</fb:FilterGroupItem>
					<fb:FilterGroupItem groupName="GroupDataSourceFilter" name="G" label="{i18n>queueMonitoringStatus}" visibleInFilterBar="true">
						<fb:control>
							<MultiComboBox id="combobox-status" placeholder="Select a status"  items="{/Row}" selectionFinish="fnLoadQueueMonitoring" >
								<items>
								 <core:Item key="{ID_STATUS}" text="{DS_DESCRIPTION}"/>
								</items>
							</MultiComboBox>
						</fb:control>					        
					</fb:FilterGroupItem>
				</fb:filterGroupItems>							
		    </fb:FilterBar>
		    <core:Fragment fragmentName="StreamingEngine.StreamingEngine.view.BusyDialog" type="XML">
			</core:Fragment>
				<Table id="table-queue-monitoring" sticky= "ColumnHeaders,HeaderToolbar" width="auto" noDataText="{i18n>commonNoData}" mode="MultiSelect" selectionChange="fnSelectionChanged" items="{/Row}" showSeparators="All" growing="true" growingThreshold="20" growingScrollToLoad="true" class="sapUiResponsiveMargin tableStyle" updateStarted="fnGrowingStarted">
		    	<headerToolbar>
                    <OverflowToolbar>
							<Title text="{i18n>queueMonitoringlast500Queue}" level="H4"/>
							<ToolbarSpacer/>
								<Button id="button-download-message" text="{i18n>queueMonitoringDownloadMessage}{= ${/Selected} &gt; 1 ? ' (ZIP[' + ${/Selected} +'])' : ''}" icon="sap-icon://download" iconFirst="true" width="auto" enabled="{= ${/Selected} === 0 || ${/Selected} === undefined ? false : true}" visible="true" iconDensityAware="false" press="fnDownloadMessage"/>
							<Button id="button-reset-queue" text="{i18n>queueMonitoringResetQueue}" icon="sap-icon://reset" iconFirst="true" width="auto" enabled="true" visible="true" iconDensityAware="false" press="fnResetQueuePopUp"/>
							<Button id="button-delete-queue" text="{i18n>queueMonitoringDeleteExpiredMessages}" icon="sap-icon://delete" iconFirst="true" width="auto" enabled="true" visible="true" iconDensityAware="false" press="fnDeleteQueuePopUp"/>
							<Button id="button-last-status" text="{i18n>queueMonitoringViewPendingMessage}" icon="sap-icon://pending" iconFirst="true" width="auto" enabled="false" visible="true" iconDensityAware="false" press="fnViewLastMessage"/>
						       <OverflowToolbarButton text="{i18n>commonSort}" type="Transparent" icon="sap-icon://sort" iconFirst="true" width="auto" enabled="true" visible="true"
									iconDensityAware="false" press="fnViewSettingsButtonPressed"/>
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column hAlign="Left" width="5%" vAlign="Top" minScreenWidth="Desktop" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
                        <header>
                            <Text text="{i18n>commonLabelPlant}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
                        </header>
                        <footer/>
                    </Column>
                    <Column hAlign="Left" width="7%" vAlign="Top" minScreenWidth="Desktop" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
                        <header>
                            <Text text="{i18n>commonLabelDataSource}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
                        </header>
                        <footer/>
                    </Column>
                    <Column hAlign="Center" width="6%" vAlign="Top" minScreenWidth="Tablet" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
                        <header>
                            <Text text="{i18n>flowType}" width="auto" wrapping="true"  textAlign="Begin" textDirection="Inherit" visible="true"/>
                        </header>
                        <footer/>
                    </Column>
                    <Column hAlign="Center" width="7%" vAlign="Top" minScreenWidth="Tablet" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
                        <header>
                            <Text text="{i18n>flowName}" width="auto"  wrapping="true"  textAlign="Begin" textDirection="Inherit" visible="true"/>
                        </header>
                        <footer/>
                    </Column>
                    <Column hAlign="Center" width="7%" vAlign="Top" minScreenWidth="Tablet" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
                        <header>
                            <Text text="{i18n>queueMonitoringCreationDate}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
                        </header>
                        <footer/>
                    </Column>
                    <Column hAlign="Center" width="7%" vAlign="Top" minScreenWidth="Tablet" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
                        <header>
                            <Text text="{i18n>jobsMonitoringStartDate}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
                        </header>
                        <footer/>
                    </Column>
                    <Column hAlign="Center" width="7%" vAlign="Top" minScreenWidth="Tablet" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
                        <header>
                            <Text text="{i18n>jobsMonitoringEndDate}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
                        </header>
                        <footer/>
                    </Column>
                    <Column hAlign="Center" width="5%" vAlign="Top" minScreenWidth="Tablet" demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
                        <header>
                            <Text text="{i18n>queueMonitoringStatus}"  width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
                        </header>
                        <footer/>
                    </Column>
                    <Column hAlign="Left" width="5%" vAlign="Top" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" mergeDuplicates="false">
                        <header>
                            <Text text="{i18n>queueMonitoringDescription}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
                        </header>
                        <footer/>
                    </Column>
                    <Column hAlign="Right" width="5%" vAlign="Top" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" mergeDuplicates="false">
                        <header>
                            <Text text="{i18n>queueMonitoringRetries}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
                        </header>
                        <footer/>
                    </Column>
                    <Column hAlign="Right" width="5%" vAlign="Top" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" mergeDuplicates="false">
                        <header>
                            <Text text="{i18n>queueMonitoringSize}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
                        </header>
                        <footer/>
                    </Column>
                    <Column hAlign="Center" width="7%" vAlign="Top" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" mergeDuplicates="false">
                        <header>
                            <Text text="{i18n>queueMonitoringLastRetry}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
                        </header>
                        <footer/>
                    </Column>
                    <Column hAlign="Left" vAlign="Top" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" mergeDuplicates="false">
                        <header>
                            <Text text="{i18n>queueMonitoringErrorMessage}" width="auto" wrapping="true" textAlign="Begin" textDirection="Inherit" visible="true"/>
                        </header>
                        <footer/>
                    </Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                       	   <Text text="{DS_NAME}"/>
                            <Text text="{SOURCE_NAME}"/>
                             <Text text="{ID_FLOW_TYPE}" />
                            <Text text="{FLOW_DESC}" /> 
                            <Text text="{DT_CREATED}" />
                            <Text text="{DT_RUN_START}" />
                            <Text text="{DT_RUN_END}" />
                            <core:Icon src="{ path:'ID_STATUS', formatter: '.formatter.statusQueueMonitoringIcon' }" size="20px" color="{ path:'ID_STATUS', formatter: '.formatter.statusQueueMonitoring' }" visible="true"/>
                            <ObjectNumber number="{DS_DESCRIPTION}" state="{ path:'ID_STATUS', formatter: '.formatter.statusQueueMonitoringGetState' }" />
                            <Text text="{QT_RETRY}" />
                            <Text text="{MESSAGE_SIZE}" />
                            <Text text="{DT_LAST_ERROR}"/>
                            <Text text="{DS_LAST_ERROR}"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
		</content>
		<headerContent>
            <Image src="images/sanofi_logo.png" height="auto" width="100px" visible="true" densityAware="false"/>
        </headerContent>
	<footer>
					<Toolbar visible="{= ${message>/}.length > 0 }">
						<content>
								<Button icon="sap-icon://message-popup" text="{= ${message>/}.length }" visible="{= ${message>/}.length > 0 }"  press="onMessagePopoverPress" />
						</content>
					</Toolbar>
				</footer>
        </Page>
        </pages>
	</App>
</mvc:View>