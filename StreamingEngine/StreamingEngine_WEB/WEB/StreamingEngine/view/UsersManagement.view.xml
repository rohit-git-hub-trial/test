<mvc:View id="view-Users-Management"
    controllerName="StreamingEngine.StreamingEngine.controller.UsersManagement"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:fb="sap.ui.comp.filterbar" xmlns:core="sap.ui.core"
    xmlns:html="http://www.w3.org/1999/xhtml" xmlns="sap.m" width="100%">
    <App>
        <pages>
            <Page id="page-users-management" visible="false" showHeader="false"
                showFooter="{= ${message>/}.length > 0 }" floatingFooter="true">
                <content>
                    <fb:FilterBar id="filterbar-users-management" reset="onSearch" search="onSearch"
                        showRestoreButton="false" showClearButton="true"
                        showFilterConfiguration="false" useToolbar="false" class="filterBar">
                        <fb:filterGroupItems>
                            <fb:FilterGroupItem groupName="GroupFullNameFilter" name="A"
                                label="{i18n>userManagFullName}" visibleInFilterBar="true">
                                <fb:control>
                                    <Input id="input-fullname" type="Text" width="100px"
                                        change="onSearch" />
                                </fb:control>
                            </fb:FilterGroupItem>
                            <fb:FilterGroupItem groupName="GroupUsernameFilter" name="A"
                                label="{i18n>commonUsername}" visibleInFilterBar="true"
                                visible="false">
                                <fb:control>
                                    <Input id="input-username" type="Text" width="100px"
                                        change="onSearch" />
                                </fb:control>
                            </fb:FilterGroupItem>
                        </fb:filterGroupItems>
                    </fb:FilterBar>
                    <core:Fragment fragmentName="StreamingEngine.StreamingEngine.view.BusyDialog"
                        type="XML"></core:Fragment>
                    <Table id="table-users" sticky="ColumnHeaders,HeaderToolbar"
                        width="auto" noDataText="{i18n>commonNoData}"
                        selectionChange="fnSelectionChanged" items="{/Row}"
                        showSeparators="All" growing="true" growingThreshold="20"
                        growingScrollToLoad="true" class="sapUiResponsiveMargin tableStyle">
                        <headerToolbar>
                            <OverflowToolbar>
                                <Button text="{i18n>userManagementSyncUsersList}"
                                    icon="sap-icon://synchronize" press="fnSyncUsersList" />
                                <ToolbarSpacer />
                                <OverflowToolbarButton text="{i18n>commonSort}" type="Transparent"
                                    icon="sap-icon://sort" iconFirst="true" width="auto"
                                    enabled="true" visible="true"
                                    iconDensityAware="false" press="fnViewSettingsButtonPressed" />
                            </OverflowToolbar>
                        </headerToolbar>
                        <columns>
                            <Column hAlign="Left" vAlign="Top" minScreenWidth="Desktop"
                                demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
                                <header>
                                    <Text text="{i18n>userManagFullName}" width="auto"
                                        wrapping="true" textAlign="Begin" textDirection="Inherit"
                                        visible="true" />
                                </header>
                                <footer />
                            </Column>
                            <Column hAlign="Left" vAlign="Top" minScreenWidth="Desktop"
                                demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
                                <header>
                                    <Text text="{i18n>commonUsername}" width="auto"
                                        wrapping="true" textAlign="Begin" textDirection="Inherit"
                                        visible="true" />
                                </header>
                                <footer />
                            </Column>
                            <Column hAlign="Left" vAlign="Top" minScreenWidth="Tablet"
                                demandPopin="false" popinDisplay="Inline" mergeDuplicates="false">
                                <header>
                                    <Text text="{i18n>ProfileEmailAddress}" width="auto"
                                        wrapping="true" textAlign="Begin" textDirection="Inherit"
                                        visible="true" />
                                </header>
                                <footer />
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem type="Navigation" press="fnRowPress">
                                <cells>
                                    <Text text="{DS_FULLNAME}" />
                                    <Text text="{ID_USERNAME}" />
                                    <Text text="{DS_EMAIL}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </content>
                <headerContent>
                    <Image src="images/sanofi_logo.png" height="auto" width="100px" visible="true"
                        densityAware="false" />
                </headerContent>
                <footer>
                    <Toolbar visible="{= ${message>/}.length > 0 }">
                        <content>
                            <Button icon="sap-icon://message-popup" text="{= ${message>/}.length }"
                                visible="{= ${message>/}.length > 0 }" press="onMessagePopoverPress" />
                        </content>
                    </Toolbar>
                </footer>
            </Page>
        </pages>
    </App>
</mvc:View>