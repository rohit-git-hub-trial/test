<?xml version="1.0" encoding="UTF-8" standalone="no"?><SQLQuery AllowBuffering="false" AllowFuture="true" AllowNullValues="false" AutoCommit="True" AutoTypeParameters="false" CacheDuration="0" CacheDurationUnits="M" Columns="" Comment="" Connector="" DateColumn="" DateFormat="MM/dd/yyyy HH:mm:ss" Debug="false" Description="" DocType="SQLQuery" Duration="60" DurationUnits="M" EndDate="" FilterExpr="" FixedQuery="" GroupingExpr="" HanaDataSource="true" ID="3090" InlineTransform="" IntervalCount="1" IsCachable="false" JoinExpr="" Mask="" Method="" Mode="Command" NumberFormat="0.00" Param.1="" Param.10="" Param.11="" Param.12="" Param.13="" Param.14="" Param.15="" Param.16="" Param.17="" Param.18="" Param.19="" Param.2="" Param.20="" Param.21="" Param.22="" Param.23="" Param.24="" Param.25="" Param.26="" Param.27="" Param.28="" Param.29="" Param.3="" Param.30="" Param.31="" Param.32="" Param.4="" Param.5="" Param.6="" Param.7="" Param.8="" Param.9="" ParamDescription.1="QUEUE ID" ParamDescription.10="" ParamDescription.11="" ParamDescription.12="" ParamDescription.13="" ParamDescription.14="" ParamDescription.15="" ParamDescription.16="" ParamDescription.17="" ParamDescription.18="" ParamDescription.19="" ParamDescription.2="REQUEST ID" ParamDescription.20="" ParamDescription.21="" ParamDescription.22="" ParamDescription.23="" ParamDescription.24="" ParamDescription.25="" ParamDescription.26="" ParamDescription.27="" ParamDescription.28="" ParamDescription.29="" ParamDescription.3="" ParamDescription.30="" ParamDescription.31="" ParamDescription.32="" ParamDescription.4="MESSAGE" ParamDescription.5="RESPONSE MESSAGE" ParamDescription.6="" ParamDescription.7="" ParamDescription.8="" ParamDescription.9="" ParamType.1="String" ParamType.10="" ParamType.11="" ParamType.12="" ParamType.13="" ParamType.14="" ParamType.15="" ParamType.16="" ParamType.17="" ParamType.18="" ParamType.19="" ParamType.2="String" ParamType.20="" ParamType.21="" ParamType.22="" ParamType.23="" ParamType.24="" ParamType.25="" ParamType.26="" ParamType.27="" ParamType.28="" ParamType.29="" ParamType.3="String" ParamType.30="" ParamType.31="" ParamType.32="" ParamType.4="String" ParamType.5="" ParamType.6="" ParamType.7="" ParamType.8="" ParamType.9="" Password="" PathID="838" Query="DO (IN ID VARCHAR(36) =&gt; [Param.1], IN R_ID VARCHAR(36) =&gt; [Param.2], IN MESSAGE CLOB =&gt; [Param.4], IN MSG_ERROR CLOB =&gt; [Param.5])&#10;BEGIN&#10;    DECLARE C, S INTEGER;&#10;    DECLARE PID VARCHAR(36);&#10;    UPDATE&#10;        SE.SE_JOB_QUEUE&#10;    SET&#10;        ID_STATUS = 'SUCCESS',&#10;        DS_PENDING_MESSAGE = CASE WHEN (MESSAGE = '') OR (MESSAGE IS NULL) THEN DS_PENDING_MESSAGE ELSE MESSAGE END,&#10;        DS_LAST_ERROR = MSG_ERROR&#10;    WHERE&#10;        (ID_QUEUE = ID) OR (ID_REQUEST = R_ID);&#10;--------------------- GET SUCCESS QUEUE SIZE&#10;    SELECT&#10;        P.QT_SUCCESS_QUEUE_SIZE, P.ID_PLANT INTO S, PID&#10;    FROM&#10;        SE.SE_JOB_QUEUE Q&#10;    INNER JOIN SE.SE_JOB J ON J.ID_JOB = Q.ID_JOB&#10;    INNER JOIN SE.SE_DATA_FLOW F ON F.ID_DATA_FLOW = J.ID_DATA_FLOW&#10;    INNER JOIN SE.SE_SOURCE S ON S.ID_SOURCE = F.ID_SOURCE&#10;    INNER JOIN SE.SE_PLANT P ON P.ID_PLANT = S.ID_PLANT&#10;    WHERE&#10;        (Q.ID_QUEUE = ID) OR (Q.ID_REQUEST = R_ID);&#10;&#10;    QUEUE = SELECT&#10;        ID_QUEUE&#10;    FROM&#10;        SE.SE_JOB_QUEUE Q&#10;    INNER JOIN SE.SE_JOB J ON J.ID_JOB = Q.ID_JOB&#10;    INNER JOIN SE.SE_DATA_FLOW F ON F.ID_DATA_FLOW = J.ID_DATA_FLOW&#10;    INNER JOIN SE.SE_SOURCE S ON S.ID_SOURCE = F.ID_SOURCE&#10;    INNER JOIN SE.SE_PLANT P ON P.ID_PLANT = S.ID_PLANT&#10;    WHERE&#10;       ( ID_STATUS = 'SUCCESS' OR ID_STATUS = 'SPLITTING' ) &#10;        AND      &#10;       ( FL_FLOW_LOGGING IS NULL OR FL_FLOW_LOGGING!='1')&#10;        AND&#10;        P.ID_PLANT = PID&#10;    ORDER BY&#10;        DT_CREATED ASC;&#10;    &#10;    SELECT&#10;        COUNT(*) INTO C&#10;    FROM&#10;        :QUEUE;&#10;--------------------- DELETE EXTRA MESSAGES&#10;    IF (:C &gt; :S)  THEN&#10;        C = :C - :S;&#10;        DELETE&#10;        FROM SE.SE_JOB_QUEUE&#10;        WHERE&#10;            ID_QUEUE IN (&#10;                SELECT TOP :C&#10;                    ID_QUEUE&#10;                FROM&#10;                    :QUEUE&#10;            );&#10;    END IF;&#10;END;" QueryParams="" ReaderRoles="SAP_XMII_User" RestrictedPropertyOverride="false" ResultSetMode="false" RowCount="100" SaveDate="05/31/2024 17:07:25" Schedule="" SelectedColumns="" Server="Z_STREAMING_ENGINE" Service="" SetMaxRows="true" SortExpr="" StartDate="" Tables="" Time="" TimePeriod="" Trace="false" TransformerLibrary="" UseTypedParams="T" UserName="" Version="15.5.1.41" WriterRoles="SAP_XMII_Super_Administrator,SAP_XMII_Administrator,SAP_XMII_Developer" XParamName.1="" XParamName.10="" XParamName.11="" XParamName.12="" XParamName.13="" XParamName.14="" XParamName.15="" XParamName.16="" XParamName.2="" XParamName.3="" XParamName.4="" XParamName.5="" XParamName.6="" XParamName.7="" XParamName.8="" XParamName.9="" XParamValue.1="" XParamValue.10="" XParamValue.11="" XParamValue.12="" XParamValue.13="" XParamValue.14="" XParamValue.15="" XParamValue.16="" XParamValue.2="" XParamValue.3="" XParamValue.4="" XParamValue.5="" XParamValue.6="" XParamValue.7="" XParamValue.8="" XParamValue.9="" XmlDateFormat="yyyy-MM-dd'T'HH:mm:ss" XmlNumberFormat=""><Tasks/><ETCServers/><ETCObjects/></SQLQuery>