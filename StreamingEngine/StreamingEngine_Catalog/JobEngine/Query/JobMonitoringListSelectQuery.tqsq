<?xml version="1.0" encoding="UTF-8" standalone="no"?><SQLQuery AllowBuffering="false" AllowFuture="true" AllowNullValues="true" AutoCommit="false" AutoTypeParameters="false" CacheDuration="0" CacheDurationUnits="M" Columns="" Comment="" Connector="" DateColumn="" DateFormat="MM/dd/yyyy HH:mm:ss" Debug="false" Description="" DocType="SQLQuery" Duration="60" DurationUnits="M" EndDate="" FilterExpr="" FixedQuery="" GroupingExpr="" HanaDataSource="true" ID="3073" InlineTransform="" IntervalCount="1" IsCachable="false" JoinExpr="" Mask="" Method="" Mode="FixedQuery" NumberFormat="0.00" Param.1="" Param.10="" Param.11="" Param.12="" Param.13="" Param.14="" Param.15="" Param.16="" Param.17="" Param.18="" Param.19="" Param.2="" Param.20="" Param.21="" Param.22="" Param.23="" Param.24="" Param.25="" Param.26="" Param.27="" Param.28="" Param.29="" Param.3="" Param.30="" Param.31="" Param.32="" Param.4="" Param.5="" Param.6="" Param.7="" Param.8="" Param.9="" ParamDescription.1="" ParamDescription.10="" ParamDescription.11="" ParamDescription.12="" ParamDescription.13="" ParamDescription.14="" ParamDescription.15="" ParamDescription.16="" ParamDescription.17="" ParamDescription.18="" ParamDescription.19="" ParamDescription.2="" ParamDescription.20="" ParamDescription.21="" ParamDescription.22="" ParamDescription.23="" ParamDescription.24="" ParamDescription.25="" ParamDescription.26="" ParamDescription.27="" ParamDescription.28="" ParamDescription.29="" ParamDescription.3="" ParamDescription.30="" ParamDescription.31="" ParamDescription.32="" ParamDescription.4="" ParamDescription.5="" ParamDescription.6="" ParamDescription.7="" ParamDescription.8="" ParamDescription.9="" ParamType.1="" ParamType.10="" ParamType.11="" ParamType.12="" ParamType.13="" ParamType.14="" ParamType.15="" ParamType.16="" ParamType.17="" ParamType.18="" ParamType.19="" ParamType.2="" ParamType.20="" ParamType.21="" ParamType.22="" ParamType.23="" ParamType.24="" ParamType.25="" ParamType.26="" ParamType.27="" ParamType.28="" ParamType.29="" ParamType.3="" ParamType.30="" ParamType.31="" ParamType.32="" ParamType.4="" ParamType.5="" ParamType.6="" ParamType.7="" ParamType.8="" ParamType.9="" Password="" PathID="838" Query="SELECT * FROM (&#10;    SELECT &#10;            LPAD(ROW_NUMBER() OVER (ORDER BY DS_NAME ASC,&#9;&#9;&#9;&#10;                SOURCE_NAME ASC,&#10;                ID_FLOW_TYPE ASC,&#10;                FLOW_NAME ASC,&#10;                TAGS_COUNT DESC ), 4, '0') AS ROW_ID,&#10;        R.*,&#10;        (QT_QUEUED_PENDING + QT_QUEUED_EXPIRED) AS QT_QUEUED_TOTAL,&#10;        (CASE WHEN QT_QUEUED_EXPIRED &gt; 0 THEN 'R' ELSE (CASE WHEN QT_QUEUED_PENDING &gt; 0 THEN 'Y' ELSE 'G' END) END) AS FL_STATUS_QUEUE&#10;    FROM (&#10;        SELECT&#10;            J.ID_JOB,&#10;            P.ID_PLANT,&#10;            P.DS_NAME,&#10;            (CASE WHEN S.ID_INITIAL_LOAD_PARENT IS NOT NULL AND F.ID_FLOW_TYPE = 'ARCHIVE' THEN 'INITIAL LOAD' &#10;                  WHEN S.ID_INITIAL_LOAD_PARENT IS NOT NULL AND F.ID_FLOW_TYPE = 'CONTEXTUAL' THEN 'HISTORICAL UPLOAD' ELSE&#10;            (CASE WHEN J.ID_IMPORT IS NOT NULL THEN 'MANUAL IMPORT' ELSE F.ID_FLOW_TYPE END)&#10;        END) AS ID_FLOW_TYPE,&#10;            F.DS_NAME AS FLOW_NAME,&#10;            (CASE WHEN J.ID_IMPORT IS NOT NULL THEN LEFT(M.DS_FILE_NAME, 15) || '... (' || M.DS_USERNAME || ')' ELSE S.DS_NAME END) AS SOURCE_NAME,&#10;            S.ID_SOURCE,&#10;            J.DT_LAST_RUN_EXECUTION,&#10;            J.DT_LAST_RUN_START,&#10;            J.DT_LAST_RUN_END,&#10;            J.FL_NEW_VERSION,&#10;            J.DS_ALERT_JOB,&#10;            J.DT_ALERT_JOB,&#10;            J.DS_ALERT_QUEUE,&#10;            J.DT_ALERT_QUEUE,&#10;            J.ID_IMPORT,&#10;            [Param.2]&#10;            (CASE WHEN (J.DT_LAST_ERROR IS NOT NULL) THEN 'R' ELSE&#10;                (CASE WHEN J.FL_NEW_VERSION = 1 THEN 'Y' ELSE&#10;                    (CASE WHEN S.ID_INITIAL_LOAD_PARENT IS NOT NULL THEN 'L' ELSE &#10;                    (CASE WHEN J.ID_IMPORT IS NOT NULL THEN 'I' ELSE &#10;                        (CASE WHEN &#10;                            ABS(SECONDS_BETWEEN(J.DT_LAST_RUN_EXECUTION, J.DT_LAST_RUN_END)/60) - P.QT_RUN_DURATION_IN_MINS &gt; 1 OR&#10;                            ABS(SECONDS_BETWEEN(J.DT_LAST_RUN_END, J.DT_LAST_RUN_START)/60) - P.QT_RUN_DURATION_IN_MINS &gt; 1 OR&#10;                            (J.DT_LAST_RUN_START IS NULL AND J.DT_LAST_RUN_END IS NOT NULL) THEN 'B' &#10;                        ELSE &#10;                            'G' &#10;                        END) &#10;                    END)&#10;                    END)&#10;                END)&#10;            END) AS FL_STATUS_JOB, &#10;            (J.QT_LAST_RUN_SIZE/1024) AS QT_LAST_RUN_SIZE,&#10;            &#10;&#9;&#9;&#9;IFNULL(J.QT_CATCHUP_DURATION_MINS, P.QT_RUN_DURATION_IN_MINS) AS QT_CATCHUP_DURATION_MINS,&#10;            J.QT_LAST_RUN_DURATION,&#10;            (CASE WHEN (J.DT_LAST_ERROR IS NULL) THEN J.DS_LAST_RUN_MESSAGE ELSE J.DS_LAST_ERROR END) AS DS_MESSAGE,    &#10;            (SELECT COUNT(Q.ID_QUEUE) FROM SE.SE_JOB_QUEUE Q WHERE Q.ID_JOB = J.ID_JOB AND ID_STATUS = 'PENDING') AS QT_QUEUED_PENDING,&#10;            (SELECT COUNT(Q.ID_QUEUE) FROM SE.SE_JOB_QUEUE Q WHERE Q.ID_JOB = J.ID_JOB AND ID_STATUS = 'EXPIRED') AS QT_QUEUED_EXPIRED,&#10;            (CASE WHEN J.ID_IMPORT IS NOT NULL THEN 1 ELSE&#10;                (CASE WHEN F.ID_FLOW_TYPE = 'ARCHIVE' OR F.ID_FLOW_TYPE = 'QUALISTEO' THEN (SELECT COUNT(M.ID_TAG) FROM SE.SE_TAG_MAPPING M WHERE M.ID_JOB = J.ID_JOB) ELSE NULL END)&#10;            END) AS QT_TAG_COUNT,&#10;            (CASE WHEN J.DT_LAST_ERROR IS NOT NULL THEN TO_VARCHAR(J.DS_LAST_ERROR) ELSE&#10;                (CASE WHEN S.ID_INITIAL_LOAD_PARENT IS NOT NULL &#10;                    THEN 'Initial Load from ' || TO_VARCHAR(S.DT_INITIAL_LOAD_START,'YYYY-MM-DD HH24:MI:SS') || ' to ' || TO_VARCHAR(S.DT_INITIAL_LOAD_END,'YYYY-MM-DD HH24:MI:SS')  || '. Estimated to finish in ' ||  &#10;                    TRIM(IFNULL(TO_VARCHAR((ABS(SECONDS_BETWEEN(S.DT_INITIAL_LOAD_END, J.DT_LAST_RUN_END)/60)/J.QT_CATCHUP_DURATION_MINS)* P.QT_RUN_DURATION_IN_MINS / 60, '9999990.00'), '[...]')) || ' hour(s).'  ELSE NULL END) &#10;            END) AS JOB_STATUS_LABEL,&#10;            (CASE WHEN F.ID_FLOW_TYPE = 'ARCHIVE' OR F.ID_FLOW_TYPE = 'QUALISTEO' THEN (SELECT COUNT(M.ID_TAG) FROM SE.SE_TAG_MAPPING M WHERE M.ID_JOB = J.ID_JOB) ELSE NULL END)  TAGS_COUNT&#10;        FROM&#10;            SE.SE_JOB J&#10;            INNER JOIN SE.SE_DATA_FLOW F ON F.ID_DATA_FLOW = J.ID_DATA_FLOW&#10;            INNER JOIN SE.SE_SOURCE S ON S.ID_SOURCE = F.ID_SOURCE&#10;            INNER JOIN SE.SE_PLANT P ON P.ID_PLANT = S.ID_PLANT&#10;        LEFT OUTER JOIN SE.SE_MANUAL_IMPORT M ON M.ID_IMPORT = J.ID_IMPORT&#10;        WHERE&#10;            S.ID_PLANT LIKE '[Param.1]' AND &#10;            S.FL_ENABLED = 1 AND&#10;            F.FL_ENABLED = 1 AND &#10;            J.FL_DELETED = 0 AND &#10;            (S.ID_PLANT IN (SELECT RESULT FROM SQLSCRIPT_STRING:SPLIT_TO_TABLE('[Param.20]',',')) OR '[Param.20]' = '*')&#10;             ORDER BY &#10;            DS_NAME ASC,&#9;&#9;&#9;&#10;            SOURCE_NAME ASC,&#10;            ID_FLOW_TYPE ASC,&#10;            FLOW_NAME ASC,&#10;            TAGS_COUNT DESC   &#10;    ) R        &#10;    WHERE&#10;         (R.QT_TAG_COUNT &gt; 0 AND (R.ID_FLOW_TYPE = 'ARCHIVE' OR R.ID_FLOW_TYPE = 'INITIAL LOAD')) OR (R.ID_FLOW_TYPE != 'ARCHIVE')&#10;) S&#10;ORDER BY&#10;    CASE FL_STATUS_JOB WHEN 'R' THEN 0 &#10;        WHEN 'L' THEN 1&#10;        WHEN 'I' THEN 2&#10;        WHEN 'Y' THEN 3&#10;        WHEN 'B' THEN 4&#10;        WHEN 'G' THEN 5&#10;    END ASC,&#10;    CASE FL_STATUS_QUEUE WHEN 'R' THEN 0 &#10;        WHEN 'Y' THEN 1&#10;        WHEN 'G' THEN 2&#10;    END ASC,&#10;    ROW_ID ASC" QueryParams="" ReaderRoles="SAP_XMII_User" RestrictedPropertyOverride="false" ResultSetMode="false" RowCount="1000" SaveDate="07/22/2025 06:12:16" Schedule="" SelectedColumns="" Server="Z_STREAMING_ENGINE" Service="" SetMaxRows="true" SortExpr="" StartDate="" Tables="" Time="" TimePeriod="" Trace="false" TransformerLibrary="" UseTypedParams="false" UserName="" Version="15.5.1.41" WriterRoles="SAP_XMII_Super_Administrator,SAP_XMII_Administrator,SAP_XMII_Developer" XParamName.1="" XParamName.10="" XParamName.11="" XParamName.12="" XParamName.13="" XParamName.14="" XParamName.15="" XParamName.16="" XParamName.2="" XParamName.3="" XParamName.4="" XParamName.5="" XParamName.6="" XParamName.7="" XParamName.8="" XParamName.9="" XParamValue.1="" XParamValue.10="" XParamValue.11="" XParamValue.12="" XParamValue.13="" XParamValue.14="" XParamValue.15="" XParamValue.16="" XParamValue.2="" XParamValue.3="" XParamValue.4="" XParamValue.5="" XParamValue.6="" XParamValue.7="" XParamValue.8="" XParamValue.9="" XmlDateFormat="yyyy-MM-dd'T'HH:mm:ss" XmlNumberFormat=""><Tasks/><ETCServers/><ETCObjects/></SQLQuery>