ParamType.27="" ParamType.28="" ParamType.29="" ParamType.3="" ParamType.30="" ParamType.31="" ParamType.32="String" ParamType.4="" ParamType.5="" ParamType.6="" ParamType.7="" ParamType.8="" ParamType.9="" Password="" PathID="838" Query="SELECT&#10;    P.ID_PLANT,&#10;    J.ID_JOB,&#10;    J.ID_JOB_NEW_VERSION,&#10;    J.DT_LAST_RUN_START,&#10;    J.DT_LAST_RUN_END,&#10;    F.FL_COMPRESSED,&#10;    F.FL_TRANSFORMATION,&#10;    F.CD_INPUT_FORMAT,&#10;    F.CD_OUTPUT_FORMAT,&#10;    F. FL_JSON_FILTERING,&#10;    F.FL_TEXT_FILE,&#10;    S.DS_MII_DATA_SERVER_FILE,&#10;    S.DS_MII_DATA_SERVER_PROCESS,&#10;    S.DS_MII_DATA_SERVER_CONTEXT,&#10;    S.DS_MII_DATA_SERVER_C_TYPE,&#10;    J.DS_CACHE_TAG_LIST,&#10;    J.DS_CACHE_DISP_LIST,&#10;    F.ID_DATA_FLOW,&#10;    F.DS_SQL_QUERY,&#10;    F.DS_MII_TRANSACTION,&#10;    F.ID_DATA_DESTINATION,&#10;    P.QT_RUN_DURATION_IN_MINS,&#10;    IFNULL(J.QT_CATCHUP_DURATION_MINS, P.QT_RUN_DURATION_IN_MINS) AS QT_CATCHUP_DURATION_MINS,&#10;    IFNULL(F.QT_MAX_REQUEST_TIMEFRAME, 0) AS  QT_MAX_REQUEST_TIMEFRAME,&#10;    P.QT_FLOW_TIMEOUT,&#10;    P.QT_FLOW_MAX_FILE_SIZE,&#10;    S.ID_INITIAL_LOAD_PARENT,&#10;    S.DT_INITIAL_LOAD_END,&#10;    J.ID_IMPORT,&#10;    F.DS_NAME,&#10;    F.FL_FLOW_LOGGING,&#10;    F.DT_LOGGING_END_DATE,&#10;    F.ID_INITIAL_LOAD_PARENT AS FLOW_ID_INITIAL_LOAD_PARENT,&#10;    F.DS_COUNTRY,&#10;    F.DS_FREQUENCY_GAS,&#10;    F.DS_FREQUENCY_POWER,&#10;    F.ID_QUALISTEO_PROJECT,&#10;    K.FL_MESSAGE_SPLIT,&#10;    K.QT_SPLIT_SIZE_COMPRESSED,&#10;    K.QT_SPLIT_SIZE_NOT_COMPRESSED &#10;FROM&#10;    SE.SE_JOB J&#10;    INNER JOIN SE.SE_DATA_FLOW F ON F.ID_DATA_FLOW = J.ID_DATA_FLOW&#10;    INNER JOIN SE.SE_SOURCE S ON S.ID_SOURCE = F.ID_SOURCE&#10;    INNER JOIN SE.SE_PLANT P ON P.ID_PLANT = S.ID_PLANT&#10;    INNER JOIN SE.SE_DATA_DESTINATION  K ON K.ID_DATA_DESTINATION = F.ID_DATA_DESTINATION&#10;WHERE&#10;    (SELECT COUNT(*) FROM SE.SE_JOB_QUEUE Q WHERE Q.ID_JOB = J.ID_JOB AND Q.ID_STATUS = 'RUNNING') = 0 AND&#10;    S.FL_ENABLED = 1 AND&#10;    F.ID_FLOW_TYPE = [Param.1] AND&#10;    (F.ID_DATA_FLOW = [Param.2] OR [Param.2] = '' OR [Param.2] IS NULL) AND&#10;    F.FL_SYNCHRONOUS = 0 AND&#10;    S.ID_INITIAL_LOAD_PARENT is null AND&#10;    F.FL_ENABLED = 1 AND &#10;    J.FL_DELETED = 0 AND&#10;    J.FL_NEW_VERSION = 0" QueryParams="" ReaderRoles="SAP_XMII_User" RestrictedPropertyOverride="false" ResultSetMode="false" RowCount="100000" SaveDate="05/16/2025 07:00:29" Schedule="" SelectedColumns="" Server="Z_STREAMING_ENGINE" Service="" SetMaxRows="true" SortExpr="" StartDate="" Tables="" Time="" TimePeriod="" Trace="false" TransformerLibrary="" UseTypedParams="T" UserName="" Version="15.5.1.41" WriterRoles="SAP_XMII_Super_Administrator,SAP_XMII_Administrator,SAP_XMII_Developer" XParamName.1="" XParamName.10="" XParamName.11="" XParamName.12="" XParamName.13="" XParamName.14="" XParamName.15="" XParamName.16="" XParamName.2="" XParamName.3="" XParamName.4="" XParamName.5="" XParamName.6="" XParamName.7="" XParamName.8="" XParamName.9="" XParamValue.1="" XParamValue.10="" XParamValue.11="" XParamValue.12="" XParamValue.13="" XParamValue.14="" XParamValue.15="" XParamValue.16="" XParamValue.2="" XParamValue.3="" XParamValue.4="" XParamValue.5="" XParamValue.6="" XParamValue.7="" XParamValue.8="" XParamValue.9="" XmlDateFormat="yyyy-MM-dd'T'HH:mm:ss" XmlNumberFormat=""><Tasks/><ETCServers/><ETCObjects/></SQLQuery>