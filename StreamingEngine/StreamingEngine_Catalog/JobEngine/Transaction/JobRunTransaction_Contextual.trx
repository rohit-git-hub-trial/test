y_4.Param.1</To><From>Transaction.JobID</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobSuccessUpdateQuery_4.Param.2</To><From>Local.QueryStartDate</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobSuccessUpdateQuery_4.Param.3</To><From>Local.QueryEndDate</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobSuccessUpdateQuery_4.Param.4</To><From>datenow</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobSuccessUpdateQuery_4.Param.6</To><From>datediff(Local.DateNow, datenow)</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobSuccessUpdateQuery_4.Param.5</To><From>Local.MessageSize</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobSuccessUpdateQuery_4.Param.7</To><From>Local.ResponseSuccessMsg</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobSuccessUpdateQuery_4.Param.8</To><From>Transaction.RunDurationInMins</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobSuccessUpdateQuery_4.Param.9</To><From>Transaction.FlowMaxFileSize</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobSuccessUpdateQuery_4.Param.10</To><From>stringif(Local.CatchUpFlag, (Local.MessageSize/Transaction.RunCatchUpMins)*Transaction.RunDurationInMins, Local.MessageSize)</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>Assignment_Message_Size_4</Name><Description> </Description><Expiration/><IncomingLinks/><OutgoingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Local.MessageSize</To><From>stringif(Transaction.CompressedFlag, stringlength(GzipBase64_2.Output), 
stringif(Transaction.ContextMIIDataServerType == "SQL", stringlength(SQL_Query.ResultsAsString), stringlength(PCo_Query.ResultsAsString)))</From></Assign></OutgoingLinks></Action></Actions></Step></Steps><Actions><Action><Name>JobQueueSuccessUpdateQuery_1</Name><Description>SQL Query</Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>JobQueueSuccessUpdateQuery_1.Param.1</To><From>Local.QueueID</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobQueueSuccessUpdateQuery_1.Param.4</To><From>stringif(Transaction.CompressedFlag, GzipBase64_2.Output, Local.QueryResult)</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobQueueSuccessUpdateQuery_1.Param.5</To><From>Local.ResponseSuccessMsg</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>Conditional_Job_Success_2</Name><Description> </Description><Expiration>Sequence_85</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Conditional_Job_Success_2.Input1</To><From>Local.PostFailedFlag == false</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions/></Step></Steps><Actions><Action><Name>JobQueueInsertQuery_2</Name><Description>SQL Query</Description><Expiration>Sequence_59</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>JobQueueInsertQuery_2.Param.1</To><From>Local.QueueID</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobQueueInsertQuery_2.Param.2</To><From>Transaction.JobID</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobQueueInsertQuery_2.Param.3</To><From>Local.QueryStartDate</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobQueueInsertQuery_2.Param.4</To><From>Local.QueryEndDate</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobQueueInsertQuery_2.Param.5</To><From>datenow</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>IS_V2_SPLIT</Name><Description> </Description><Expiration>SETUP_MISSING</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>IS_V2_SPLIT.Input1</To><From>Persistent.SPLIT_V2</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions/></Step><Step xsi:type="ActionSequence"><Name>SETUP_MISSING</Name><Description/><Steps/><Actions><Action><Name>JobFailUpdateQuery_3</Name><Description>SQL Query</Description><Expiration>INITIAL_UPLOAD_EXPIRED</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>JobFailUpdateQuery_3.Param.1</To><From>Transaction.JobID</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobFailUpdateQuery_3.Param.2</To><From>datenow</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobFailUpdateQuery_3.Param.3</To><From>"Configuration Missing"</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>Conditional_SQL_QUERY</Name><Description> </Description><Expiration>SQL_COMMAND</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Conditional_SQL_QUERY.Input1</To><From>Transaction.ContextSQLCommand != ""</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Conditional_SQL_QUERY.Input2</To><From>Transaction.ContextSQLCommand != nullstring</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Conditional_SQL_QUERY.Input3</To><From>Transaction.ContextSQLCommand != "NA"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Conditional_SQL_QUERY.Input4</To><From>Transaction.ContextSQLCommand != " "</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>Conditional_MII_Transaction</Name><Description> </Description><Expiration>MII_TRANSACTION</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Conditional_MII_Transaction.Input1</To><From>Transaction.ContextMIITransaction != ""</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Conditional_MII_Transaction.Input2</To><From>Transaction.ContextMIITransaction != nullstring</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step><Step xsi:type="Conditional"><Name>INITIAL_UPLOAD_EXPIRED</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_15</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>SendEmailNotification</Name><Description/><Steps><Step xsi:type="Conditional"><Name>Sequence_92</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_94</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_99</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_96</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_100</Name><Description/><Steps/><Actions><Action><Name>LogSaver_6</Name><Description> </Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_6.LogModuleId</To><From>"StreamingEngine"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_6.LogSeverity</To><From>"D"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_6.LogUser</To><From>username</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_6.LogTransactionName</To><From>transactionpath</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_6.LogObjectId</To><From>Transaction.PlantID</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_6.MessageTitle</To><From>"Historical Upload Completion Alert Details – Contextual Flow "</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_6.MessageDescription</To><From>"Historical Upload Completion Alert Details – Contextual Flow 
Email Address : "&amp;UserProfileEmailListSelectForHistoricalUploadQuery_0.Results{/Rowsets/Rowset/Row/DS_EMAIL}&amp;"
Plant Name: "&amp;HistoricalUploadFlowListSelectQuery_0.Results{/Rowsets/Rowset/Row/PLANT}&amp;"
Server URL: "&amp;Persistent.ServerBaseURL&amp;"
Data Source: "&amp;HistoricalUploadFlowListSelectQuery_0.Results{/Rowsets/Rowset/Row/SOURCE_NAME}&amp;"
Flow Name: "&amp;HistoricalUploadFlowListSelectQuery_0.Results{/Rowsets/Rowset/Row/FLOW_NAME}&amp;"
Historical Upload Start Date: "&amp;Local.UploadStartDate&amp;"
Historical Upload End Date: "&amp;Local.UploadEndDate&amp;"
Upload Completion Timestamp: "&amp;Local.CurrentDate&amp;"
Upload Status: "&amp;Local.HistoricalUploadStaus&amp;"
Queue Pending Messages: "&amp;HistoricalUploadFlowListSelectQuery_0.Results{/Rowsets/Rowset/Row/DS_PENDING_MESSAGES}&amp;"
Queue Expired Messages: "&amp;HistoricalUploadFlowListSelectQuery_0.Results{/Rowsets/Rowset/Row/DS_EXPIRED_MESSAGES}</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>SendEmailAlertTransaction_2</Name><Description> </Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>SendEmailAlertTransaction_2.ToAddress</To><From>UserProfileEmailListSelectForHistoricalUploadQuery_0.Results{/Rowsets/Rowset/Row/DS_EMAIL}</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>SendEmailAlertTransaction_2.Subject</To><From>"[Streaming Engine Alert] "&amp; HistoricalUploadFlowListSelectQuery_0.Results{/Rowsets/Rowset/Row/PLANT} &amp; " Historical Upload Completion Alert – Contextual Flow" </From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>SendEmailAlertTransaction_2.FromAddress</To><From>Persistent.SenderName</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>SendEmailAlertTransaction_2.EmailBody</To><From>"&lt;html&gt;
&lt;head&gt;
    &lt;style&gt;
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f6f8;
            margin: 0;
            padding: 0;
        }
        .container {
            width: 100%;
            padding: 20px;
        }
        .email-box {
            max-width: 700px;
            background-color: #ffffff;
            margin: auto;
            border-radius: 6px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.1);
            overflow: hidden;
        }
        .header {
            background-color: #0070c0;
            color: white;
            padding: 15px;
            font-size: 18px;
            font-weight: bold;
        }
        .content {
            padding: 20px;
        }
        .table {
            width: 100%;
            border-collapse: collapse;
        }
        .table td {
            padding: 10px;
            border-bottom: 1px solid #e0e0e0;
        }
        .label {
            font-weight: bold;
            width: 40%;
            background-color: #f9f9f9;
        }
        .status-success {
            color: green;
            font-weight: bold;
        }
        .status-failure {
            color: red;
            font-weight: bold;
        }
        .footer {
            padding: 15px;
            font-size: 12px;
            color: #666;
            text-align: center;
        }
    &lt;/style&gt;
&lt;/head&gt;

&lt;body&gt;
    &lt;div class='container'&gt;
        &lt;div class='email-box'&gt;
            
            &lt;div class='header'&gt;
                Historical Upload Completion Alert – Contextual Flow
            &lt;/div&gt;

            &lt;div class='content'&gt;
                &lt;table class='table'&gt;
                    &lt;tr&gt;
                        &lt;td class='label'&gt;Plant Name&lt;/td&gt;
                        &lt;td&gt;"&amp;HistoricalUploadFlowListSelectQuery_0.Results{/Rowsets/Rowset/Row/PLANT}&amp;"&lt;/td&gt;
                    &lt;/tr&gt;
                    &lt;tr&gt;
                        &lt;td class='label'&gt;Server URL&lt;/td&gt;
                        &lt;td&gt;"&amp;Persistent.ServerBaseURL&amp;"&lt;/td&gt;
                    &lt;/tr&gt;
                    &lt;tr&gt;
                        &lt;td class='label'&gt;Data Source&lt;/td&gt;
                        &lt;td&gt;"&amp;HistoricalUploadFlowListSelectQuery_0.Results{/Rowsets/Rowset/Row/SOURCE_NAME}&amp;"&lt;/td&gt;
                    &lt;/tr&gt;
                    &lt;tr&gt;
                        &lt;td class='label'&gt;Flow Name&lt;/td&gt;
                        &lt;td&gt;"&amp;HistoricalUploadFlowListSelectQuery_0.Results{/Rowsets/Rowset/Row/FLOW_NAME}&amp;"&lt;/td&gt;
                    &lt;/tr&gt;
                    &lt;tr&gt;
                        &lt;td class='label'&gt;Historical Upload Start Date&lt;/td&gt;
                        &lt;td&gt;"&amp;Local.UploadStartDate&amp;"&lt;/td&gt;
                    &lt;/tr&gt;
                    &lt;tr&gt;
                        &lt;td class='label'&gt;Historical Upload End Date&lt;/td&gt;
                        &lt;td&gt;"&amp;Local.UploadEndDate&amp;"&lt;/td&gt;
                    &lt;/tr&gt;
                    &lt;tr&gt;
                        &lt;td class='label'&gt;Upload Completion Timestamp&lt;/td&gt;
                        &lt;td&gt;"&amp;Local.CurrentDate&amp;"&lt;/td&gt;
                    &lt;/tr&gt;
                    &lt;tr&gt;
                        &lt;td class='label'&gt;Upload Status&lt;/td&gt;
                        &lt;td&gt;"&amp;Local.HistoricalUploadStaus&amp;"&lt;/td&gt;
                    &lt;/tr&gt;
                    &lt;tr&gt;
                        &lt;td class='label'&gt;Queue Pending Messages&lt;/td&gt;
                        &lt;td&gt;"&amp;HistoricalUploadFlowListSelectQuery_0.Results{/Rowsets/Rowset/Row/DS_PENDING_MESSAGES}&amp;"&lt;/td&gt;
                    &lt;/tr&gt;
					&lt;tr&gt;
                        &lt;td class='label'&gt;Queue Expired Messages&lt;/td&gt;
                        &lt;td&gt;"&amp;HistoricalUploadFlowListSelectQuery_0.Results{/Rowsets/Rowset/Row/DS_EXPIRED_MESSAGES}&amp;"&lt;/td&gt;
                    &lt;/tr&gt;

                &lt;/table&gt;
            &lt;/div&gt;

            &lt;div class='footer'&gt;
                This is an automated notification from MII. Please do not reply.
            &lt;/div&gt;

        &lt;/div&gt;
    &lt;/div&gt;
&lt;/body&gt;
&lt;/html&gt;"</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>Assignment_1</Name><Description> </Description><Expiration/><IncomingLinks/><OutgoingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Local.HistoricalUploadStaus</To><From>stringif(HistoricalUploadFlowListSelectQuery_0.Results{/Rowsets/Rowset/Row/DS_EXPIRED_MESSAGES}==0, "Success ", "Expired messages found in Queue Monitoring ")</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Local.TimeZone</To><From>"UTC" &amp; stringif(currenttimezoneoffset &gt; 0,"+","") &amp; (currenttimezoneoffset/3600000) &amp; " H "  &amp; currenttimezone</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Local.CurrentDate</To><From>datefromxmlformat(datenow, "MM/dd/yyyy HH:mm:ss") &amp; " " &amp;Local.TimeZone  </From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Local.UploadEndDate</To><From>datefromxmlformat(HistoricalUploadFlowListSelectQuery_0.Results{/Rowsets/Rowset/Row/DT_HISTORICAL_UPLOAD_END}, "MM/dd/yyyy HH:mm:ss") &amp; " " &amp;Local.TimeZone  </From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Local.UploadStartDate</To><From>datefromxmlformat(HistoricalUploadFlowListSelectQuery_0.Results{/Rowsets/Rowset/Row/DT_HISTORICAL_UPLOAD_START}, "MM/dd/yyyy HH:mm:ss") &amp; " " &amp;Local.TimeZone  </From></Assign></OutgoingLinks></Action></Actions></Step></Steps><Actions><Action><Name>HistoricalUploadFlowListSelectQuery_0</Name><Description>SQL Query</Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>HistoricalUploadFlowListSelectQuery_0.Param.1</To><From>Transaction.FlowId</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>Conditional_ValidEmailId</Name><Description> </Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Conditional_ValidEmailId.Input1</To><From>UserProfileEmailListSelectForHistoricalUploadQuery_0.Results{/Rowsets/Rowset/Row/DS_EMAIL} !="---"</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>UserProfileEmailListSelectForHistoricalUploadQuery_0</Name><Description>SQL Query</Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>UserProfileEmailListSelectForHistoricalUploadQuery_0.Param.1</To><From>Transaction.JobID</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step><Step xsi:type="Catch"><Name>Sequence_17</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_126</Name><Description/><Steps/><Actions><Action><Name>LogSaver_8</Name><Description> </Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_8.LogModuleId</To><From>"StreamingEngine"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_8.LogSeverity</To><From>"E"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_8.LogUser</To><From>username</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_8.LogTransactionName</To><From>transactionpath</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_8.LogObjectId</To><From>Transaction.PlantID</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_8.MessageTitle</To><From>"Historical Upload Completion Alert – Contextual Flow  failed"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_8.MessageDescription</To><From>"Historical Upload Completion Alert – Contextual Flow  failed for the following reason: " &amp; Catch_0.Source &amp; "|" &amp;Catch_0.Message</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>Catch_0</Name><Description>Catches an exception</Description><Expiration/><IncomingLinks/><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>HistoricalUploadJobDeletedFlagUpdateQuery</Name><Description>SQL Query</Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>HistoricalUploadJobDeletedFlagUpdateQuery.Param.1</To><From>Transaction.JobID</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>Conditional_InitialUploadExpired</Name><Description> </Description><Expiration>Sequence_15</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Conditional_InitialUploadExpired.Input1</To><From>Local.InitialLoadExpiredFlag</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step><Step xsi:type="Conditional"><Name>CREATE_HISTORICAL_UPLOAD</Name><Description>If the job was down for more than an hour create a historical upload for the down period and set the end date to datenow. So the job can continue sending recent data while the historical will send the data during the down period.</Description><Steps><Step xsi:type="ActionSequence"><Name>Sequence_22</Name><Description/><Steps><Step xsi:type="Conditional"><Name>Sequence_63</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_32</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_67</Name><Description/><Steps/><Actions><Action><Name>LogSaver_3</Name><Description> </Description><Expiration>Sequence_11</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_3.LogModuleId</To><From>"StreamingEngine"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_3.LogSeverity</To><From>"D"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_3.LogUser</To><From>username</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_3.LogTransactionName</To><From>transactionpath</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_3.LogObjectId</To><From>Transaction.PlantID</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_3.MessageTitle</To><From>"Historical Upload Created Automatically"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_3.MessageDescription</To><From>"Historical Upload Created Automatically"</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>JobEndDateUpdateTransaction</Name><Description> </Description><Expiration>Sequence_11</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>JobEndDateUpdateTransaction.JobID</To><From>Transaction.JobID</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobEndDateUpdateTransaction.EndDate</To><From>datefromxmlformat(Transaction.DateNow, "MM/dd/yyyy HH:mm:ss") </From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step><Step xsi:type="ActionSequence"><Name>Sequence_11</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_70</Name><Description/><Steps/><Actions><Action><Name>LogSaver_4</Name><Description> </Description><Expiration>Sequence_64</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_4.LogModuleId</To><From>"StreamingEngine"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_4.LogSeverity</To><From>"D"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_4.LogUser</To><From>username</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_4.LogTransactionName</To><From>transactionpath</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_4.LogObjectId</To><From>Transaction.PlantID</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_4.MessageTitle</To><From>"Automatic creation of Historical Upload failed for the following reason "</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_4.MessageDescription</To><From>HistoricalUploadTransaction.Output{Rowsets/Rowset/Row/ResponseMessage}</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions/></Step><Step xsi:type="Catch"><Name>Sequence_64</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_65</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_71</Name><Description/><Steps/><Actions><Action><Name>LogSaver_5</Name><Description> </Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_5.LogModuleId</To><From>"StreamingEngine"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_5.LogSeverity</To><From>"D"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_5.LogUser</To><From>username</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_5.LogTransactionName</To><From>transactionpath</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_5.LogObjectId</To><From>Transaction.PlantID</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_5.MessageTitle</To><From>"Automatic creation of Historical Upload failed"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_5.MessageDescription</To><From>"Automatic creation of Historical Upload failed for the following reason: " &amp; Catch_AutoHistorical.Source &amp; "|" &amp;Catch_AutoHistorical.Message</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions/></Step></Steps><Actions><Action><Name>Catch_AutoHistorical</Name><Description>Catches an exception</Description><Expiration>UPDATE_NEW_VERSION</Expiration><IncomingLinks/><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>Conditional_SucessHistoricalupload</Name><Description> </Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Conditional_SucessHistoricalupload.Input1</To><From>HistoricalUploadTransaction.Output{Rowsets/Rowset/Row/Status} == "S"</From>