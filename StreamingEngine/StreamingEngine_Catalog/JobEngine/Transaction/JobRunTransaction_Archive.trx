stringif(Transaction.CompressedFlag, GzipBase64.Output, TagHistoryTransaction.OutputJSON),
stringif(Transaction.CompressedFlag, GzipBase64_2.Output, 
    stringreplaceall(stringreplaceall(ManualImportHistorySelectQuery.ResultsAsString, "_DATETIME_", "DateTime"), "_TAG_VALUE_", Transaction.ProcessCachedDisplayList)
)))</From></Assign></OutgoingLinks></Action></Actions></Step></Steps><Actions><Action><Name>ConditionalEmptyMsg</Name><Description> </Description><Expiration>Sequence_30</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>ConditionalEmptyMsg.Input1</To><From>stringlength(Json_To_XML_Converter.Output{/root/Rowsets/Rowset/Row/DateTime}) == 0</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>ConditionalEmptyMsg.Input2</To><From>stringlength(Json_To_XML_Converter.Output{/root/Rowsets/Rowset/Row/_DATETIME_}) == 0</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>Json_To_XML_Converter</Name><Description>Json To XML</Description><Expiration>Sequence_30</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Json_To_XML_Converter.Json</To><From>stringif(Transaction.ImportID == nullstring,TagHistoryTransaction.OutputJSON, ManualImportHistorySelectQuery.ResultsAsString)</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>JobQueueInsertQuery</Name><Description>SQL Query</Description><Expiration>Sequence_42</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>JobQueueInsertQuery.Param.1</To><From>Local.QueueID</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobQueueInsertQuery.Param.2</To><From>Transaction.JobID</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobQueueInsertQuery.Param.3</To><From>Local.QueryStartDate</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobQueueInsertQuery.Param.4</To><From>Local.QueryEndDate</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobQueueInsertQuery.Param.5</To><From>datenow</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step><Step xsi:type="ActionSequence"><Name>Sequence_12</Name><Description/><Steps><Step xsi:type="Conditional"><Name>UPDATE_JOB_ARCHIVE</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_55</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_13</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_14</Name><Description/><Steps/><Actions><Action><Name>JobSuccessUpdateQuery</Name><Description>SQL Query</Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>JobSuccessUpdateQuery.Param.1</To><From>Transaction.JobID</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobSuccessUpdateQuery.Param.2</To><From>Local.QueryStartDate</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobSuccessUpdateQuery.Param.3</To><From>Local.QueryEndDate</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobSuccessUpdateQuery.Param.4</To><From>datenow</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobSuccessUpdateQuery.Param.6</To><From>datediff(Local.DateNow, datenow)</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobSuccessUpdateQuery.Param.5</To><From>Local.MessageSize</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobSuccessUpdateQuery.Param.7</To><From>Local.ResponseSuccessMsg</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobSuccessUpdateQuery.Param.8</To><From>Transaction.RunDurationInMins</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobSuccessUpdateQuery.Param.9</To><From>Transaction.FlowMaxFileSize</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobSuccessUpdateQuery.Param.10</To><From>stringif(Local.CatchUpFlag, (Local.MessageSize/Transaction.RunCatchUpMins)*Transaction.RunDurationInMins, Local.MessageSize)</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobSuccessUpdateQuery.Param.11</To><From>Transaction.MaxRequestTimeframe</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>Assignment_Message_Size_2</Name><Description> </Description><Expiration/><IncomingLinks/><OutgoingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Local.MessageSize</To><From>stringlength(stringif(Transaction.ImportID == nullstring, 
stringif(Transaction.CompressedFlag, GzipBase64.Output, TagHistoryTransaction.OutputJSON),
stringif(Transaction.CompressedFlag, GzipBase64_2.Output, 
    stringreplaceall(stringreplaceall(ManualImportHistorySelectQuery.ResultsAsString, "_DATETIME_", "DateTime"), "_TAG_VALUE_", Transaction.ProcessCachedDisplayList)
)))</From></Assign></OutgoingLinks></Action></Actions></Step></Steps><Actions><Action><Name>JobQueueSuccessUpdateQuery</Name><Description>SQL Query</Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>JobQueueSuccessUpdateQuery.Param.1</To><From>Local.QueueID</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobQueueSuccessUpdateQuery.Param.4</To><From>stringif(Transaction.ImportID == nullstring, 
stringif(Transaction.CompressedFlag, GzipBase64.Output, TagHistoryTransaction.OutputJSON),
stringif(Transaction.CompressedFlag, GzipBase64_2.Output, 
    stringreplaceall(stringreplaceall(ManualImportHistorySelectQuery.ResultsAsString, "_DATETIME_", "DateTime"), "_TAG_VALUE_", Transaction.ProcessCachedDisplayList)
))</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobQueueSuccessUpdateQuery.Param.5</To><From>Local.ResponseSuccessMsg</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>Conditional_Job_Success</Name><Description> </Description><Expiration>Sequence_55</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Conditional_Job_Success.Input1</To><From>Local.PostFailedFlag == false</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions/></Step></Steps><Actions/></Step></Steps><Actions><Action><Name>IS_V2_SPLIT</Name><Description> </Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>IS_V2_SPLIT.Input1</To><From>Persistent.SPLIT_V2</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions/></Step></Steps><Actions><Action><Name>TAGS_EXIST</Name><Description> </Description><Expiration>Sequence_86</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>TAGS_EXIST.Input1</To><From>Transaction.ProcessCachedTagList != nullstring</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>TAGS_EXIST.Input2</To><From>Transaction.ProcessCachedDisplayList != nullstring</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step><Step xsi:type="Conditional"><Name>UPDATE_NEW_VERSION</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_6</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_7</Name><Description/><Steps/><Actions><Action><Name>JobNewVersionUpdateQuery</Name><Description>SQL Query</Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>JobNewVersionUpdateQuery.Param.1</To><From>Transaction.JobNewVersionID</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobNewVersionUpdateQuery.Param.2</To><From>Local.QueryEndDate</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobNewVersionUpdateQuery.Param.3</To><From>"NEW JOB VERSION RELEASED"</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>JobDeletedFlagUpdateQuery_1</Name><Description>SQL Query</Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>JobDeletedFlagUpdateQuery_1.Param.1</To><From>Transaction.JobID</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>Conditional_NewVersion</Name><Description> </Description><Expiration>Sequence_6</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Conditional_NewVersion.Input1</To><From>Transaction.JobNewVersionID != nullstring</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step><Step xsi:type="Conditional"><Name>CREATE_HISTORICAL_UPLOAD</Name><Description>If the job was down for more than an hour create a historical upload for the down period and set the end date to datenow. So the job can continue sending recent data while the historical will send the data during the down period.</Description><Steps><Step xsi:type="ActionSequence"><Name>Sequence_24</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_8</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_9</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_11</Name><Description/><Steps/><Actions><Action><Name>LogSaver_3</Name><Description> </Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_3.LogModuleId</To><From>"StreamingEngine"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_3.LogSeverity</To><From>"D"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_3.LogUser</To><From>username</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_3.LogTransactionName</To><From>transactionpath</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_3.LogObjectId</To><From>Transaction.PlantID</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_3.MessageTitle</To><From>"Historical Upload Created Automatically"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_3.MessageDescription</To><From>"Historical Upload Created Automatically"</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>JobEndDateUpdateTransaction</Name><Description> </Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>JobEndDateUpdateTransaction.JobID</To><From>Transaction.JobID</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobEndDateUpdateTransaction.EndDate</To><From>datefromxmlformat(Transaction.DateNow, "MM/dd/yyyy HH:mm:ss") </From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>InitialLoadTransaction</Name><Description> </Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>InitialLoadTransaction.Action</To><From>"ENABLE"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>InitialLoadTransaction.TagIDList</To><From>listtostring(getlistfromxpath(InitialLoadTagListSelectQuery_0.Results, "/Rowsets/Rowset/Row/ID_TAG"), ",")</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>InitialLoadTransaction.StartDate</To><From>datefromxmlformat(Local.QueryEndDate, "MM/dd/yyyy HH:mm:ss") </From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>InitialLoadTransaction.EndDate</To><From>datefromxmlformat(Transaction.DateNow, "MM/dd/yyyy HH:mm:ss") </From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>InitialLoadTransaction.MaximumRequestTimeframe</To><From>Persistent.MaximumRequestTimeframe</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step><Step xsi:type="Catch"><Name>Sequence_50</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_22</Name><Description/><Steps/><Actions><Action><Name>LogSaver_4</Name><Description> </Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_4.LogModuleId</To><From>"StreamingEngine"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_4.LogSeverity</To><From>"D"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_4.LogUser</To><From>username</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_4.LogTransactionName</To><From>transactionpath</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_4.LogObjectId</To><From>Transaction.PlantID</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_4.MessageTitle</To><From>"Automatic creation of Historical Upload failed"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_4.MessageDescription</To><From>"Automatic creation of Historical Upload failed for the following reason: " &amp; Catch_AutoHistorical.Source &amp; "|" &amp;Catch_AutoHistorical.Message</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>Catch_AutoHistorical</Name><Description>Catches an exception</Description><Expiration/><IncomingLinks/><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>InitialLoadTagListSelectQuery_0</Name><Description>SQL Query</Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>InitialLoadTagListSelectQuery_0.Param.1</To><From>Transaction.JobID</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>Conditional_Down_1Day</Name><Description> </Description><Expiration>Sequence_24</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Conditional_Down_1Day.Input1</To><From>(Transaction.InitialLoadParentId == "")
or
(Transaction.InitialLoadParentId == nullstring)</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Conditional_Down_1Day.Input2</To><From>datediff(Local.QueryEndDate, Transaction.DateNow) &gt; (stringif((3600*Persistent.HistoricalUploadDownTimeHours)&lt;(3600*24),(3600*24),3600*Persistent.HistoricalUploadDownTimeHours))</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Conditional_Down_1Day.Input3</To><From>Transaction.ImportID == nullstring</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step><Step xsi:type="Conditional"><Name>INITIAL_LOAD_EXPIRED</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_17</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_81</Name><Description/><Steps><Step xsi:type="Repeater"><Name>Sequence_20</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_19</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_23</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_18</Name><Description/><Steps/><Actions><Action><Name>InitialLoadTagDeleteQuery_2</Name><Description>SQL Query</Description><Expiration>Sequence_79</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>InitialLoadTagDeleteQuery_2.Param.1</To><From>Repeater_Tag.Output{/Row/ID_TAG}</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>InitialLoadTagMappingDeleteQuery</Name><Description>SQL Query</Description><Expiration>Sequence_79</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>InitialLoadTagMappingDeleteQuery.Param.1</To><From>Repeater_Tag.Output{/Row/ID_TAG}</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>TagMappingTransaction</Name><Description> </Description><Expiration>Sequence_79</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>TagMappingTransaction.TagID</To><From>Repeater_Tag.Output{/Row/ID_TAG}</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>TagMappingTransaction.WatchFlag</To><From>false</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>TagMappingTransaction.PCoDestinationID</To><From>""</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>TagMappingTransaction.ArchiveFlag</To><From>false</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>TagMappingTransaction.RealTimeFlag</To><From>false</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step><Step xsi:type="Conditional"><Name>Sequence_79</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_86</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>SendEmailNotification</Name><Description/><Steps><Step xsi:type="Conditional"><Name>Sequence_93</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_99</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_96</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_83</Name><Description/><Steps/><Actions><Action><Name>LogSaver_5</Name><Description> </Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_5.LogModuleId</To><From>"StreamingEngine"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_5.LogSeverity</To><From>"D"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_5.LogUser</To><From>username</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_5.LogTransactionName</To><From>transactionpath</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_5.LogObjectId</To><From>Transaction.PlantID</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_5.MessageTitle</To><From>"Historical Upload Completion Alert Details – Archive Flow"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_5.MessageDescription</To><From>"Historical Upload Completion Alert Details – Archive Flow 
Email Address : "&amp;UserProfileEmailListSelectForHistoricalUploadQuery_0.Results{/Rowsets/Rowset/Row/DS_EMAIL}&amp;"
Plant Name: "&amp;HistoricalUploadJobIdSelectQuery_0.Results{/Rowsets/Rowset/Row/PLANT}&amp;"
Server URL: "&amp;Persistent.ServerBaseURL&amp;"
Data Source: "&amp;HistoricalUploadJobIdSelectQuery_0.Results{/Rowsets/Rowset/Row/SOURCE_NAME}&amp;"
Flow Name: "&amp;HistoricalUploadJobIdSelectQuery_0.Results{/Rowsets/Rowset/Row/FLOW_NAME}&amp;"
Historical Upload Start Date: "&amp;Local.InitialLoadStartDate&amp;"
Historical Upload End Date: "&amp;Local.InitialLoadEndDate&amp;"
Upload Completion Timestamp: "&amp;Local.CurrentDate&amp;"
Upload Status: "&amp;Local.HistoricalUploadStaus&amp;"
Queue Pending Messages: "&amp;HistoricalUploadJobIdSelectQuery_0.Results{/Rowsets/Rowset/Row/DS_PENDING_MESSAGES}&amp;"
Queue Expired Messages: "&amp;HistoricalUploadJobIdSelectQuery_0.Results{/Rowsets/Rowset/Row/DS_EXPIRED_MESSAGES}&amp;"
Tag List: "&amp;Local.TagList</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>SendEmailAlertTransaction_2</Name><Description> </Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>SendEmailAlertTransaction_2.ToAddress</To><From>UserProfileEmailListSelectForHistoricalUploadQuery_0.Results{/Rowsets/Rowset/Row/DS_EMAIL}</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>SendEmailAlertTransaction_2.Subject</To><From>"[Streaming Engine Alert] "&amp;HistoricalUploadJobIdSelectQuery_0.Results{/Rowsets/Rowset/Row/PLANT} &amp; " Historical Upload Completion Alert – Archive Flow" </From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>SendEmailAlertTransaction_2.FromAddress</To><From>Persistent.SenderName</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>SendEmailAlertTransaction_2.EmailBody</To><From>"&lt;html&gt;
&lt;head&gt;
    &lt;style&gt;
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f6f8;
            margin: 0;
            padding: 0;
        }
        .container {
            width: 100%;
            padding: 20px;
        }
        .email-box {
            max-width: 700px;
            background-color: #ffffff;
            margin: auto;
            border-radius: 6px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.1);
            overflow: hidden;
        }
        .header {
            background-color: #0070c0;
            color: white;
            padding: 15px;
            font-size: 18px;
            font-weight: bold;
        }
        .content {
            padding: 20px;
        }
        .table {
            width: 100%;
            border-collapse: collapse;
        }
        .table td {
            padding: 10px;
            border-bottom: 1px solid #e0e0e0;
        }
        .label {
            font-weight: bold;
            width: 40%;
            background-color: #f9f9f9;
        }
        .status-success {
            color: green;
            font-weight: bold;
        }
        .status-failure {
            color: red;
            font-weight: bold;
        }
        .footer {
            padding: 15px;
            font-size: 12px;
            color: #666;
            text-align: center;
        }
    &lt;/style&gt;
&lt;/head&gt;

&lt;body&gt;
    &lt;div class='container'&gt;
        &lt;div class='email-box'&gt;
            
            &lt;div class='header'&gt;
                Historical Upload Completion Alert – Archive Flow
            &lt;/div&gt;

            &lt;div class='content'&gt;
                &lt;table class='table'&gt;
                    &lt;tr&gt;
                        &lt;td class='label'&gt;Plant Name&lt;/td&gt;
                        &lt;td&gt;"&amp;HistoricalUploadJobIdSelectQuery_0.Results{/Rowsets/Rowset/Row/PLANT}&amp;"&lt;/td&gt;
                    &lt;/tr&gt;
                    &lt;tr&gt;
                        &lt;td class='label'&gt;Server URL&lt;/td&gt;
                        &lt;td&gt;"&amp;Persistent.ServerBaseURL&amp;"&lt;/td&gt;
                    &lt;/tr&gt;
                    &lt;tr&gt;
                        &lt;td class='label'&gt;Data Source&lt;/td&gt;
                        &lt;td&gt;"&amp;HistoricalUploadJobIdSelectQuery_0.Results{/Rowsets/Rowset/Row/SOURCE_NAME}&amp;"&lt;/td&gt;
                    &lt;/tr&gt;
                    &lt;tr&gt;
                        &lt;td class='label'&gt;Flow Name&lt;/td&gt;
                        &lt;td&gt;"&amp;HistoricalUploadJobIdSelectQuery_0.Results{/Rowsets/Rowset/Row/FLOW_NAME}&amp;"&lt;/td&gt;
                    &lt;/tr&gt;
                    &lt;tr&gt;
                        &lt;td class='label'&gt;Historical Upload Start Date&lt;/td&gt;
                        &lt;td&gt;"&amp;Local.InitialLoadStartDate&amp;"&lt;/td&gt;
                    &lt;/tr&gt;
                    &lt;tr&gt;
                        &lt;td class='label'&gt;Historical Upload End Date&lt;/td&gt;
                        &lt;td&gt;"&amp;Local.InitialLoadEndDate&amp;"&lt;/td&gt;
                    &lt;/tr&gt;
                    &lt;tr&gt;
                        &lt;td class='label'&gt;Upload Completion Timestamp&lt;/td&gt;
                        &lt;td&gt;"&amp;Local.CurrentDate&amp;"&lt;/td&gt;
                    &lt;/tr&gt;
					
                    &lt;tr&gt;
                        &lt;td class='label'&gt;Upload Status&lt;/td&gt;
                        &lt;td&gt;"&amp;Local.HistoricalUploadStaus&amp;"&lt;/td&gt;
                    &lt;/tr&gt;
                    &lt;tr&gt;
                        &lt;td class='label'&gt;Queue Pending Messages&lt;/td&gt;
                        &lt;td&gt;"&amp;HistoricalUploadJobIdSelectQuery_0.Results{/Rowsets/Rowset/Row/DS_PENDING_MESSAGES}&amp;"&lt;/td&gt;
                    &lt;/tr&gt;
					&lt;tr&gt;
                        &lt;td class='label'&gt;Queue Expired Messages&lt;/td&gt;
                        &lt;td&gt;"&amp;HistoricalUploadJobIdSelectQuery_0.Results{/Rowsets/Rowset/Row/DS_EXPIRED_MESSAGES}&amp;"&lt;/td&gt;
                    &lt;/tr&gt;
					&lt;tr&gt;
                        &lt;td class='label'&gt;Tag List&lt;/td&gt;
                        &lt;td&gt;"&amp;Local.TagList&amp;"&lt;/td&gt;
                    &lt;/tr&gt;

                &lt;/table&gt;
            &lt;/div&gt;

            &lt;div class='footer'&gt;
                This is an automated notification from MII. Please do not reply.
            &lt;/div&gt;

        &lt;/div&gt;
    &lt;/div&gt;
&lt;/body&gt;
