ons><Action><Name>JobQueueInsertQuery_0</Name><Description>SQL Query</Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>JobQueueInsertQuery_0.Param.1</To><From>Local.QueueID</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobQueueInsertQuery_0.Param.2</To><From>Transaction.JobID</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobQueueInsertQuery_0.Param.3</To><From>Local.QueryStartDate</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobQueueInsertQuery_0.Param.4</To><From>Local.QueryEndDate</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobQueueInsertQuery_0.Param.5</To><From>datenow</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions/></Step></Steps><Actions><Action><Name>ReadFileContent</Name><Description> </Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>ReadFileContent.SourceUrl</To><From>Repeater_Files.Output{/Row/FullPath}</From></Assign></IncomingLinks><OutgoingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Local.FileContent</To><From>stringif(Transaction.CompressedFlag or Transaction.TransformationFlag, base64decode(ReadFileContent.EncodedImage), ReadFileContent.EncodedImage)</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Transaction.TextFileFlag</To><From>Transaction.CompressedFlag or Transaction.TransformationFlag</From></Assign></OutgoingLinks></Action></Actions></Step></Steps><Actions><Action><Name>AssignmentVars_1</Name><Description> </Description><Expiration/><IncomingLinks/><OutgoingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Local.QueueID</To><From>guid</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Local.FileName</To><From>stringleft(Repeater_Files.Output{/Row/Name}, stringlastindexof(Repeater_Files.Output{/Row/Name}, ".") - 1)</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Local.FileExtension</To><From>stringright(Repeater_Files.Output{/Row/Name}, stringlength(Repeater_Files.Output{/Row/Name}) -  stringlastindexof(Repeater_Files.Output{/Row/Name}, "."))</From></Assign></OutgoingLinks></Action></Actions></Step></Steps><Actions><Action><Name>Repeater_Files</Name><Description> </Description><Expiration>BATCH</Expiration><IncomingLinks/><OutgoingLinks/></Action></Actions></Step><Step xsi:type="ActionSequence"><Name>BATCH</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_5</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_8</Name><Description/><Steps/><Actions><Action><Name>FileList2String</Name><Description> </Description><Expiration>ZIP</Expiration><IncomingLinks><Assign xsi:type="AssignXml"><Name/><Description/><To>FileList2String.Input</To><From>Get_File_List.FileList</From></Assign><Assign xsi:type="AssignXml"><Name/><Description/><To>FileList2String.InputXSL</To><From>"&lt;?xml version=\"1.0\" encoding=\"UTF-8\"?&gt;&lt;xsl:stylesheet xmlns:xsl=\"http://www.w3.org/1999/XSL/Transform\" version=\"1.0\"&gt;
&lt;xsl:output method=\"xml\" omit-xml-declaration=\"no\" version=\"1.0\"/&gt;
&lt;xsl:template match=\"/\"&gt;
    &lt;out&gt;
&lt;xsl:value-of select=\"string-join(/Rowsets/Rowset/Row/FullPath, '&amp;#10;')\"/&gt;
&lt;/out&gt;
&lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;"</From></Assign></IncomingLinks><OutgoingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Local.FileList</To><From>FileList2String.Output{/out}</From></Assign></OutgoingLinks></Action></Actions></Step><Step xsi:type="Conditional"><Name>ZIP</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_16</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_1</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_26_handleeroor</Name><Description/><Steps><Step xsi:type="Conditional"><Name>Sequence_52</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>UPDATE_JOB_FAIL_2</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_25</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_56</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_51</Name><Description/><Steps/><Actions><Action><Name>Terminate_Transaction_Query_5</Name><Description> </Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Terminate_Transaction_Query_5.TerminationMessage</To><From>"Zipping files command failed"</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>LogSaver_MultiFileCompressionFailed</Name><Description> </Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_MultiFileCompressionFailed.LogModuleId</To><From>"StreamingEngine"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_MultiFileCompressionFailed.LogSeverity</To><From>"E"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_MultiFileCompressionFailed.LogUser</To><From>username</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_MultiFileCompressionFailed.LogTransactionName</To><From>transactionpath</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_MultiFileCompressionFailed.LogObjectId</To><From>Transaction.FlowID</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_MultiFileCompressionFailed.MessageTitle</To><From>"Zipping files failed. ZIP commadn output:" </From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_MultiFileCompressionFailed.MessageDescription</To><From>"StdOut: " &amp; ZIPFiles.StdOutputStr &amp; lf &amp;
