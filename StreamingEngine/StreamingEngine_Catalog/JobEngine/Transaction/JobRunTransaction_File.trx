</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>LogSaver_MultiFileZIP</Name><Description> </Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_MultiFileZIP.LogModuleId</To><From>"StreamingEngine"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_MultiFileZIP.LogSeverity</To><From>"D"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_MultiFileZIP.LogUser</To><From>username</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_MultiFileZIP.LogTransactionName</To><From>transactionpath</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_MultiFileZIP.LogObjectId</To><From>Transaction.FlowID</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_MultiFileZIP.MessageTitle</To><From>"ZIPing Multiple Files"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_MultiFileZIP.MessageDescription</To><From>"ZIP command:" &amp; lf &amp;
"StdOut: " &amp; ZIPFiles.StdOutputStr &amp; lf &amp;
"StdErr:" &amp; ZIPFiles.ErrOutputStr</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_MultiFileZIP.LogActionBlockName</To><From>"ZIPFiles"</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>ZIPFiles</Name><Description>Simple Process Run</Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>ZIPFiles.DirPath</To><From>Transaction.MIIDataServer</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>ZIPFiles.Process</To><From>"bash"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>ZIPFiles.Args1</To><From>"-c"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>ZIPFiles.Args2</To><From>"cat /tmp/SE-" &amp; Local.QueueID &amp; ".txt | zip -j \"/tmp/" &amp; Transaction.FlowID &amp; "(" &amp; dateformat(Local.DateNow, dateformat, "yyyy-MM-dd HH-mm-ss")  &amp; ").zip\"   -@; rm " &amp;  "/tmp/SE-" &amp; Local.QueueID &amp; ".txt"</From></Assign></IncomingLinks><OutgoingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Local.FileName</To><From>"/tmp/" &amp; Transaction.FlowID &amp; "(" &amp; dateformat(Local.DateNow, dateformat, "yyyy-MM-dd HH-mm-ss")  &amp; ").zip"</From></Assign></OutgoingLinks></Action></Actions></Step></Steps><Actions><Action><Name>Write_File_ZipFileList</Name><Description> delete zip file and move files tpo processed</Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Write_File_ZipFileList.Path</To><From>"/tmp/SE-" &amp; Local.QueueID &amp; ".txt"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Write_File_ZipFileList.Text</To><From>Local.FileList
</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>ConditionalZip</Name><Description> </Description><Expiration>Sequence_16</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>ConditionalZip.Input1</To><From>Transaction.CompressedFlag</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step><Step xsi:type="ActionSequence"><Name>SFTP_BATCH</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_48</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_32</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_50</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_13</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_34</Name><Description/><Steps><Step xsi:type="Conditional"><Name>Sequence_26</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_43</Name><Description/><Steps/><Actions><Action><Name>JobSuccessUpdateQuery_2</Name><Description>SQL Query</Description><Expiration>Sequence_33</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>JobSuccessUpdateQuery_2.Param.1</To><From>Transaction.JobID</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobSuccessUpdateQuery_2.Param.2</To><From>Local.QueryStartDate</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobSuccessUpdateQuery_2.Param.3</To><From>Local.QueryEndDate</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobSuccessUpdateQuery_2.Param.4</To><From>datenow</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobSuccessUpdateQuery_2.Param.6</To><From>datediff(Local.DateNow, datenow)</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobSuccessUpdateQuery_2.Param.5</To><From>0</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobSuccessUpdateQuery_2.Param.7</To><From>Local.ResponseSuccessMsg</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobSuccessUpdateQuery_2.Param.8</To><From>Transaction.RunDurationInMins</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobSuccessUpdateQuery_2.Param.9</To><From>Transaction.FlowMaxFileSize</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobSuccessUpdateQuery_2.Param.10</To><From>stringif(Local.CatchUpFlag, (Local.MessageSize/Transaction.RunCatchUpMins)*Transaction.RunDurationInMins, Local.MessageSize)</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step><Step xsi:type="ActionSequence"><Name>Sequence_33</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_28</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_58</Name><Description/><Steps/><Actions><Action><Name>LogSaver_MultiFileMoveFailed</Name><Description> </Description><Expiration>Sequence_39</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_MultiFileMoveFailed.LogModuleId</To><From>"StreamingEngine"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_MultiFileMoveFailed.LogSeverity</To><From>"E"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_MultiFileMoveFailed.LogUser</To><From>username</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_MultiFileMoveFailed.LogTransactionName</To><From>transactionpath</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_MultiFileMoveFailed.LogObjectId</To><From>Transaction.FlowID</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_MultiFileMoveFailed.MessageTitle</To><From>"Failed to move processed files to sent" </From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_MultiFileMoveFailed.MessageDescription</To><From>"StdOut: " &amp; MoveFilesToSent.StdOutputStr &amp; lf &amp;
"StdErr: " &amp; MoveFilesToSent.ErrOutputStr</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions/></Step></Steps><Actions><Action><Name>JobFailUpdateQuery_3</Name><Description>SQL Query</Description><Expiration>Sequence_28</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>JobFailUpdateQuery_3.Param.1</To><From>Transaction.JobID</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobFailUpdateQuery_3.Param.2</To><From>datenow</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>JobFailUpdateQuery_3.Param.3</To><From>"Failed to move processed files to sent" &amp; lf &amp; 
"StdOut: " &amp; MoveFilesToSent.StdOutputStr &amp; lf &amp;
"StdErr: " &amp; MoveFilesToSent.ErrOutputStr</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>Conditional_SuccessfulMove</Name><Description> </Description><Expiration>Sequence_43</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Conditional_SuccessfulMove.Input1</To><From>(MoveFilesToSent.StdOutputStr == "") and (MoveFilesToSent.ErrOutputStr == "")</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>MoveFilesToSent</Name><Description>Simple Process Run</Description><Expiration>Sequence_39</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>MoveFilesToSent.DirPath</To><From>Transaction.MIIDataServer</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>MoveFilesToSent.Process</To><From>"bash"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>MoveFilesToSent.Args1</To><From>"-c"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>MoveFilesToSent.Args2</To><From>stringif(Transaction.CompressedFlag, "rm \"/tmp/" &amp; Transaction.FlowID &amp; "(" &amp; dateformat(Local.DateNow, dateformat, "yyyy-MM-dd HH-mm-ss")  &amp; ").zip\"", "") &amp; lf &amp;
"for f in `cat \"" &amp; "/tmp/SE-" &amp; Local.QueueID &amp; ".txt" &amp; "\"`" &amp; lf &amp;
"do" &amp; lf &amp;
"mv $f -t Processed" &amp; lf &amp;
"done" &amp; lf &amp;
"rm \"" &amp; "/tmp/SE-" &amp; Local.QueueID &amp; ".txt" &amp; "\""
