  &lt;xsl:output indent="yes" method="xml"/&gt;&#13;
  &lt;xsl:strip-space elements="*"/&gt;&#13;
  &lt;xsl:template match="/"&gt;&#13;
    &lt;Rowsets DateCreated="" EndDate="" StartDate="" Version="15.3 SP1 Patch 8 (Apr 28, 2020)"&gt;&#13;
      &lt;xsl:for-each select="/Rowsets/Rowset[2]/Row"&gt;&#13;
        &lt;Rowset&gt;&#13;
          &lt;Columns&gt;&#13;
            &lt;Column Description="" MaxRange="255" MinRange="0" Name="DateTime" SQLDataType="1" SourceColumn="DateTime"/&gt;&#13;
            &lt;Column Description="" MaxRange="255" MinRange="0" Name="{LOCATION_HIERARCHY}" SQLDataType="1" SourceColumn="{LOCATION_HIERARCHY}"/&gt;&#13;
          &lt;/Columns&gt;  &#13;
          &lt;xsl:variable name="CIRCUIT" select="./CIRCUIT_ID"/&gt;&#13;
          &lt;xsl:variable name="LOC" select="./LOCATION_HIERARCHY"/&gt;&#13;
            &lt;xsl:for-each select="/Rowsets/Rowset[1]/Row[CIRCUIT_ID=$CIRCUIT]"&gt;&#13;
              &lt;xsl:element name="Row"&gt;&#13;
                &lt;DateTime&gt;&lt;xsl:value-of select="./TIMESTAMP"/&gt;&lt;/DateTime&gt;&#13;
                &lt;xsl:element name="{$LOC}"&gt;&#13;
                  &lt;xsl:value-of select="./VALUE"/&gt;&#13;
                &lt;/xsl:element&gt;&#13;
              &lt;/xsl:element&gt;&#13;
            &lt;/xsl:for-each&gt;&#13;
        &lt;/Rowset&gt;&#13;
      &lt;/xsl:for-each&gt;&#13;
    &lt;/Rowsets&gt;&#13;
  &lt;/xsl:template&gt;&#13;
