)</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>Row_Update</Name><Description> </Description><Expiration>Sequence_29</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Row_Update.EQUIPMENT_ID</To><From>Repeater_Equipment.Output{/Row/EQUIPMENT_ID}</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Row_Update.EQUIPMENT_PATH</To><From>Repeater_Equipment.Output{/Row/EQUIPMENT_PATH}</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Row_Update.EQUIPMENT_NAME</To><From>Repeater_Equipment.Output{/Row/EQUIPMENT_NAME}</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Row_Update.EQUIPMENT_LEVEL</To><From>Repeater_Equipment.Output{/Row/EQUIPMENT_LEVEL}</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Row_Update.STATUS</To><From>"S"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Row_Update.DS_MESSAGE</To><From>"Updated"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Row_Update.PLANT</To><From>Repeater_Equipment.Output{/Row/EQUIPMENT_PLANT}</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>BatchCatalogDownloadUpdateQuery</Name><Description>SQL Query</Description><Expiration>Sequence_6</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>BatchCatalogDownloadUpdateQuery.Param.1</To><From>BatchCatalogSelectQuery.Results{/Rowsets/Rowset/Row/ID_BATCH_CATALOG}</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>BatchCatalogDownloadUpdateQuery.Param.2</To><From>Repeater_Equipment.Output{/Row/EQUIPMENT_NAME}</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>BatchCatalogDownloadUpdateQuery.Param.3</To><From>Repeater_Equipment.Output{/Row/EQUIPMENT_PATH}</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>BatchCatalogDownloadUpdateQuery.Param.4</To><From>Repeater_Equipment.Output{/Row/EQUIPMENT_LEVEL}</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>BatchCatalogDownloadUpdateQuery.Param.5</To><From>datenow</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>Conditional_EquipmentNotExist</Name><Description> </Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Conditional_EquipmentNotExist.Input1</To><From>BatchCatalogSelectQuery.Results{count(/Rowsets/Rowset/Row)} &lt;= 0</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>BatchCatalogSelectQuery</Name><Description>SQL Query</Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>BatchCatalogSelectQuery.Param.1</To><From>Transaction.SourceID</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>BatchCatalogSelectQuery.Param.2</To><From>Repeater_Equipment.Output{/Row/EQUIPMENT_ID} &amp; "_" &amp; stringif(Repeater_Equipment.Output{/Row/EQUIPMENT_PLANT} == "ENOX", 1, 5)</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>Throw_DuplicateName</Name><Description>Throws an exception</Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Throw_DuplicateName.Enable</To><From>Advanced_Flat_File_Parser.OutputXML{count(/Rowsets/Rowset/Row[EQUIPMENT_NAME='#Repeater_Equipment.Output{/Row/EQUIPMENT_NAME}#' and EQUIPMENT_PATH='#Repeater_Equipment.Output{/Row/EQUIPMENT_PATH}#'])} != 
Advanced_Flat_File_Parser.OutputXML{count(/Rowsets/Rowset/Row[EQUIPMENT_NAME='#Repeater_Equipment.Output{/Row/EQUIPMENT_NAME}#' and EQUIPMENT_PATH='#Repeater_Equipment.Output{/Row/EQUIPMENT_PATH}#'  and EQUIPMENT_PLANT='#Repeater_Equipment.Output{/Row/EQUIPMENT_PLANT}#'])}</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Throw_DuplicateName.Message</To><From>"EQUIPMENT_NAME and EQUIPMENT_PATH can not be shared between different plants, please update (you can use EQUIPMENT_PATH '/" &amp; Repeater_Equipment.Output{/Row/EQUIPMENT_PLANT} &amp; "/') and retry'"</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>Throw_DuplicateID</Name><Description>Throws an exception</Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Throw_DuplicateID.Enable</To><From>Advanced_Flat_File_Parser.OutputXML{count(/Rowsets/Rowset/Row[EQUIPMENT_ID='#Repeater_Equipment.Output{/Row/EQUIPMENT_ID}#' and EQUIPMENT_PLANT='#Repeater_Equipment.Output{/Row/EQUIPMENT_PLANT}#'])} != 1</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Throw_DuplicateID.Message</To><From>"EQUIPMENT_ID and EQUIPMENT_PLANT must be unique'"</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>Throw_Plant</Name><Description>Throws an exception</Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Throw_Plant.Enable</To><From>(Repeater_Equipment.Output{/Row/EQUIPMENT_PLANT} != "SCP") and
