<?xml version="1.0" encoding="UTF-8" standalone="no"?><SQLQuery AllowBuffering="false" AllowFuture="true" AllowNullValues="false" AutoCommit="false" AutoTypeParameters="false" CacheDuration="0" CacheDurationUnits="M" Columns="" Comment="" Connector="" DateColumn="" DateFormat="MM/dd/yyyy HH:mm:ss" Debug="false" Description="" DocType="SQLQuery" Duration="60" DurationUnits="M" EndDate="" FilterExpr="" FixedQuery="" GroupingExpr="" HanaDataSource="true" ID="2783" InlineTransform="" IntervalCount="1" IsCachable="false" JoinExpr="" Mask="" Method="" Mode="FixedQuery" NumberFormat="0.00" Param.1="" Param.10="" Param.11="" Param.12="" Param.13="" Param.14="" Param.15="" Param.16="" Param.17="" Param.18="" Param.19="" Param.2="" Param.20="*" Param.21="" Param.22="" Param.23="" Param.24="" Param.25="" Param.26="" Param.27="" Param.28="" Param.29="" Param.3="" Param.30="" Param.31="" Param.32="" Param.4="" Param.5="" Param.6="" Param.7="" Param.8="" Param.9="" ParamDescription.1="" ParamDescription.10="" ParamDescription.11="" ParamDescription.12="" ParamDescription.13="" ParamDescription.14="" ParamDescription.15="" ParamDescription.16="" ParamDescription.17="" ParamDescription.18="" ParamDescription.19="" ParamDescription.2="" ParamDescription.20="" ParamDescription.21="" ParamDescription.22="" ParamDescription.23="" ParamDescription.24="" ParamDescription.25="" ParamDescription.26="" ParamDescription.27="" ParamDescription.28="" ParamDescription.29="" ParamDescription.3="" ParamDescription.30="" ParamDescription.31="" ParamDescription.32="" ParamDescription.4="" ParamDescription.5="" ParamDescription.6="" ParamDescription.7="" ParamDescription.8="" ParamDescription.9="" ParamType.1="" ParamType.10="" ParamType.11="" ParamType.12="" ParamType.13="" ParamType.14="" ParamType.15="" ParamType.16="" ParamType.17="" ParamType.18="" ParamType.19="" ParamType.2="" ParamType.20="" ParamType.21="" ParamType.22="" ParamType.23="" ParamType.24="" ParamType.25="" ParamType.26="" ParamType.27="" ParamType.28="" ParamType.29="" ParamType.3="" ParamType.30="" ParamType.31="" ParamType.32="" ParamType.4="" ParamType.5="" ParamType.6="" ParamType.7="" ParamType.8="" ParamType.9="" Password="" PathID="808" Query="SELECT&#10;    P.DS_NAME AS PLANT,&#10;    S.DS_NAME AS SOURCE,&#10;    B.DS_PATH AS EQUIPMENT_PATH,&#10;    B.DS_NAME AS EQUIPMENT_NAME,&#10;    (CASE WHEN B.ID_PLANT_HIERARCHY IS NOT NULL THEN &#10;&#9;(CASE WHEN l1.ID_PLANT_HIERARCHY IS NOT NULL THEN l1.DS_NAME || l2.DS_NAME || '-' || l3.DS_NAME || '-' || l4.DS_NAME || '-' || l5.DS_NAME&#10;          WHEN l2.ID_PLANT_HIERARCHY IS NOT NULL THEN l2.DS_NAME || l3.DS_NAME || '-' || l4.DS_NAME || '-' || l5.DS_NAME&#10;&#9;ELSE &#10;&#9;&#9;l3.DS_NAME || l4.DS_NAME || '-' || l5.DS_NAME&#10;&#9;END)&#10;    ELSE NULL END) AS PLANT_HIERARCHY&#10;FROM &#10;    SE.SE_BATCH_CATALOG B&#10;    INNER JOIN SE.SE_SOURCE S ON S.ID_SOURCE = B.ID_SOURCE&#10;    INNER JOIN SE.SE_PLANT P ON S.ID_PLANT = P.ID_PLANT&#10;    LEFT OUTER JOIN SE.SE_PLANT_HIERARCHY l5 ON l5.ID_PLANT_HIERARCHY = B.ID_PLANT_HIERARCHY&#10;    LEFT OUTER JOIN SE.SE_PLANT_HIERARCHY l4 ON l5.ID_PARENT = l4.ID_PLANT_HIERARCHY &#10;    LEFT OUTER JOIN SE.SE_PLANT_HIERARCHY l3 ON l4.ID_PARENT = l3.ID_PLANT_HIERARCHY&#10;    LEFT OUTER JOIN SE.SE_PLANT_HIERARCHY l2 ON l3.ID_PARENT = l2.ID_PLANT_HIERARCHY&#10;    LEFT OUTER JOIN SE.SE_PLANT_HIERARCHY l1 ON l2.ID_PARENT = l1.ID_PLANT_HIERARCHY&#10;WHERE&#10;    [Param.1]&#10;    [Param.2]&#10;    [Param.3]&#10;    [Param.4]&#10;    [Param.5]&#10;    (B.ID_BATCH_CATALOG IN ([Param.6]) OR '[Param.7]' = 'ALL') AND&#10;    S.FL_ENABLED = 1 AND &#10;    S.ID_INITIAL_LOAD_PARENT IS NULL AND&#10;    (S.ID_PLANT IN (SELECT RESULT FROM SQLSCRIPT_STRING:SPLIT_TO_TABLE('[Param.20]',',')) OR '[Param.20]' = '*')&#10;ORDER BY&#10;    PLANT ASC,&#10;    SOURCE ASC,&#10;    EQUIPMENT_PATH ASC,&#10;    EQUIPMENT_NAME ASC" QueryParams="" ReaderRoles="SAP_XMII_User" RestrictedPropertyOverride="false" ResultSetMode="false" RowCount="5000" SaveDate="01/05/2026 17:58:14" Schedule="" SelectedColumns="" Server="Z_STREAMING_ENGINE" Service="" SetMaxRows="true" SortExpr="" StartDate="" Tables="" Time="" TimePeriod="" Trace="false" TransformerLibrary="" UseTypedParams="false" UserName="" Version="15.5.1.41" WriterRoles="SAP_XMII_Super_Administrator,SAP_XMII_Administrator,SAP_XMII_Developer" XParamName.1="" XParamName.10="" XParamName.11="" XParamName.12="" XParamName.13="" XParamName.14="" XParamName.15="" XParamName.16="" XParamName.2="" XParamName.3="" XParamName.4="" XParamName.5="" XParamName.6="" XParamName.7="" XParamName.8="" XParamName.9="" XParamValue.1="" XParamValue.10="" XParamValue.11="" XParamValue.12="" XParamValue.13="" XParamValue.14="" XParamValue.15="" XParamValue.16="" XParamValue.2="" XParamValue.3="" XParamValue.4="" XParamValue.5="" XParamValue.6="" XParamValue.7="" XParamValue.8="" XParamValue.9="" XmlDateFormat="yyyy-MM-dd'T'HH:mm:ss" XmlNumberFormat=""><Tasks/><ETCServers/><ETCObjects/></SQLQuery>