    SE.SE_USER_MAPPING_APP (ID_USERNAME, ID_DIGITAL_APP)
SELECT 
    U.ID_USERNAME, A.ID_DIGITAL_APP
FROM 
    SE.SE_USER_PROFILE U
CROSS JOIN 
    SE.SE_APP A
WHERE NOT EXISTS (
    SELECT 1
    FROM SE.SE_USER_MAPPING_APP M
    WHERE M.ID_USERNAME = U.ID_USERNAME
    AND M.ID_DIGITAL_APP = A.ID_DIGITAL_APP
)"</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step><Step xsi:type="Catch"><Name>ERROR_HANDLE_ALL</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_2</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>TERMINATE_ALL</Name><Description/><Steps/><Actions><Action><Name>Terminate_TransactionAll</Name><Description> </Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Terminate_TransactionAll.TerminationMessage</To><From>Catch_All.Message  &amp; " / " &amp; HTTP_Post.ReturnAsString</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>LogSaver</Name><Description> </Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver.LogModuleId</To><From>"StreamingEngine"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver.LogSeverity</To><From>"E"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver.LogUser</To><From>username</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver.LogTransactionName</To><From>transactionpath</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver.MessageTitle</To><From>"Digital app download transaction failed"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver.MessageDescription</To><From>"[" &amp; Catch_All.ExceptionType &amp; "] - " &amp; Catch_All.Message</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver.LogActionBlockName</To><From>Catch_All.Source</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>Catch_All</Name><Description>Catches an exception</Description><Expiration>TERMINATE_ALL</Expiration><IncomingLinks/><OutgoingLinks/></Action></Actions></Step></Steps><Actions/></Step></Steps></Transaction>