  &lt;xsl:output encoding="UTF-8" indent="yes" method="xml"/&gt;&#13;
&#13;
  &lt;xsl:template match="/"&gt;&#13;
    &lt;Items&gt;&#13;
      &lt;!-- Skip the header row --&gt;&#13;
      &lt;xsl:for-each select="/Rowsets/Rowset/Row[position() &amp;gt; 1]"&gt;&#13;
        &lt;xsl:variable name="cols" select="normalize-space(Item)"/&gt;&#13;
&#13;
        &lt;!-- Split progressively by commas --&gt;&#13;
        &lt;xsl:variable name="col1" select="substring-before($cols, ',')"/&gt;&#13;
        &lt;xsl:variable name="rest1" select="substring-after($cols, ',')"/&gt;&#13;
&#13;
        &lt;xsl:variable name="col2" select="substring-before($rest1, ',')"/&gt;&#13;
        &lt;xsl:variable name="rest2" select="substring-after($rest1, ',')"/&gt;&#13;
&#13;
        &lt;xsl:variable name="col3" select="substring-before($rest2, ',')"/&gt;&#13;
        &lt;xsl:variable name="rest3" select="substring-after($rest2, ',')"/&gt;&#13;
&#13;
        &lt;xsl:variable name="col4" select="substring-before($rest3, ',')"/&gt;&#13;
        &lt;xsl:variable name="rest4" select="substring-after($rest3, ',')"/&gt;&#13;
&#13;
        &lt;xsl:variable name="col5" select="substring-before($rest4, ',')"/&gt;&#13;
        &lt;xsl:variable name="rest5" select="substring-after($rest4, ',')"/&gt;&#13;
&#13;
        &lt;xsl:variable name="col6" select="substring-before($rest5, ',')"/&gt;&#13;
        &lt;xsl:variable name="rest6" select="substring-after($rest5, ',')"/&gt;&#13;
&#13;
        &lt;xsl:variable name="col7" select="substring-before($rest6, ',')"/&gt;&#13;
        &lt;xsl:variable name="rest7" select="substring-after($rest6, ',')"/&gt;&#13;
&#13;
        &lt;xsl:variable name="col8" select="substring-before($rest7, ',')"/&gt;&#13;
        &lt;xsl:variable name="rest8" select="substring-after($rest7, ',')"/&gt;&#13;
&#13;
        &lt;xsl:variable name="col9" select="substring-before($rest8, ',')"/&gt;&#13;
        &lt;xsl:variable name="rest9" select="substring-after($rest8, ',')"/&gt;&#13;
&#13;
        &lt;xsl:variable name="col10" select="substring-before($rest9, ',')"/&gt;&#13;
        &lt;xsl:variable name="rest10" select="substring-after($rest9, ',')"/&gt;&#13;
&#13;
        &lt;xsl:variable name="col11" select="substring-before($rest10, ',')"/&gt;&#13;
        &lt;xsl:variable name="rest11" select="substring-after($rest10, ',')"/&gt;&#13;
&#13;
        &lt;xsl:variable name="col12" select="substring-before($rest11, ',')"/&gt;&#13;
        &lt;xsl:variable name="rest12" select="substring-after($rest11, ',')"/&gt;&#13;
&#13;
        &lt;xsl:variable name="col13" select="substring-before($rest12, ',')"/&gt;&#13;
        &lt;xsl:variable name="rest13" select="substring-after($rest12, ',')"/&gt;&#13;
&#13;
        &lt;xsl:variable name="col14" select="normalize-space($rest13)"/&gt;&#13;
&#13;
        &lt;Tags&gt;&#13;
          &lt;CppKpp&gt;&lt;xsl:value-of select="normalize-space($col8)"/&gt;&lt;/CppKpp&gt;&#13;
          &lt;Domain&gt;&lt;xsl:value-of select="normalize-space($col1)"/&gt;&lt;/Domain&gt;&#13;
          &lt;Format&gt;&lt;xsl:value-of select="normalize-space($col4)"/&gt;&lt;/Format&gt;&#13;
          &lt;Frequency&gt;&lt;xsl:value-of select="normalize-space($col7)"/&gt;&lt;/Frequency&gt;&#13;
          &lt;Length&gt;&lt;xsl:value-of select="normalize-space($col5)"/&gt;&lt;/Length&gt;&#13;
          &lt;MainFunction&gt;&lt;xsl:value-of select="normalize-space($col3)"/&gt;&lt;/MainFunction&gt;&#13;
          &lt;Mea&gt;&lt;xsl:value-of select="normalize-space($col11)"/&gt;&lt;/Mea&gt;&#13;
          &lt;PK/&gt;&#13;
          &lt;Sub&gt;&lt;xsl:value-of select="normalize-space($col10)"/&gt;&lt;/Sub&gt;&#13;
          &lt;Sys&gt;&lt;xsl:value-of select="normalize-space($col9)"/&gt;&lt;/Sys&gt;&#13;
          &lt;SysSub&gt;&lt;xsl:value-of select="normalize-space($col14)"/&gt;&lt;/SysSub&gt;&#13;
          &lt;TagDesc&gt;&lt;xsl:value-of select="normalize-space($col2)"/&gt;&lt;/TagDesc&gt;&#13;
          &lt;TagName&gt;&lt;xsl:value-of select="normalize-space($col9)"/&gt;&lt;/TagName&gt;&#13;
          &lt;Typ&gt;&lt;xsl:value-of select="normalize-space($col12)"/&gt;&lt;/Typ&gt;&#13;
          &lt;UoM&gt;&lt;xsl:value-of select="normalize-space($col5)"/&gt;&lt;/UoM&gt;&#13;
        &lt;/Tags&gt;&#13;
      &lt;/xsl:for-each&gt;&#13;
    &lt;/Items&gt;&#13;
  &lt;/xsl:template&gt;&#13;
&lt;/xsl:stylesheet&gt;</Value><SchemaURI/><SchemaElement/><ValidateXMLOnExecution>1</ValidateXMLOnExecution><ReadOnly>false</ReadOnly><AlertXMLAssigned>false</AlertXMLAssigned></ContextItem><ContextItem><Name>XSLUoM</Name><Description/><MinRange>0</MinRange><MaxRange>0</MaxRange><Value xsi:type="xml"><ReferenceDocumentSource/>&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" version="1.0"&gt;&#13;
&lt;xsl:output encoding="UTF-8" indent="yes" method="xml"/&gt;&#13;
 &#13;
  &lt;xsl:template match="/"&gt;&#13;
&#13;
&lt;Items&gt;&#13;
&lt;xsl:for-each select="/Rowsets/Rowset/Row[position() &amp;gt; 1]"&gt;&#13;
&lt;Units&gt;&#13;
&lt;Name&gt;&lt;xsl:value-of select="normalize-space(substring-before(Item, ','))"/&gt;&lt;/Name&gt;&#13;
&lt;Code&gt;&lt;xsl:value-of select="normalize-space(substring-after(Item, ','))"/&gt;&lt;/Code&gt;&#13;
&lt;/Units&gt;&#13;
&lt;/xsl:for-each&gt;&#13;
&#13;
&lt;/Items&gt;&#13;
&lt;/xsl:template&gt;&#13;
