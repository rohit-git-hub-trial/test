s/Rowset/Row/AGENT_COUNTER}&gt;0</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Local.EquipmentsConfigured</To><From>SourceSelectQuery.Results{/Rowsets/Rowset/Row/EQUIPMENTS_CONFIGURED}</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Local.TagsConfigured</To><From>SourceSelectQuery.Results{/Rowsets/Rowset/Row/TAGS_CONFIGURED}</From></Assign></OutgoingLinks></Action></Actions></Step><Step xsi:type="Conditional"><Name>Sequence_44</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_31</Name><Description/><Steps/><Actions><Action><Name>TerminateTransactionFlowInUse</Name><Description> </Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>TerminateTransactionFlowInUse.TerminationMessage</To><From>"Unable to update Data Source - Flat file cannot be deactivated while data source is in use by " &amp; SourceSelectQuery.Results{/Rowsets/Rowset/Row/QT_FLOW_USING_FILE}  &amp; " file flow(s)"</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>ConditionalFileFlowInUse_0</Name><Description> </Description><Expiration>Sequence_31</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>ConditionalFileFlowInUse_0.Input1</To><From>((Transaction.Action == "UPDATE") &amp;&amp; (Transaction.FL_FLAT_FILE == 0))</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>ConditionalFileFlowInUse_0.Input2</To><From>SourceSelectQuery.Results{/Rowsets/Rowset/Row/QT_FLOW_USING_FILE} &gt; 0</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step><Step xsi:type="Conditional"><Name>Sequence_63</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_64</Name><Description/><Steps/><Actions><Action><Name>Terminate_Transaction_FlowsInUse</Name><Description> </Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Terminate_Transaction_FlowsInUse.TerminationMessage</To><From>"Cannot delete the data source - It is currently used by : " &amp; "\n"  &amp;  stringif(Local.ArchiveFlowInUse == 1, SourceSelectQuery.Results{/Rowsets/Rowset/Row/QT_FLOW_USING_ARCHIVE} &amp; " archive flow(s)" &amp; "\n", "")  &amp; stringif(Local.ContextualFlowInUse == 1, SourceSelectQuery.Results{/Rowsets/Rowset/Row/QT_FLOW_USING_CONTEXTUAL} &amp; " contextual flow(s)" &amp; "\n", "")  &amp; stringif(Local.FileFlowInUse, SourceSelectQuery.Results{/Rowsets/Rowset/Row/QT_FLOW_USING_FILE} &amp; " file flow(s)" &amp; "\n", "")  &amp; stringif(Local.ExternalFlowInUse, SourceSelectQuery.Results{/Rowsets/Rowset/Row/QT_FLOW_USING_EXTERNAL} &amp; " external flow(s)" &amp; "\n", "")   &amp; 
stringif(Local.RealTimeFlowInUse, SourceSelectQuery.Results{/Rowsets/Rowset/Row/AGENT_COUNTER} &amp; " realtime agent(s)" &amp; "\n", "") &amp;  stringif(Local.TagsConfigured &gt; 0, SourceSelectQuery.Results{/Rowsets/Rowset/Row/TAGS_CONFIGURED} &amp; " Tag(s) configured" &amp; "\n", "") &amp;  stringif(Local.EquipmentsConfigured &gt; 0, SourceSelectQuery.Results{/Rowsets/Rowset/Row/EQUIPMENTS_CONFIGURED} &amp; " Equipment(s) configured" &amp; "\n", "") 

</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>Conditional_DeleteFLowsInUse</Name><Description> </Description><Expiration>Sequence_64</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Conditional_DeleteFLowsInUse.Input1</To><From>Transaction.Action == "DELETE"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Conditional_DeleteFLowsInUse.Input2</To><From>Local.FileFlowInUse || Local.ExternalFlowInUse || Local.ContextualFlowInUse || Local.ArchiveFlowInUse || Local.RealTimeFlowInUse || (Local.TagsConfigured&gt;0) || (Local.EquipmentsConfigured&gt;0)</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step><Step xsi:type="Conditional"><Name>Sequence_29</Name><Description/><Steps><Step xsi:type="Conditional"><Name>Sequence_0</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_10</Name><Description/><Steps/><Actions><Action><Name>Terminate_Transaction_Tag</Name><Description> </Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Terminate_Transaction_Tag.TerminationMessage</To><From>"There are Tags already downloaded for the current Data Server. Data Server update is not allowed."</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>Conditional_Tag</Name><Description> </Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Conditional_Tag.Input1</To><From>SourceSelectQuery.Results{/Rowsets/Rowset/Row/TAG_COUNTER}&gt;0</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Conditional_Tag.Input2</To><From>Transaction.DS_MII_DATA_SERVER_PROCESS!=SourceSelectQuery.Results{/Rowsets/Rowset/Row/DS_MII_DATA_SERVER_PROCESS}</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>IGNORE_2</Name><Description> </Description><Expiration>Sequence_0</Expiration><IncomingLinks/><OutgoingLinks/></Action></Actions></Step><Step xsi:type="Conditional"><Name>Sequence_8</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_13</Name><Description/><Steps/><Actions><Action><Name>Terminate_Transaction_Agent</Name><Description> </Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Terminate_Transaction_Agent.TerminationMessage</To><From>"There are Agents already downloaded for the current Data Source. PCo Agent Prefix update is not allowed."</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>Conditional_Agent</Name><Description> </Description><Expiration>Sequence_14</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Conditional_Agent.Input1</To><From>SourceSelectQuery.Results{/Rowsets/Rowset/Row/AGENT_COUNTER}&gt;0</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Conditional_Agent.Input2</To><From>Transaction.DS_PCO_AGENT_PREFIX!=SourceSelectQuery.Results{/Rowsets/Rowset/Row/DS_PCO_AGENT_PREFIX}</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step><Step xsi:type="Conditional"><Name>Sequence_24</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_22</Name><Description/><Steps/><Actions><Action><Name>Terminate_Transaction_InitialLoad</Name><Description> </Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Terminate_Transaction_InitialLoad.TerminationMessage</To><From>"Unable to update Data Source while Initial Data Load is enabled"</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>Conditional_SE_InitialLoad</Name><Description> </Description><Expiration>Sequence_22</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Conditional_SE_InitialLoad.Input1</To><From>SourceSelectQuery.Results{/Rowsets/Rowset/Row/INITIAL_LOAD_COUNT} &gt; 0</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step><Step xsi:type="Conditional"><Name>CHECK_REMOVED_CHANNELS</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_32</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_41</Name><Description/><Steps><Step xsi:type="Repeater"><Name>GET_REMOVED_CHANNELS</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_37</Name><Description/><Steps/><Actions><Action><Name>String_To_XML_Parser_0</Name><Description> match2 will make sure the channel exists in the new list by testing if it is at the start of the list follwed by a comma, or in the middle surrounded by two commas, or at the end preceded by a comma, or it is equal the entire string.

the stringreplaceall will make sure the regex special characters are escaped to avoid unexpected results.

the listtostring and stringtolist are used to trim white space characters</Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>String_To_XML_Parser_0.Input</To><From>stringif(
    match2(
        listtostring(stringtolist(Transaction.DS_KEPWARE_CHANNELS, ","), ","),
        "(^"&amp;stringreplaceall(Repeater_Kepware_Channels.Output{/Row/Item}, "[.*+?^${}()|\\[\\]\\\\]", "\\\\$0")&amp;",)|"&amp;
        "(,"&amp;stringreplaceall(Repeater_Kepware_Channels.Output{/Row/Item}, "[.*+?^${}()|\\[\\]\\\\]", "\\\\$0")&amp;",)|"&amp;
        "(,"&amp;stringreplaceall(Repeater_Kepware_Channels.Output{/Row/Item}, "[.*+?^${}()|\\[\\]\\\\]", "\\\\$0")&amp;"$)|"&amp;
        "(^"&amp;stringreplaceall(Repeater_Kepware_Channels.Output{/Row/Item}, "[.*+?^${}()|\\[\\]\\\\]", "\\\\$0")&amp;"$)",
        true),
    "",
