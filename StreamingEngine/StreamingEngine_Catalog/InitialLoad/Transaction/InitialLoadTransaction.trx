tion/><To>InitialLoadJobDeletedFlagUpdateQuery.Param.1</To><From>Local.ID_DATA_FLOW</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step><Step xsi:type="ActionSequence"><Name>CLEAN_UP</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_16</Name><Description/><Steps/><Actions><Action><Name>InitialLoadSourceDeleteQuery</Name><Description>SQL Query</Description><Expiration>Email Notification when historical upload is launched</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>InitialLoadSourceDeleteQuery.Param.1</To><From>Local.ID_SOURCE</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>InitialLoadDataFlowDeleteQuery</Name><Description>SQL Query</Description><Expiration>Sequence_16</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>InitialLoadDataFlowDeleteQuery.Param.1</To><From>Local.ID_DATA_FLOW</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>Conditional_TagsInserted</Name><Description> </Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Conditional_TagsInserted.Input1</To><From>Local.TagsInserted&gt;0</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step><Step xsi:type="ActionSequence"><Name>Email Notification when historical upload is launched</Name><Description>Email Notification when historical upload is launched</Description><Steps><Step xsi:type="ActionSequence"><Name>Sequence_46</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_45</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_92</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_49</Name><Description/><Steps/><Actions><Action><Name>LogSaver_5</Name><Description> </Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_5.LogModuleId</To><From>"StreamingEngine"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_5.LogSeverity</To><From>"D"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_5.LogUser</To><From>username</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_5.LogTransactionName</To><From>transactionpath</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_5.MessageTitle</To><From>"Email Notification Send for Historical Upload Launch"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_5.MessageDescription</To><From>"Email Notification Send for Historical Upload Launch - Archive Flow | Email Sender : " &amp;
SendEmailAlertTransaction_0.ToAddress &amp; " | " &amp;

"Historical upload has been created by a user/system. Details below : " &amp; " | " &amp;

"Plant : " &amp; HistoricalUploadFlowDetailsSelectQuery_0.Results{/Rowsets/Rowset/Row/PLANT} &amp; " | " &amp;

"Server URL : " &amp; Persistent.ServerBaseURL &amp; " | " &amp;

"Data Source : " &amp; HistoricalUploadFlowDetailsSelectQuery_0.Results{/Rowsets/Rowset/Row/SOURCE_NAME} &amp; " | " &amp;

"Data Flow : " &amp; HistoricalUploadFlowDetailsSelectQuery_0.Results{/Rowsets/Rowset/Row/FLOW_NAME} &amp; " | " &amp;

"Flow Type : ARCHIVE | " &amp;

"Historical Upload Start Date : " &amp; Transaction.StartDate &amp; " " &amp; Local.TimeZone &amp; " | " &amp;

"Historical Upload End Date : " &amp; Transaction.EndDate &amp; " " &amp; Local.TimeZone &amp; " | " &amp;

"Start Timestamp : " &amp; Local.Datenow &amp; " " &amp; Local.TimeZone &amp; " | " &amp;

"Triggered By (User/System) : " &amp; username &amp; " | " &amp;

"Tag List : " &amp; Local.TagList </From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>SendEmailAlertTransaction_0</Name><Description> </Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>SendEmailAlertTransaction_0.ToAddress</To><From>Persistent.HistoricalUploadAlertEmailDL</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>SendEmailAlertTransaction_0.Subject</To><From>"[Streaming Engine Alert] Historical Upload Launch Notification - Archive Flow"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>SendEmailAlertTransaction_0.FromAddress</To><From>Persistent.SenderName</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>SendEmailAlertTransaction_0.EmailBody</To><From>Local.EmailBody</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>Assignment_Email</Name><Description> </Description><Expiration/><IncomingLinks/><OutgoingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Local.TimeZone</To><From>"UTC" &amp; stringif(currenttimezoneoffset &gt; 0,"+","") &amp; (currenttimezoneoffset/3600000) &amp; " H "  &amp; currenttimezone</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Local.Datenow</To><From>datefromxmlformat(datenow, "MM/dd/yyyy HH:mm:ss")</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Local.EmailBody</To><From>"&lt;html&gt;
&lt;head&gt;
    &lt;style&gt;
        body {
            font-family: Arial, sans-serif;
            font-size: 14px;
            color: #333;
        }
        table {
            border-collapse: collapse;
            width: 60%;
        }
        th {
            text-align: left;
            background-color: #f2f2f2;
            padding: 8px;
            border: 1px solid #ccc;
            width: 40%;
        }
        td {
            padding: 8px;
            border: 1px solid #ccc;
        }
    &lt;/style&gt;
&lt;/head&gt;
&lt;body&gt;


&lt;p style='font-size:16px; font-weight:bold;'&gt;
Historical upload has been created by a user/system. Please find the details below:&lt;/p&gt;

&lt;table&gt;
    &lt;tr&gt;
        &lt;th&gt;Plant&lt;/th&gt;
        &lt;td&gt;"&amp;HistoricalUploadFlowDetailsSelectQuery_0.Results{/Rowsets/Rowset/Row/PLANT}&amp;"&lt;/td&gt;
    &lt;/tr&gt;
    &lt;tr&gt;
        &lt;th&gt;Server URL&lt;/th&gt;
        &lt;td&gt;"&amp;Persistent.ServerBaseURL&amp;"&lt;/td&gt;
    &lt;/tr&gt;
    &lt;tr&gt;
        &lt;th&gt;Data Source&lt;/th&gt;
        &lt;td&gt;"&amp;HistoricalUploadFlowDetailsSelectQuery_0.Results{/Rowsets/Rowset/Row/SOURCE_NAME}&amp;"&lt;/td&gt;
    &lt;/tr&gt;
    &lt;tr&gt;
        &lt;th&gt;Data Flow&lt;/th&gt;
        &lt;td&gt;"&amp;HistoricalUploadFlowDetailsSelectQuery_0.Results{/Rowsets/Rowset/Row/FLOW_NAME}&amp;"&lt;/td&gt;
    &lt;/tr&gt;
    &lt;tr&gt;
        &lt;th&gt;Flow Type&lt;/th&gt;
        &lt;td&gt;"&amp;"ARCHIVE"&amp;"&lt;/td&gt;
    &lt;/tr&gt;
    &lt;tr&gt;
        &lt;th&gt;Historical Upload Start Date&lt;/th&gt;
        &lt;td&gt;"&amp;Transaction.StartDate&amp; " " &amp;Local.TimeZone  &amp;"&lt;/td&gt;
    &lt;/tr&gt;
    &lt;tr&gt;
        &lt;th&gt;Historical Upload End Date&lt;/th&gt;
        &lt;td&gt;"&amp;Transaction.EndDate&amp; " " &amp;Local.TimeZone  &amp;"&lt;/td&gt;
    &lt;/tr&gt;
    &lt;tr&gt;
        &lt;th&gt;Start Timestamp&lt;/th&gt;
        &lt;td&gt;"&amp;Local.Datenow
&amp; " " &amp;Local.TimeZone  &amp;"&lt;/td&gt;
    &lt;/tr&gt;
    &lt;tr&gt;
        &lt;th&gt;Triggered By (User/System)&lt;/th&gt;
        &lt;td&gt;"&amp;username&amp;"&lt;/td&gt;
    &lt;/tr&gt;
    &lt;tr&gt;
        &lt;th&gt;Tag List&lt;/th&gt;
        &lt;td&gt;"&amp;Local.TagList&amp;"&lt;/td&gt;
    &lt;/tr&gt;
&lt;/table&gt;

&lt;p&gt;This is an automated message. Please do not reply.&lt;/p&gt;

