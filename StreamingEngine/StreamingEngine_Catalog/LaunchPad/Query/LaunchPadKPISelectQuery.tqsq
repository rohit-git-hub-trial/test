<?xml version="1.0" encoding="UTF-8" standalone="no"?><SQLQuery AllowBuffering="false" AllowFuture="true" AllowNullValues="true" AutoCommit="false" AutoTypeParameters="false" CacheDuration="0" CacheDurationUnits="M" Columns="" Comment="" Connector="" DateColumn="" DateFormat="MM/dd/yyyy HH:mm:ss" Debug="false" Description="" DocType="SQLQuery" Duration="24" DurationUnits="H" EndDate="" FilterExpr="" FixedQuery="" GroupingExpr="" HanaDataSource="true" ID="3121" InlineTransform="" IntervalCount="1" IsCachable="false" JoinExpr="" Mask="" Method="" Mode="FixedQuery" NumberFormat="0.00" Param.1="" Param.10="" Param.11="" Param.12="" Param.13="" Param.14="" Param.15="" Param.16="" Param.17="" Param.18="" Param.19="" Param.2="" Param.20="" Param.21="" Param.22="" Param.23="" Param.24="" Param.25="" Param.26="" Param.27="" Param.28="" Param.29="" Param.3="" Param.30="" Param.31="" Param.32="" Param.4="" Param.5="" Param.6="" Param.7="" Param.8="" Param.9="" ParamDescription.1="" ParamDescription.10="" ParamDescription.11="" ParamDescription.12="" ParamDescription.13="" ParamDescription.14="" ParamDescription.15="" ParamDescription.16="" ParamDescription.17="" ParamDescription.18="" ParamDescription.19="" ParamDescription.2="" ParamDescription.20="" ParamDescription.21="" ParamDescription.22="" ParamDescription.23="" ParamDescription.24="" ParamDescription.25="" ParamDescription.26="" ParamDescription.27="" ParamDescription.28="" ParamDescription.29="" ParamDescription.3="" ParamDescription.30="" ParamDescription.31="" ParamDescription.32="" ParamDescription.4="" ParamDescription.5="" ParamDescription.6="" ParamDescription.7="" ParamDescription.8="" ParamDescription.9="" ParamType.1="" ParamType.10="" ParamType.11="" ParamType.12="" ParamType.13="" ParamType.14="" ParamType.15="" ParamType.16="" ParamType.17="" ParamType.18="" ParamType.19="" ParamType.2="" ParamType.20="" ParamType.21="" ParamType.22="" ParamType.23="" ParamType.24="" ParamType.25="" ParamType.26="" ParamType.27="" ParamType.28="" ParamType.29="" ParamType.3="" ParamType.30="" ParamType.31="" ParamType.32="" ParamType.4="" ParamType.5="" ParamType.6="" ParamType.7="" ParamType.8="" ParamType.9="" Password="" PathID="841" Query="SELECT &#10;    &#9;(SELECT COUNT(ID_PLANT) FROM SE.SE_PLANT WHERE &#10;        &#9;(ID_PLANT IN (SELECT RESULT FROM SQLSCRIPT_STRING:SPLIT_TO_TABLE([Param.20],',')) OR [Param.20] = '*')) AS &#10;    PLANT_ALL,&#10;    &#9;(SELECT COUNT(ID_SOURCE) FROM SE.SE_SOURCE &#10;        &#9;WHERE ID_INITIAL_LOAD_PARENT IS NULL AND FL_ENABLED = 1 AND &#10;        &#9;(ID_PLANT IN (SELECT RESULT FROM SQLSCRIPT_STRING:SPLIT_TO_TABLE([Param.20],',')) OR [Param.20] = '*')) AS &#10;    SOURCE_ENABLED,&#10;    &#9;(SELECT COUNT(ID_DATA_FLOW) FROM SE.SE_DATA_FLOW F INNER JOIN SE.SE_SOURCE S ON S.ID_SOURCE = F.ID_SOURCE&#10;    &#9;    WHERE S.ID_INITIAL_LOAD_PARENT IS NULL AND F.ID_FLOW_TYPE = 'ARCHIVE' AND F.FL_ENABLED = 1 AND S.FL_ENABLED = 1 AND S.FL_ARCHIVE = 1 AND&#10;    &#9;    (S.ID_PLANT IN (SELECT RESULT FROM SQLSCRIPT_STRING:SPLIT_TO_TABLE([Param.20],',')) OR [Param.20] = '*')) AS &#10;&#9;FLOW_ARCHIVE_ENABLED,&#10;    &#9;(SELECT COUNT(ID_DATA_FLOW) FROM SE.SE_DATA_FLOW F INNER JOIN SE.SE_SOURCE S ON S.ID_SOURCE = F.ID_SOURCE&#10;    &#9;    WHERE S.ID_INITIAL_LOAD_PARENT IS NULL AND F.ID_FLOW_TYPE = 'FILE' AND F.FL_ENABLED = 1 AND S.FL_ENABLED = 1 AND &#10;    &#9;    (S.ID_PLANT IN (SELECT RESULT FROM SQLSCRIPT_STRING:SPLIT_TO_TABLE([Param.20],',')) OR [Param.20] = '*')) AS &#10;&#9;FLOW_FILE_ENABLED,&#10;    &#9;(SELECT COUNT(ID_DATA_FLOW) FROM SE.SE_DATA_FLOW F INNER JOIN SE.SE_SOURCE S ON S.ID_SOURCE = F.ID_SOURCE&#10;        &#9;WHERE S.ID_INITIAL_LOAD_PARENT IS NULL AND F.ID_FLOW_TYPE = 'CONTEXTUAL' AND F.FL_ENABLED = 1 AND S.FL_ENABLED = 1 AND &#10;        &#9;(S.ID_PLANT IN (SELECT RESULT FROM SQLSCRIPT_STRING:SPLIT_TO_TABLE([Param.20],',')) OR [Param.20] = '*')) AS &#10;    FLOW_CONTEXTUAL_ENABLED,&#10;    &#9;(SELECT COUNT(J.ID_JOB) FROM SE.SE_JOB J INNER JOIN SE.SE_DATA_FLOW F ON F.ID_DATA_FLOW = J.ID_DATA_FLOW INNER JOIN SE.SE_SOURCE S ON S.ID_SOURCE = F.ID_SOURCE&#10;        &#9;WHERE S.FL_ENABLED = 1 AND F.FL_ENABLED = 1 AND J.FL_DELETED = 0 AND J.FL_NEW_VERSION = 0 AND J.DT_LAST_ERROR IS NULL AND &#10;        &#9;(S.ID_PLANT IN (SELECT RESULT FROM SQLSCRIPT_STRING:SPLIT_TO_TABLE([Param.20],',')) OR [Param.20] = '*')) AS &#10;    JOBS_RUNNING,&#10;    &#9;(SELECT COUNT(J.ID_JOB) FROM SE.SE_JOB J INNER JOIN SE.SE_DATA_FLOW F ON F.ID_DATA_FLOW = J.ID_DATA_FLOW INNER JOIN SE.SE_SOURCE S ON S.ID_SOURCE = F.ID_SOURCE&#10;        &#9;WHERE S.FL_ENABLED = 1 AND F.FL_ENABLED = 1 AND J.FL_DELETED = 0 AND J.FL_NEW_VERSION = 0 AND J.DT_LAST_ERROR IS NOT NULL AND &#10;        &#9;(S.ID_PLANT IN (SELECT RESULT FROM SQLSCRIPT_STRING:SPLIT_TO_TABLE([Param.20],',')) OR [Param.20] = '*')) AS &#10;    JOBS_ERROR,&#10;&#9;    (SELECT COUNT(J.ID_JOB) FROM SE.SE_JOB J INNER JOIN SE.SE_DATA_FLOW F ON F.ID_DATA_FLOW = J.ID_DATA_FLOW INNER JOIN SE.SE_SOURCE S ON S.ID_SOURCE = F.ID_SOURCE&#10;&#9;        WHERE S.FL_ENABLED = 1 AND F.FL_ENABLED = 1 AND J.FL_DELETED = 0 AND J.FL_NEW_VERSION = 0 AND &#10;&#9;        (S.ID_PLANT IN (SELECT RESULT FROM SQLSCRIPT_STRING:SPLIT_TO_TABLE([Param.20],',')) OR [Param.20] = '*')) AS &#10;&#9;JOBS_ALL,&#10;&#9;    (SELECT COUNT(Q.ID_QUEUE) FROM SE.SE_JOB_QUEUE Q INNER JOIN SE.SE_JOB J ON J.ID_JOB = Q.ID_JOB INNER JOIN SE.SE_DATA_FLOW F ON F.ID_DATA_FLOW = J.ID_DATA_FLOW INNER JOIN SE.SE_SOURCE S ON S.ID_SOURCE = F.ID_SOURCE&#10;&#9;        WHERE Q.ID_STATUS = 'PENDING' AND &#10;&#9;        (S.ID_PLANT IN (SELECT RESULT FROM SQLSCRIPT_STRING:SPLIT_TO_TABLE([Param.20],',')) OR [Param.20] = '*')) AS &#10;    QUEUE_PENDING,&#10;&#9;    (SELECT COUNT(Q.ID_QUEUE) FROM SE.SE_JOB_QUEUE Q INNER JOIN SE.SE_JOB J ON J.ID_JOB = Q.ID_JOB INNER JOIN SE.SE_DATA_FLOW F ON F.ID_DATA_FLOW = J.ID_DATA_FLOW INNER JOIN SE.SE_SOURCE S ON S.ID_SOURCE = F.ID_SOURCE&#10;&#9;        WHERE Q.ID_STATUS = 'EXPIRED' AND &#10;&#9;        (S.ID_PLANT IN (SELECT RESULT FROM SQLSCRIPT_STRING:SPLIT_TO_TABLE([Param.20],',')) OR [Param.20] = '*')) AS &#10;    QUEUE_EXPIRED,&#10;&#9;    (SELECT COUNT(Q.ID_QUEUE) FROM SE.SE_JOB_QUEUE Q INNER JOIN SE.SE_JOB J ON J.ID_JOB = Q.ID_JOB INNER JOIN SE.SE_DATA_FLOW F ON F.ID_DATA_FLOW = J.ID_DATA_FLOW INNER JOIN SE.SE_SOURCE S ON S.ID_SOURCE = F.ID_SOURCE&#10;&#9;        WHERE Q.ID_STATUS != 'RUNNING' AND &#10;&#9;        (S.ID_PLANT IN (SELECT RESULT FROM SQLSCRIPT_STRING:SPLIT_TO_TABLE([Param.20],',')) OR [Param.20] = '*')) AS &#10;    QUEUE_ALL,&#10;&#9;    (SELECT COUNT(DISTINCT T.ID_TAG) FROM SE.SE_TAG T INNER JOIN SE.SE_SOURCE S ON S.ID_SOURCE = T.ID_SOURCE LEFT OUTER JOIN SE.SE_TAG_MAPPING M ON M.ID_TAG = T.ID_TAG LEFT OUTER JOIN SE.SE_TAG_MAPPING_APP A ON A.ID_TAG = M.ID_TAG LEFT OUTER JOIN SE.SE_PCO_DESTINATION D ON D.ID_PCO_DESTINATION = M.ID_PCO_DESTINATION &#10;&#9;        WHERE S.ID_INITIAL_LOAD_PARENT IS NULL AND (D.ID_DESTINATION_TYPE != 'WATCH' OR D.ID_DESTINATION_TYPE IS NULL) AND S.FL_ENABLED = 1 AND (M.ID_AGENT IS NOT NULL OR M.ID_JOB IS NOT NULL) AND &#10;&#9;        (S.ID_PLANT IN (SELECT RESULT FROM SQLSCRIPT_STRING:SPLIT_TO_TABLE([Param.20],',')) OR [Param.20] = '*')) AS &#10;    TAGS_ENABLED,&#10;&#9;    (SELECT COUNT(DISTINCT B.ID_BATCH_CATALOG) FROM SE.SE_BATCH_CATALOG B INNER JOIN SE.SE_SOURCE S ON S.ID_SOURCE = B.ID_SOURCE &#10;&#9;        WHERE S.ID_INITIAL_LOAD_PARENT IS NULL AND S.FL_ENABLED = 1 AND B.ID_PLANT_HIERARCHY IS NOT NULL AND &#10;&#9;        (S.ID_PLANT IN (SELECT RESULT FROM SQLSCRIPT_STRING:SPLIT_TO_TABLE([Param.20],',')) OR [Param.20] = '*')) AS &#10;    EQUIPMENT_MAPPED,&#10;&#9;    (SELECT COUNT(*) FROM SE.SE_MANUAL_IMPORT M WHERE DS_USERNAME = [Param.1]) AS &#10;    FILES_IN_PROCESS,&#10;&#9;    (SELECT COUNT(DISTINCT T.ID_TAG) FROM SE.SE_TAG T INNER JOIN SE.SE_SOURCE S ON S.ID_SOURCE = T.ID_SOURCE LEFT OUTER JOIN SE.SE_TAG_MAPPING M ON M.ID_TAG = T.ID_TAG LEFT OUTER JOIN SE.SE_TAG_MAPPING_APP A ON A.ID_TAG = M.ID_TAG LEFT OUTER JOIN SE.SE_PCO_DESTINATION D ON D.ID_PCO_DESTINATION = M.ID_PCO_DESTINATION&#10;&#9;        WHERE S.ID_INITIAL_LOAD_PARENT IS NULL AND (D.ID_DESTINATION_TYPE != 'WATCH' OR D.ID_DESTINATION_TYPE IS NULL) AND S.FL_ENABLED = 1 AND (A.ID_DIGITAL_APP IS NOT NULL) AND &#10;&#9;        (S.ID_PLANT IN (SELECT RESULT FROM SQLSCRIPT_STRING:SPLIT_TO_TABLE([Param.20],',')) OR [Param.20] = '*')) AS &#10;    TAGS_ASSIGNED_APP, &#10;&#9;    (SELECT COUNT(DISTINCT A.ID_AGENT) FROM SE.SE_PCO_AGENT A INNER JOIN SE.SE_SOURCE S ON S.ID_SOURCE = A.ID_SOURCE &#10;&#9;        WHERE S.ID_INITIAL_LOAD_PARENT IS NULL AND A.DS_ALERT_AGENT != 'Started' AND S.FL_ENABLED = 1 AND &#10;&#9;        (S.ID_PLANT IN (SELECT RESULT FROM SQLSCRIPT_STRING:SPLIT_TO_TABLE([Param.20],',')) OR [Param.20] = '*')) AS &#10;    FLOW_REALTIME_AGENTS_ERROR,    &#10;&#9;    (SELECT COUNT(DISTINCT A.ID_AGENT) FROM SE.SE_PCO_AGENT A INNER JOIN SE.SE_SOURCE S ON S.ID_SOURCE = A.ID_SOURCE &#10;&#9;        WHERE S.ID_INITIAL_LOAD_PARENT IS NULL AND S.FL_ENABLED = 1 AND &#10;&#9;        (S.ID_PLANT IN (SELECT RESULT FROM SQLSCRIPT_STRING:SPLIT_TO_TABLE([Param.20],',')) OR [Param.20] = '*')) AS &#10;    FLOW_REALTIME_AGENTS_ALL,    &#10;&#9;    (SELECT COUNT(L.ID_AUDIT_LOG) FROM SE.SE_AUDIT_LOG L &#10;&#9;        WHERE L.DT_TIMESTAMP &gt;= TO_TIMESTAMP([SD], 'YYYY-MM-DD&quot; &quot;HH24:MI:SS') AND L.DT_TIMESTAMP &lt; TO_TIMESTAMP([ED], 'YYYY-MM-DD&quot; &quot;HH24:MI:SS') AND L.DS_ACTION IN ('INSERT','UPDATE','DELETE') AND&#10;&#9;        (ID_PLANT IN (SELECT RESULT FROM SQLSCRIPT_STRING:SPLIT_TO_TABLE([Param.20],',')) OR [Param.20] = '*')) AS &#10;    LOG_CHANGES_24H,&#10;&#9;    ( (SELECT COUNT(DD.ID_DATA_DESTINATION) FROM SE.SE_DATA_DESTINATION DD WHERE DD.FL_ENABLED = 1) + (SELECT COUNT(PD.ID_PCO_DESTINATION) FROM SE.SE_PCO_DESTINATION PD WHERE&#10;    (PD.ID_PLANT IN (SELECT RESULT FROM SQLSCRIPT_STRING:SPLIT_TO_TABLE([Param.20],',')) OR [Param.20] = '*') AND&#10;    PD.ID_DESTINATION_TYPE = 'REST')) AS &#10;&#9;DATA_DESTINATIONS,&#10;&#9;&#9;(SELECT COUNT(EF.ID_DATA_FLOW) FROM SE.SE_DATA_FLOW EF INNER JOIN SE.SE_SOURCE S ON S.ID_SOURCE = EF.ID_SOURCE&#10;        &#9;WHERE S.ID_INITIAL_LOAD_PARENT IS NULL AND EF.ID_FLOW_TYPE = 'ENERGY' AND EF.FL_ENABLED = 1 AND S.FL_ENABLED = 1 AND &#10;        &#9;(S.ID_PLANT IN (SELECT RESULT FROM SQLSCRIPT_STRING:SPLIT_TO_TABLE([Param.20],',')) OR [Param.20] = '*')) AS &#10;    FLOW_EXTERNAL_ENABLED,&#10;    &#9;(SELECT SUM(QT_JSON_ROWCOUNT) FROM SE.SE_FLOW_MONITORING WHERE DT_RUN_TIME &gt; CAST(CURRENT_TIMESTAMP AS DATE)) AS FLOW_MONITORING_SENT,&#10;&#9;&#9;(SELECT COUNT(PF.ID_USERNAME) FROM SE.SE_USER_PROFILE PF ) AS USERS,&#10;&#9;&#9;(SELECT COUNT(AL.ID_MESSA) FROM SANOFI_CORE.CORE_APPLICATION_LOG AL WHERE AL.DS_MODUL ='StreamingEngine' AND AL.DT_MESSA &gt;= TO_TIMESTAMP([SD], 'YYYY-MM-DD&quot; &quot;HH24:MI:SS') AND AL.DT_MESSA &lt; TO_TIMESTAMP([ED], 'YYYY-MM-DD&quot; &quot;HH24:MI:SS')) AS LOG_ALL&#10;FROM&#10;    DUMMY&#10;" QueryParams="" ReaderRoles="SAP_XMII_User" RestrictedPropertyOverride="false" ResultSetMode="false" RowCount="100" SaveDate="08/04/2025 15:20:00" Schedule="" SelectedColumns="" Server="Z_STREAMING_ENGINE" Service="" SetMaxRows="true" SortExpr="" StartDate="" Tables="" Time="" TimePeriod="" Trace="false" TransformerLibrary="" UseTypedParams="T" UserName="" Version="15.5.1.41" WriterRoles="SAP_XMII_Super_Administrator,SAP_XMII_Administrator,SAP_XMII_Developer" XParamName.1="" XParamName.10="" XParamName.11="" XParamName.12="" XParamName.13="" XParamName.14="" XParamName.15="" XParamName.16="" XParamName.2="" XParamName.3="" XParamName.4="" XParamName.5="" XParamName.6="" XParamName.7="" XParamName.8="" XParamName.9="" XParamValue.1="" XParamValue.10="" XParamValue.11="" XParamValue.12="" XParamValue.13="" XParamValue.14="" XParamValue.15="" XParamValue.16="" XParamValue.2="" XParamValue.3="" XParamValue.4="" XParamValue.5="" XParamValue.6="" XParamValue.7="" XParamValue.8="" XParamValue.9="" XmlDateFormat="yyyy-MM-dd'T'HH:mm:ss" XmlNumberFormat=""><Tasks/><ETCServers/><ETCObjects/></SQLQuery>