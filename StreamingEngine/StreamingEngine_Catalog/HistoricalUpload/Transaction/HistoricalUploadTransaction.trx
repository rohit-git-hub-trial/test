ion/><To>ContextualFlowJobInsertQuery.Param.7</To><From>0</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>ContextualFlowJobInsertQuery.Param.8</To><From>0</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>ContextualFlowJobInsertQuery.Param.9</To><From>"HISTORICAL DATA UPLOAD"</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>Assignment_Job</Name><Description> </Description><Expiration/><IncomingLinks/><OutgoingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Local.ID_JOB</To><From>guid</From></Assign></OutgoingLinks></Action></Actions></Step><Step xsi:type="ActionSequence"><Name>HistoricalUploadEnabled</Name><Description/><Steps/><Actions><Action><Name>Row_2</Name><Description> </Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Row_2.Plant</To><From>ContextualFlowSelectQuery.Results{/Rowsets/Rowset/Row/PLANT}</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Row_2.FlowName</To><From>ContextualFlowSelectQuery.Results{/Rowsets/Rowset/Row/FLOW_NAME}</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Row_2.DataSourceName</To><From>ContextualFlowSelectQuery.Results{/Rowsets/Rowset/Row/SOURCE_NAME}</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Row_2.ResponseMessage</To><From>"Historical data upload enabled successfully"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Row_2.Status</To><From>"S"</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step><Step xsi:type="ActionSequence"><Name>BREAK_LOOP</Name><Description/><Steps/><Actions><Action><Name>Assignment_0</Name><Description> </Description><Expiration/><IncomingLinks/><OutgoingLinks><Assign xsi:type="Assign"><Name/><Description/><To>For_Next_Loop_0.Break</To><From>Local.ParallelHistoricalUploads == false</From></Assign></OutgoingLinks></Action></Actions></Step><Step xsi:type="ActionSequence"><Name>Email Notification when historical upload is launched</Name><Description>Email Notification when historical upload is launched</Description><Steps><Step xsi:type="ActionSequence"><Name>Sequence_46</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_45</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_92</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_49</Name><Description/><Steps/><Actions><Action><Name>LogSaver_5</Name><Description> </Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_5.LogModuleId</To><From>"StreamingEngine"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_5.LogSeverity</To><From>"D"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_5.LogUser</To><From>username</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_5.LogTransactionName</To><From>transactionpath</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_5.MessageTitle</To><From>"Email Notification Send for Historical Upload Launch"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_5.MessageDescription</To><From>"Email Notification Send for Historical Upload Launch - Contextual Flow | Email Sender : " &amp;
SendEmailAlertTransaction_0.ToAddress  &amp;  " | " &amp;
" Historical upload has been created by a user/system. Details below :" &amp; " | " &amp;

"Plant : " &amp; ContextualFlowSelectQuery.Results{/Rowsets/Rowset/Row/PLANT} &amp; "" &amp; " | " &amp;

"Server URL : " &amp; Persistent.ServerBaseURL &amp; "" &amp; " | " &amp;

"Data Source : " &amp; ContextualFlowSelectQuery.Results{/Rowsets/Rowset/Row/SOURCE_NAME} &amp; "" &amp; " | " &amp;

"Data Flow : " &amp; ContextualFlowSelectQuery.Results{/Rowsets/Rowset/Row/FLOW_NAME} &amp; "" &amp; " | " &amp;

"Flow Type : CONTEXTUAL" &amp; " | " &amp;

"Job Id : " &amp; Local.ID_JOB &amp; "" &amp; " | " &amp;

"Historical Upload Start Date : " &amp; Local.EmailStartDate &amp; " " &amp; Local.TimeZone &amp; "" &amp; " | " &amp;

"Historical Upload End Date : " &amp; Local.EmailEndDate &amp; " " &amp; Local.TimeZone &amp; "" &amp; " | " &amp;

"Start Timestamp : " &amp; Local.Datenow &amp; " " &amp; Local.TimeZone &amp; "" &amp; " | " &amp;

"Triggered By (User/System) : " &amp; username </From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>SendEmailAlertTransaction_0</Name><Description> </Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>SendEmailAlertTransaction_0.ToAddress</To><From>Persistent.HistoricalUploadAlertEmailDL</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>SendEmailAlertTransaction_0.Subject</To><From>"[Streaming Engine Alert] Historical Upload Launch Notification - Contextual Flow"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>SendEmailAlertTransaction_0.FromAddress</To><From>Persistent.SenderName</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>SendEmailAlertTransaction_0.EmailBody</To><From>Local.EmailBody</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>SendEmailAlertTransaction_0.Async</To><From>true</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>Assignment_Email</Name><Description> </Description><Expiration/><IncomingLinks/><OutgoingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Local.EmailStartDate</To><From>datefromxmlformat(Local.StartDate, "MM/dd/yyyy HH:mm:ss")</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Local.EmailEndDate</To><From>datefromxmlformat(Local.EndDate, "MM/dd/yyyy HH:mm:ss")</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Local.TimeZone</To><From>"UTC" &amp; stringif(currenttimezoneoffset &gt; 0,"+","") &amp; (currenttimezoneoffset/3600000) &amp; " H "  &amp; currenttimezone</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Local.Datenow</To><From>datefromxmlformat(datenow, "MM/dd/yyyy HH:mm:ss")</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Local.EmailBody</To><From>"&lt;html&gt;
&lt;head&gt;
    &lt;style&gt;
        body {
            font-family: Arial, sans-serif;
            font-size: 14px;
            color: #333;
        }
        table {
            border-collapse: collapse;
            width: 60%;
        }
        th {
            text-align: left;
            background-color: #f2f2f2;
            padding: 8px;
            border: 1px solid #ccc;
            width: 40%;
        }
        td {
            padding: 8px;
            border: 1px solid #ccc;
        }
    &lt;/style&gt;
&lt;/head&gt;
&lt;body&gt;


&lt;p style='font-size:16px; font-weight:bold;'&gt;
Historical upload has been created by a user/system. Please find the details below:&lt;/p&gt;

&lt;table&gt;
    &lt;tr&gt;
        &lt;th&gt;Plant&lt;/th&gt;
        &lt;td&gt;"&amp;ContextualFlowSelectQuery.Results{/Rowsets/Rowset/Row/PLANT}&amp;"&lt;/td&gt;
    &lt;/tr&gt;
    &lt;tr&gt;
        &lt;th&gt;Server URL&lt;/th&gt;
        &lt;td&gt;"&amp;Persistent.ServerBaseURL&amp;"&lt;/td&gt;
    &lt;/tr&gt;
    &lt;tr&gt;
        &lt;th&gt;Data Source&lt;/th&gt;
        &lt;td&gt;"&amp;ContextualFlowSelectQuery.Results{/Rowsets/Rowset/Row/SOURCE_NAME}&amp;"*&lt;/td&gt;
    &lt;/tr&gt;
    &lt;tr&gt;
        &lt;th&gt;Data Flow&lt;/th&gt;
        &lt;td&gt;"&amp;ContextualFlowSelectQuery.Results{/Rowsets/Rowset/Row/FLOW_NAME}&amp;"*&lt;/td&gt;
    &lt;/tr&gt;
    &lt;tr&gt;
        &lt;th&gt;Flow Type&lt;/th&gt;
        &lt;td&gt;"&amp;"CONTEXTUAL"&amp;"&lt;/td&gt;
    &lt;/tr&gt;
	 &lt;tr&gt;
        &lt;th&gt;Job Id&lt;/th&gt;
        &lt;td&gt;"&amp;Local.ID_JOB&amp;"&lt;/td&gt;
    &lt;/tr&gt;
    &lt;tr&gt;
        &lt;th&gt;Historical Upload Start Date&lt;/th&gt;
        &lt;td&gt;"&amp;Local.EmailStartDate &amp; " " &amp;Local.TimeZone  &amp; "&lt;/td&gt;
    &lt;/tr&gt;
    &lt;tr&gt;
        &lt;th&gt;Historical Upload End Date&lt;/th&gt;
        &lt;td&gt;"&amp;Local.EmailEndDate &amp; " " &amp;Local.TimeZone  &amp;"&lt;/td&gt;
    &lt;/tr&gt;
    &lt;tr&gt;
        &lt;th&gt;Start Timestamp&lt;/th&gt;
        &lt;td&gt;"&amp;Local.Datenow &amp; " " &amp;Local.TimeZone  &amp;"&lt;/td&gt;
    &lt;/tr&gt;
    &lt;tr&gt;
        &lt;th&gt;Triggered By (User/System)&lt;/th&gt;
        &lt;td&gt;"&amp;username&amp;"&lt;/td&gt;
    &lt;/tr&gt;
&lt;/table&gt;

&lt;p&gt;This is an automated message. Please do not reply.&lt;/p&gt;

&lt;/body&gt;
&lt;/html&gt;"</From></Assign></OutgoingLinks></Action></Actions></Step></Steps><Actions/></Step><Step xsi:type="Catch"><Name>Sequence_47</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_48</Name><Description/><Steps/><Actions><Action><Name>LogSaver_4</Name><Description> </Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_4.LogModuleId</To><From>"StreamingEngine"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_4.LogSeverity</To><From>"E"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_4.LogUser</To><From>username</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_4.LogTransactionName</To><From>transactionpath</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_4.MessageTitle</To><From>"Email Notification Failed for Historical Upload Launch"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_4.MessageDescription</To><From>"[" &amp; Catch_0.ExceptionType &amp; "] - " &amp; Catch_0.Message</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver_4.LogActionBlockName</To><From>Catch_0.Source</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>Catch_0</Name><Description>Catches an exception</Description><Expiration/><IncomingLinks/><OutgoingLinks/></Action></Actions></Step></Steps><Actions/></Step></Steps><Actions/></Step></Steps><Actions><Action><Name>Assignment_Dates</Name><Description> </Description><Expiration/><IncomingLinks/><OutgoingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Local.StartDate</To><From>stringif(For_Next_Loop_0.CurrentItem==1,datetoxmlformat(Transaction.StartDate, "dd/MM/yyyy HH:mm:ss" ), dateadddays(Local.StartDate, Local.DaysInterval)  )</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Local.EndDate</To><From>stringif((For_Next_Loop_0.CurrentItem == Local.NumberOfParallelUploads) || (Local.ParallelHistoricalUploads== false), datetoxmlformat(Transaction.EndDate, "dd/MM/yyyy HH:mm:ss") ,dateadddays(Local.StartDate, Local.DaysInterval))</From></Assign></OutgoingLinks></Action></Actions></Step></Steps><Actions><Action><Name>For_Next_Loop_0</Name><Description> </Description><Expiration>Sequence_13</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>For_Next_Loop_0.From</To><From>1</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>For_Next_Loop_0.Step</To><From>1</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>For_Next_Loop_0.To</To><From>ContextualFlowSelectQuery.Results{/Rowsets/Rowset/Row/QT_MAX_HISTORICAL_UPLOADS} - HistoricalUploadSourceCountQuery_0.Results{/Rowsets/Rowset/Row/HISTORICAL_UPLOADS}  </From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>Assignment_Split_Historical_Uploads</Name><Description> </Description><Expiration>Sequence_13</Expiration><IncomingLinks/><OutgoingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Local.ParallelHistoricalUploads</To><From>datediffdays(datetoxmlformat(Transaction.StartDate, "dd/MM/yyyy HH:mm:ss"), datetoxmlformat(Transaction.EndDate, "dd/MM/yyyy HH:mm:ss")) &gt; 180</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Local.NumberOfParallelUploads</To><From>ContextualFlowSelectQuery.Results{/Rowsets/Rowset/Row/QT_MAX_HISTORICAL_UPLOADS} - HistoricalUploadSourceCountQuery_0.Results{/Rowsets/Rowset/Row/HISTORICAL_UPLOADS}  </From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Local.DaysInterval</To><From>datediffdays(datetoxmlformat(Transaction.StartDate, "dd/MM/yyyy HH:mm:ss"), datetoxmlformat(Transaction.EndDate, "dd/MM/yyyy HH:mm:ss")) / Local.NumberOfParallelUploads</From></Assign></OutgoingLinks></Action></Actions></Step><Step xsi:type="ActionSequence"><Name>Sequence_13</Name><Description/><Steps/><Actions/></Step></Steps><Actions><Action><Name>Conditional_Overlap</Name><Description> </Description><Expiration>FlowAlreadyEnabled</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Conditional_Overlap.Input1</To><From>Local.OverLapFlag == false</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions/></Step></Steps><Actions/></Step><Step xsi:type="ActionSequence"><Name>FlowAlreadyEnabled</Name><Description/><Steps/><Actions><Action><Name>Row_0</Name><Description> </Description><Expiration>DISABLE_FLOW</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Row_0.Plant</To><From>ContextualFlowSelectQuery.Results{/Rowsets/Rowset/Row/PLANT}</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Row_0.FlowName</To><From>ContextualFlowSelectQuery.Results{/Rowsets/Rowset/Row/FLOW_NAME}</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Row_0.DataSourceName</To><From>ContextualFlowSelectQuery.Results{/Rowsets/Rowset/Row/SOURCE_NAME}</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Row_0.ResponseMessage</To><From>"Number of historical data uploads in parallel for this data source:  " &amp; ContextualFlowSelectQuery.Results{/Rowsets/Rowset/Row/SOURCE_NAME} &amp;"  reached"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Row_0.Status</To><From>"E"</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>Conditional_Countparalleluploads</Name><Description> </Description><Expiration>DISABLE_FLOW</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Conditional_Countparalleluploads.Input1</To><From>HistoricalUploadSourceCountQuery_0.Results{/Rowsets/Rowset/Row/HISTORICAL_UPLOADS} &lt; ContextualFlowSelectQuery.Results{/Rowsets/Rowset/Row/QT_MAX_HISTORICAL_UPLOADS}</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>HistoricalUploadSourceCountQuery_0</Name><Description>SQL Query</Description><Expiration>DISABLE_FLOW</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>HistoricalUploadSourceCountQuery_0.Param.1</To><From>ContextualFlowSelectQuery.Results{/Rowsets/Rowset/Row/ID_SOURCE}</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>HistoricalUploadFlowSelectQuery</Name><Description>SQL Query</Description><Expiration>DISABLE_FLOW</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>HistoricalUploadFlowSelectQuery.Param.1</To><From>Transaction.FlowID</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions/></Step><Step xsi:type="ActionSequence"><Name>DISABLE_FLOW</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>DELETE_JOB</Name><Description/><Steps/><Actions><Action><Name>ContextualFlowTransaction_Delete</Name><Description> </Description><Expiration>HistoricalUploadDisabled</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>ContextualFlowTransaction_Delete.Action</To><From>"DELETE"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>ContextualFlowTransaction_Delete.DS_NAME</To><From>ContextualFlowSelectQuery.Results{/Rowsets/Rowset/Row/PLANT}</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>ContextualFlowTransaction_Delete.DS_MII_TRANSACTION</To><From>ContextualFlowSelectQuery.Results{/Rowsets/Rowset/Row/DS_MII_TRANSACTION}</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>ContextualFlowTransaction_Delete.DS_DESCRIPTION</To><From>ContextualFlowSelectQuery.Results{/Rowsets/Rowset/Row/DS_DESCRIPTION}</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>ContextualFlowTransaction_Delete.FL_ENABLED</To><From>ContextualFlowSelectQuery.Results{/Rowsets/Rowset/Row/FL_ENABLED}</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>ContextualFlowTransaction_Delete.F