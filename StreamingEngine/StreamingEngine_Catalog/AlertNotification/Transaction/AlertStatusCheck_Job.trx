"&lt;li&gt;Flow Type: " 	&amp; "&lt;b&gt;" &amp; Repeater_Jobs.Output{/Row/ID_FLOW_TYPE} &amp; "&lt;/b&gt;&lt;/li&gt;" &amp;
"&lt;li&gt;Flow Name: " 	&amp; "&lt;b&gt;" &amp; Repeater_Jobs.Output{/Row/FLOW_NAME} &amp; "&lt;/b&gt;&lt;/li&gt;" &amp;
"&lt;li&gt;Job ID: " 		&amp; "&lt;b&gt;" &amp; Repeater_Jobs.Output{/Row/ID_JOB} &amp; "&lt;/b&gt;&lt;/li&gt;" &amp;
"&lt;li&gt;Last Execution: " 	&amp; "&lt;b&gt;" &amp; Repeater_Jobs.Output{/Row/DT_LAST_RUN_EXECUTION} &amp; "&lt;/b&gt;&lt;/li&gt;" &amp;
"&lt;li&gt;Run Start: " 	&amp; "&lt;b&gt;" &amp; Repeater_Jobs.Output{/Row/DT_LAST_RUN_START} &amp; "&lt;/b&gt;&lt;/li&gt;" &amp;
