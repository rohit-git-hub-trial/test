"Job " &amp; Repeater_Jobs.Output{/Row/ROW_ID} &amp; stringif(Repeater_Jobs.Output{/Row/FL_STATUS_JOB} == "G", " is back to normal", " is not working")</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>Send_Mail_Jobs</Name><Description> </Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Send_Mail_Jobs.Subject</To><From>"[Streaming Engine Alert] " &amp; Repeater_Jobs.Output{/Row/DS_NAME} &amp; " / Job " &amp; Repeater_Jobs.Output{/Row/ROW_ID} &amp; stringif(Repeater_Jobs.Output{/Row/FL_STATUS_JOB} == "G", " is back to normal", " is not working")</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Send_Mail_Jobs.Message</To><From>"&lt;b&gt;" &amp; "ALERT: Job " &amp; Repeater_Jobs.Output{/Row/ROW_ID} &amp; stringif(Repeater_Jobs.Output{/Row/FL_STATUS_JOB} == "G", " is back to normal", " is not working") &amp; "&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;" &amp;
"&lt;ul&gt;" &amp;
"&lt;li&gt;Plant ID: " 	&amp; "&lt;b&gt;" &amp; Repeater_Jobs.Output{/Row/ID_PLANT} &amp; "&lt;/b&gt;&lt;/li&gt;" &amp;
