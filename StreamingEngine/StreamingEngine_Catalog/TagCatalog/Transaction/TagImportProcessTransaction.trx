 </From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step><Step xsi:type="ActionSequence"><Name>Sequence_54</Name><Description/><Steps/><Actions><Action><Name>TagImportFailedUpdateQuery_22</Name><Description>SQL Query</Description><Expiration>Sequence_36</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>TagImportFailedUpdateQuery_22.Param.1</To><From>Repeater.Output{/Row/ID_LOG}</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>TagImportFailedUpdateQuery_22.Param.2</To><From>datenow</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>TagImportFailedUpdateQuery_22.Param.3</To><From>"E"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>TagImportFailedUpdateQuery_22.Param.4</To><From>"The tag X is wrongly renamed due to tagname part at" &amp;
