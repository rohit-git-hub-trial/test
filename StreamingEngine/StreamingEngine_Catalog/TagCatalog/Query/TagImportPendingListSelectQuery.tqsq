<?xml version="1.0" encoding="UTF-8" standalone="no"?><SQLQuery AllowBuffering="false" AllowFuture="true" AllowNullValues="true" AutoCommit="false" AutoTypeParameters="false" CacheDuration="0" CacheDurationUnits="M" Columns="" Comment="" Connector="" DateColumn="" DateFormat="MM/dd/yyyy HH:mm:ss" Debug="false" Description="" DocType="SQLQuery" Duration="60" DurationUnits="M" EndDate="" FilterExpr="" FixedQuery="" GroupingExpr="" HanaDataSource="true" ID="3255" InlineTransform="" IntervalCount="1" IsCachable="false" JoinExpr="" Mask="" Method="" Mode="FixedQuery" NumberFormat="0.00" Param.1="" Param.10="" Param.11="" Param.12="" Param.13="" Param.14="" Param.15="" Param.16="" Param.17="" Param.18="" Param.19="" Param.2="" Param.20="" Param.21="" Param.22="" Param.23="" Param.24="" Param.25="" Param.26="" Param.27="" Param.28="" Param.29="" Param.3="" Param.30="" Param.31="" Param.32="" Param.4="" Param.5="" Param.6="" Param.7="" Param.8="" Param.9="" ParamDescription.1="" ParamDescription.10="" ParamDescription.11="" ParamDescription.12="" ParamDescription.13="" ParamDescription.14="" ParamDescription.15="" ParamDescription.16="" ParamDescription.17="" ParamDescription.18="" ParamDescription.19="" ParamDescription.2="" ParamDescription.20="" ParamDescription.21="" ParamDescription.22="" ParamDescription.23="" ParamDescription.24="" ParamDescription.25="" ParamDescription.26="" ParamDescription.27="" ParamDescription.28="" ParamDescription.29="" ParamDescription.3="" ParamDescription.30="" ParamDescription.31="" ParamDescription.32="" ParamDescription.4="" ParamDescription.5="" ParamDescription.6="" ParamDescription.7="" ParamDescription.8="" ParamDescription.9="" ParamType.1="" ParamType.10="" ParamType.11="" ParamType.12="" ParamType.13="" ParamType.14="" ParamType.15="" ParamType.16="" ParamType.17="" ParamType.18="" ParamType.19="" ParamType.2="" ParamType.20="" ParamType.21="" ParamType.22="" ParamType.23="" ParamType.24="" ParamType.25="" ParamType.26="" ParamType.27="" ParamType.28="" ParamType.29="" ParamType.3="" ParamType.30="" ParamType.31="" ParamType.32="" ParamType.4="" ParamType.5="" ParamType.6="" ParamType.7="" ParamType.8="" ParamType.9="" Password="" PathID="861" Query="SELECT&#10;    L.ID_LOG,&#10;    P.ID_PLANT,&#10;    L.DS_PLANT,&#10;    L.DS_SOURCE,&#10;    S.ID_SOURCE,&#10;    L.DS_TAG_ORIGINAL,&#10;    L.DS_TAG_RENAMED,&#10;    L.DS_DESCRIPTION,&#10;    U.ID_UOM,&#10;    L.DS_UOM,&#10;    L.DS_DIGITAL_APP,&#10;    L.DS_TRANSFORMATION,&#10;    A.ID_DIGITAL_APP AS DS_DIGITAL_APP_ACTUAL,&#10;    A.ID_TRANSFORMATION AS DS_TRANSFORMATION_ACTUAL,&#10;    (CASE WHEN L.DS_TRANSFORMATION IS NULL THEN 1  &#10;                 WHEN L.DS_TRANSFORMATION = '' THEN 1  &#10;                 WHEN V.ID_DIGITAL_APP IS NOT NULL THEN 1&#10;                 ELSE 0 END) AS FL_DIGITAL_APP_VALID,&#10;&#9;&#10;    (CASE WHEN (&#10;        SELECT CD_KEY FROM SE.SE_TAG_NAME_TRIGRAM WHERE CD_KEY = SUBSTR(L.DS_TAG_RENAMED, 1, 3) AND DS_LEVEL ='1-SYS') IS NOT NULL&#10;    THEN 1&#10;    ELSE 0&#10;    END) AS SYSTEM,&#10;    (CASE WHEN (&#10;        SELECT CD_KEY FROM SE.SE_TAG_NAME_TRIGRAM WHERE CD_KEY = SUBSTR(L.DS_TAG_RENAMED, 5, 3) AND DS_LEVEL ='2-SUB') IS NOT NULL&#10;    THEN 1&#10;    ELSE 0&#10;    END) AS SUB,&#10;    (CASE WHEN (&#10;        SELECT CD_KEY FROM SE.SE_TAG_NAME_TRIGRAM WHERE CD_KEY = SUBSTR(L.DS_TAG_RENAMED, 9, 3) AND DS_LEVEL ='3-Measure') IS NOT NULL&#10;    THEN 1&#10;    ELSE 0&#10;    END) AS MEASURE,&#10;    (CASE WHEN (&#10;        SELECT CD_KEY FROM SE.SE_TAG_NAME_TRIGRAM WHERE CD_KEY = SUBSTR(L.DS_TAG_RENAMED, 13, 3) AND DS_LEVEL ='4-TypeRef') IS NOT NULL&#10;    THEN 1&#10;    ELSE 0&#10;    END) AS TYPE,&#10;&#10;    L.FL_REALTIME,&#10;    L.FL_ARCHIVE,&#10;    T.ID_TAG,&#10;    M.ID_PCO_DESTINATION,&#10;    (SELECT&#10;        sbf.ID_PLANT_HIERARCHY&#10;    FROM &#10;        SE.SE_PLANT_HIERARCHY sbf&#10;        INNER JOIN SE.SE_PLANT_HIERARCHY mnf ON sbf.ID_PARENT = mnf.ID_PLANT_HIERARCHY&#10;        INNER JOIN SE.SE_PLANT_HIERARCHY prm ON mnf.ID_PARENT = prm.ID_PLANT_HIERARCHY&#10;        INNER JOIN SE.SE_PLANT_HIERARCHY bld ON prm.ID_PARENT = bld.ID_PLANT_HIERARCHY&#10;        INNER JOIN SE.SE_PLANT_HIERARCHY loc ON bld.ID_PARENT = loc.ID_PLANT_HIERARCHY&#10;        INNER JOIN SE.SE_PLANT P2 ON P.DS_SEMARCHY_LOCATION_ID = loc.ID_PLANT_HIERARCHY&#10;    WHERE   &#10;        loc.DS_NAME = SUBSTR(L.DS_PLANT_HIERARCHY, 1, 3) AND loc.FL_ACTIVE = '1' AND&#10;        bld.DS_NAME = SUBSTR(L.DS_PLANT_HIERARCHY, 4, 4) AND bld.FL_ACTIVE = '1' AND&#10;        prm.DS_NAME = SUBSTR(L.DS_PLANT_HIERARCHY, 9, 6) AND prm.FL_ACTIVE = '1' AND&#10;        mnf.DS_NAME = SUBSTR(L.DS_PLANT_HIERARCHY, 16, 7) AND mnf.FL_ACTIVE = '1' AND&#10;        sbf.DS_NAME = SUBSTR(L.DS_PLANT_HIERARCHY, 24, 7) AND sbf.FL_ACTIVE = '1' AND&#10;        P2.ID_PLANT = P.ID_PLANT) AS ID_PLANT_HIERARCHY,&#10;    L.DS_PLANT_HIERARCHY,&#10;    L.DS_COMMENT&#10;&#9;&#10;FROM&#10;    &#10;    SE.SE_TAG_IMPORT_LOG L&#10;    LEFT OUTER JOIN SE.SE_PLANT P ON P.DS_NAME = L.DS_PLANT &#10;    LEFT OUTER JOIN SE.SE_UOM U ON U.DS_NAME = L.DS_UOM&#10;    LEFT OUTER JOIN SE.SE_SOURCE S ON S.ID_PLANT = P.ID_PLANT AND S.DS_NAME = L.DS_SOURCE  &#10;    LEFT OUTER JOIN SE.SE_TAG T ON S.ID_SOURCE = T.ID_SOURCE AND T.DS_NAME_ORIGINAL = L.DS_TAG_ORIGINAL&#10;    LEFT OUTER JOIN SE.SE_TAG_MAPPING M ON T.ID_TAG = M.ID_TAG&#10;    LEFT OUTER JOIN SE.SE_TAG_MAPPING_APP A ON A.ID_TAG = M.ID_TAG AND A.ID_DIGITAL_APP = L.DS_DIGITAL_APP &#10;    LEFT OUTER JOIN SE.SE_APP_TRANSFORMATION V ON V.ID_DIGITAL_APP = L.DS_DIGITAL_APP AND V.ID_TRANSFORMATION = L.DS_TRANSFORMATION &#10;WHERE &#10;    L.DS_STATUS = 'P' AND&#10;    L.ID_IMPORT = [Param.1]&#10;ORDER BY&#10;    L.DT_INSERTED ASC&#10;" QueryParams="" ReaderRoles="SAP_XMII_User" RestrictedPropertyOverride="false" ResultSetMode="false" RowCount="200000" SaveDate="08/16/2023 18:04:24" Schedule="" SelectedColumns="" Server="Z_STREAMING_ENGINE" Service="" SetMaxRows="true" SortExpr="" StartDate="" Tables="" Time="" TimePeriod="" Trace="false" TransformerLibrary="" UseTypedParams="T" UserName="" Version="15.5.1.41" WriterRoles="SAP_XMII_Super_Administrator,SAP_XMII_Administrator,SAP_XMII_Developer" XParamName.1="" XParamName.10="" XParamName.11="" XParamName.12="" XParamName.13="" XParamName.14="" XParamName.15="" XParamName.16="" XParamName.2="" XParamName.3="" XParamName.4="" XParamName.5="" XParamName.6="" XParamName.7="" XParamName.8="" XParamName.9="" XParamValue.1="" XParamValue.10="" XParamValue.11="" XParamValue.12="" XParamValue.13="" XParamValue.14="" XParamValue.15="" XParamValue.16="" XParamValue.2="" XParamValue.3="" XParamValue.4="" XParamValue.5="" XParamValue.6="" XParamValue.7="" XParamValue.8="" XParamValue.9="" XmlDateFormat="yyyy-MM-dd'T'HH:mm:ss" XmlNumberFormat=""><Tasks/><ETCServers/><ETCObjects/></SQLQuery>