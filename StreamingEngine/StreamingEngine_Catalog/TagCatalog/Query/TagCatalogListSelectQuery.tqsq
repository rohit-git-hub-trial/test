<?xml version="1.0" encoding="UTF-8" standalone="no"?><SQLQuery AllowBuffering="false" AllowFuture="true" AllowNullValues="false" AutoCommit="false" AutoTypeParameters="false" CacheDuration="0" CacheDurationUnits="M" Columns="" Comment="" Connector="" DateColumn="" DateFormat="MM/dd/yyyy HH:mm:ss" Debug="false" Description="" DocType="SQLQuery" Duration="60" DurationUnits="M" EndDate="" FilterExpr="" FixedQuery="" GroupingExpr="" HanaDataSource="true" ID="3228" InlineTransform="" IntervalCount="1" IsCachable="false" JoinExpr="" Mask="" Method="" Mode="FixedQuery" NumberFormat="0.00" Param.1="" Param.10="" Param.11="" Param.12="" Param.13="" Param.14="" Param.15="" Param.16="" Param.17="" Param.18="" Param.19="" Param.2="" Param.20="" Param.21="" Param.22="" Param.23="" Param.24="" Param.25="" Param.26="" Param.27="" Param.28="" Param.29="" Param.3="" Param.30="0" Param.31="T.FL_WATCH_DATA_CAPTURE DESC,T2.ID_SOURCE DESC,T.ID_SOURCE ASC,T.DS_NAME_ORIGINAL ASC" Param.32="" Param.4="" Param.5="" Param.6="" Param.7="" Param.8="" Param.9="" ParamDescription.1="" ParamDescription.10="" ParamDescription.11="" ParamDescription.12="" ParamDescription.13="" ParamDescription.14="" ParamDescription.15="" ParamDescription.16="" ParamDescription.17="" ParamDescription.18="" ParamDescription.19="" ParamDescription.2="" ParamDescription.20="" ParamDescription.21="" ParamDescription.22="" ParamDescription.23="" ParamDescription.24="" ParamDescription.25="" ParamDescription.26="" ParamDescription.27="" ParamDescription.28="" ParamDescription.29="" ParamDescription.3="" ParamDescription.30="Default Offset " ParamDescription.31="Default Order By" ParamDescription.32="" ParamDescription.4="" ParamDescription.5="" ParamDescription.6="" ParamDescription.7="" ParamDescription.8="" ParamDescription.9="" ParamType.1="" ParamType.10="" ParamType.11="" ParamType.12="" ParamType.13="" ParamType.14="" ParamType.15="" ParamType.16="" ParamType.17="" ParamType.18="" ParamType.19="" ParamType.2="" ParamType.20="" ParamType.21="" ParamType.22="" ParamType.23="" ParamType.24="" ParamType.25="" ParamType.26="" ParamType.27="" ParamType.28="" ParamType.29="" ParamType.3="" ParamType.30="" ParamType.31="" ParamType.32="" ParamType.4="" ParamType.5="" ParamType.6="" ParamType.7="" ParamType.8="" ParamType.9="" Password="" PathID="861" Query="SELECT &#10;    T.ID_TAG,&#10;    T.ID_SOURCE,&#10;    T.ID_PLANT_HIERARCHY,&#10;    P.ID_PLANT,&#10;    P.DS_NAME AS PLANT,&#10;    T.DS_NAME_ORIGINAL,&#10;    T.DS_NAME_RENAMED,&#10;    T.DS_DESCRIPTION,&#10;    T.ID_UOM,&#10;    D.DS_DESCRIPTION AS PCO_DESTINATION,&#10;    D.ID_PCO_DESTINATION,&#10;    S.DS_NAME AS SOURCE_NAME,&#10;    S.DS_MII_DATA_SERVER_PROCESS,&#10;&#10;    (CASE &#10;        WHEN sbf.ID_PLANT_HIERARCHY IS NOT NULL THEN &#10;            loc.ID_PLANT_HIERARCHY || '-' || bld.ID_PLANT_HIERARCHY || '-' || prm.ID_PLANT_HIERARCHY || '-' || mnf.ID_PLANT_HIERARCHY || '-' || sbf.ID_PLANT_HIERARCHY &#10;        ELSE NULL &#10;    END) AS PLANT_HIERARCHY_ID,&#10;&#10;    (CASE &#10;        WHEN sbf.ID_PLANT_HIERARCHY IS NOT NULL THEN &#10;            loc.DS_NAME || bld.DS_NAME || '-' || prm.DS_NAME || '-' || mnf.DS_NAME || '-' || sbf.DS_NAME &#10;        ELSE NULL &#10;    END) AS PLANT_HIERARCHY,&#10;&#10;    (CASE &#10;        WHEN S.FL_REALTIME = 1 AND D.ID_DESTINATION_TYPE = 'REST' &#10;        THEN M.ID_AGENT &#10;        ELSE 'NA' &#10;    END) AS ID_AGENT,&#10;&#10;    (CASE &#10;        WHEN S.FL_ARCHIVE = 1 &#10;        THEN M.ID_JOB &#10;        ELSE 'NA' &#10;    END) AS ID_JOB,&#10;&#10;    (CASE &#10;        WHEN S.FL_REALTIME = 1 AND D.ID_DESTINATION_TYPE = 'REST' &#10;        THEN (CASE WHEN M.ID_AGENT IS NOT NULL THEN 1 ELSE 0 END) &#10;        ELSE 0 &#10;    END) AS FLAG_REALTIME,&#10;&#10;    (CASE &#10;        WHEN S.FL_ARCHIVE = 1 OR S.FL_ENERGY = 1 &#10;        THEN (CASE WHEN M.ID_JOB IS NOT NULL THEN 1 ELSE 0 END) &#10;        ELSE 0 &#10;    END) AS FLAG_ARCHIVE,&#10;&#10;    (CASE &#10;        WHEN T.FL_WATCH_DATA_CAPTURE = '1' THEN 'watch'  &#10;        ELSE (&#10;            CASE &#10;                WHEN T2.ID_TAG IS NOT NULL THEN 'load'  &#10;                ELSE (&#10;                    CASE &#10;                        WHEN (&#10;                            T.DS_NAME_RENAMED IS NOT NULL &#10;                            AND T.ID_PLANT_HIERARCHY IS NOT NULL &#10;                            AND (M.ID_AGENT IS NOT NULL OR M.ID_JOB IS NOT NULL) &#10;                            AND EXISTS (&#10;                                SELECT 1 &#10;                                FROM SE.SE_TAG_MAPPING_APP T3 &#10;                                WHERE T3.ID_TAG = T.ID_TAG&#10;                            )&#10;                        ) THEN 'green' &#10;                        ELSE (&#10;                            CASE &#10;                                WHEN (&#10;                                    T.DS_NAME_RENAMED IS NOT NULL &#10;                                    OR T.ID_PLANT_HIERARCHY IS NOT NULL &#10;                                    OR (M.ID_AGENT IS NOT NULL OR M.ID_JOB IS NOT NULL) &#10;                                    OR EXISTS (&#10;                                        SELECT 1 &#10;                                        FROM SE.SE_TAG_MAPPING_APP T3 &#10;                                        WHERE T3.ID_TAG = T.ID_TAG&#10;                                    )&#10;                                ) THEN 'yellow' &#10;                                ELSE NULL &#10;                            END&#10;                        )  &#10;                    END&#10;                )  &#10;            END&#10;        ) &#10;    END) AS COLOR_STATUS,&#10;&#10;    T.FL_HIDDEN,&#10;    ADD_DAYS(T.DT_WATCH_ENABLED, P.QT_WATCH_EXP_CAPTURE_DAYS) AS LIMIT_CAPTURE,&#10;    ADD_DAYS(T.DT_WATCH_ENABLED, P.QT_WATCH_EXP_VISUAL_DAYS) AS LIMIT_VISUALIZATION,&#10;    T.FL_WATCH_DATA_CAPTURE, &#10;    T.FL_WATCH_VISUALIZATION,&#10;    T.FL_SEND_DATA_AFTER_WATCH,&#10;    S.FL_ENERGY&#10;&#10;FROM &#10;    SE.SE_TAG T&#10;    INNER JOIN SE.SE_SOURCE S ON S.ID_SOURCE = T.ID_SOURCE&#10;    INNER JOIN SE.SE_PLANT P ON S.ID_PLANT = P.ID_PLANT&#10;&#10;    LEFT OUTER JOIN SE.SE_PLANT_HIERARCHY sbf ON sbf.ID_PLANT_HIERARCHY = T.ID_PLANT_HIERARCHY&#10;    LEFT OUTER JOIN SE.SE_PLANT_HIERARCHY mnf ON sbf.ID_PARENT = mnf.ID_PLANT_HIERARCHY&#10;    LEFT OUTER JOIN SE.SE_PLANT_HIERARCHY prm ON mnf.ID_PARENT = prm.ID_PLANT_HIERARCHY&#10;    LEFT OUTER JOIN SE.SE_PLANT_HIERARCHY bld ON prm.ID_PARENT = bld.ID_PLANT_HIERARCHY&#10;    LEFT OUTER JOIN SE.SE_PLANT_HIERARCHY loc ON bld.ID_PARENT = loc.ID_PLANT_HIERARCHY&#10;&#10;    LEFT OUTER JOIN SE.SE_TAG_MAPPING M ON M.ID_TAG = T.ID_TAG&#10;    LEFT OUTER JOIN SE.SE_PCO_DESTINATION D &#10;        ON D.ID_PCO_DESTINATION = M.ID_PCO_DESTINATION &#10;        AND D.ID_DESTINATION_TYPE = 'REST'&#10;&#10;    LEFT OUTER JOIN SE.SE_TAG T2 ON T2.ID_INITIAL_LOAD_PARENT = T.ID_TAG&#10;&#10;WHERE&#10;    [Param.1]&#10;    [Param.2]&#10;    [Param.3]&#10;    [Param.4]&#10;    [Param.5]&#10;    [Param.6]&#10;    [Param.7]&#10;    [Param.8]&#10;    [Param.9]&#10;    S.FL_ENABLED = 1 &#10;    AND S.ID_INITIAL_LOAD_PARENT IS NULL&#10;    AND T.ID_INITIAL_LOAD_PARENT IS NULL&#10;    AND (&#10;        S.ID_PLANT IN (&#10;            SELECT RESULT &#10;            FROM SQLSCRIPT_STRING:SPLIT_TO_TABLE('[Param.20]',',')&#10;        ) &#10;        OR '[Param.20]' = '*'&#10;    )&#10;&#10;ORDER BY [Param.31]&#10;LIMIT 500 OFFSET [Param.30];&#10; " QueryParams="" ReaderRoles="SAP_XMII_User" RestrictedPropertyOverride="false" ResultSetMode="false" RowCount="5000" SaveDate="05/05/2026 15:49:59" Schedule="" SelectedColumns="" Server="Z_STREAMING_ENGINE" Service="" SetMaxRows="true" SortExpr="" StartDate="" Tables="" Time="" TimePeriod="" Trace="false" TransformerLibrary="" UseTypedParams="false" UserName="" Version="15.5.1.41" WriterRoles="SAP_XMII_Super_Administrator,SAP_XMII_Administrator,SAP_XMII_Developer" XParamName.1="" XParamName.10="" XParamName.11="" XParamName.12="" XParamName.13="" XParamName.14="" XParamName.15="" XParamName.16="" XParamName.2="" XParamName.3="" XParamName.4="" XParamName.5="" XParamName.6="" XParamName.7="" XParamName.8="" XParamName.9="" XParamValue.1="" XParamValue.10="" XParamValue.11="" XParamValue.12="" XParamValue.13="" XParamValue.14="" XParamValue.15="" XParamValue.16="" XParamValue.2="" XParamValue.3="" XParamValue.4="" XParamValue.5="" XParamValue.6="" XParamValue.7="" XParamValue.8="" XParamValue.9="" XmlDateFormat="yyyy-MM-dd'T'HH:mm:ss" XmlNumberFormat=""><Tasks/><ETCServers/><ETCObjects/></SQLQuery>