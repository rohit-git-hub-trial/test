&#13;
    &lt;!-- Unique key based on PLANT + SOURCE + AGENT + QT_TAG_COUNT --&gt;&#13;
    &lt;xsl:key match="Rowset/Row" name="uniqueKey" use="concat(PLANT,'|',SOURCE,'|',AGENT,'|',QT_TAG_COUNT)"/&gt;&#13;
&#13;
    &lt;xsl:template match="/"&gt;&#13;
        &lt;Rowsets&gt;&#13;
            &lt;Rowset&gt;&#13;
&#13;
                &lt;!-- Copy COLUMNS --&gt;&#13;
                &lt;Columns&gt;&#13;
                    &lt;xsl:copy-of select="//Columns/*"/&gt;&#13;
                &lt;/Columns&gt;&#13;
&#13;
                &lt;!-- Keep only unique combinations --&gt;&#13;
                &lt;xsl:for-each select="//Rowset/Row[                     generate-id() =                     generate-id(                         key(                             'uniqueKey',                             concat(PLANT,'|',SOURCE,'|',AGENT,'|',QT_TAG_COUNT)                         )[1]                     )                 ]"&gt;&#13;
&#13;
                    &lt;Row&gt;&#13;
&#13;
                        &lt;!-- Reassign ROW_ID --&gt;&#13;
                        &lt;ROW_ID&gt;&#13;
                            &lt;xsl:value-of select="position()"/&gt;&#13;
                        &lt;/ROW_ID&gt;&#13;
&#13;
                        &lt;!-- Copy all fields except original ROW_ID --&gt;&#13;
                        &lt;xsl:copy-of select="*[name()!='ROW_ID']"/&gt;&#13;
&#13;
                    &lt;/Row&gt;&#13;
&#13;
                &lt;/xsl:for-each&gt;&#13;
&#13;
            &lt;/Rowset&gt;&#13;
        &lt;/Rowsets&gt;&#13;
