&#13;
  &lt;xsl:param name="pcoAgentsList" select="''"/&gt;&#13;
  &lt;xsl:param name="seAgentsList" select="''"/&gt;&#13;
&#13;
  &lt;xsl:template match="/"&gt;&#13;
    &lt;result&gt;&#13;
      &lt;xsl:call-template name="comparePcoAndSeDestinations"&gt;&#13;
        &lt;xsl:with-param name="pcoAgentsList" select="$pcoAgentsList"/&gt;&#13;
        &lt;xsl:with-param name="seAgentsList" select="$seAgentsList"/&gt;&#13;
      &lt;/xsl:call-template&gt;&#13;
    &lt;/result&gt;&#13;
  &lt;/xsl:template&gt;&#13;
&#13;
  &lt;xsl:template name="comparePcoAndSeDestinations"&gt;&#13;
    &lt;xsl:param name="pcoAgentsList"/&gt;&#13;
    &lt;xsl:param name="seAgentsList"/&gt;&#13;
&#13;
    &lt;xsl:variable name="pcoAgents" select="tokenize($pcoAgentsList, ',')"/&gt;&#13;
    &lt;xsl:variable name="seAgents" select="tokenize($seAgentsList, ',')"/&gt;&#13;
&#13;
    &lt;xsl:variable name="uniqueItemsPcoAgents" select="$pcoAgents[not(. = $seAgents)]"/&gt;&#13;
    &lt;xsl:variable name="uniqueItemsSeAgents" select="$seAgents[not(. = $pcoAgents)]"/&gt;&#13;
&#13;
    &lt;comparison&gt;&#13;
      &lt;uniqueItemsPcoAgents&gt;&#13;
        &lt;xsl:for-each select="$uniqueItemsPcoAgents"&gt;&#13;
          &lt;item&gt;&#13;
              &lt;xsl:value-of select="."/&gt;&#13;
          &lt;/item&gt;&#13;
        &lt;/xsl:for-each&gt;&#13;
      &lt;/uniqueItemsPcoAgents&gt;&#13;
      &lt;uniqueItemsSeAgents&gt;&#13;
        &lt;xsl:for-each select="$uniqueItemsSeAgents"&gt;&#13;
          &lt;item&gt;&#13;
              &lt;xsl:value-of select="."/&gt;&#13;
           &lt;/item&gt;&#13;
        &lt;/xsl:for-each&gt;&#13;
      &lt;/uniqueItemsSeAgents&gt;&#13;
    &lt;/comparison&gt;&#13;
  &lt;/xsl:template&gt;&#13;
&#13;
&lt;/xsl:stylesheet&gt;</Value><SchemaURI/><SchemaElement/><ValidateXMLOnExecution>1</ValidateXMLOnExecution><ReadOnly>false</ReadOnly><AlertXMLAssigned>false</AlertXMLAssigned></ContextItem><ContextItem><Name>T_GetSePCoAgents</Name><Description/><MinRange>0</MinRange><MaxRange>0</MaxRange><Value xsi:type="xml"><ReferenceDocumentSource/>&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:a="urn:sap.com:pco.contracts" exclude-result-prefixes="a" version="1.0"&gt;&#13;
