    &lt;xsl:element name="FilteredAgents"&gt;&#13;
      &lt;xsl:apply-templates select="//a:PCoRuntimeInfo[starts-with(a:Name, $pcoPoolPrefix)]"/&gt;&#13;
    &lt;/xsl:element&gt;&#13;
  &lt;/xsl:template&gt;&#13;
&#13;
