        &lt;xsl:output indent="yes" omit-xml-declaration="yes"/&gt;&#13;
        &lt;xsl:strip-space elements="*"/&gt;&#13;
&#13;
        &lt;xsl:variable name="vApos"&gt;'&lt;/xsl:variable&gt;&#13;
&#13;
        &lt;xsl:template match="*[@* or not(*)] "&gt;&#13;
		 &#13;
          &lt;xsl:if test="not(*)"&gt;&#13;
		  &#13;
             &lt;xsl:apply-templates mode="path" select="ancestor-or-self::*"/&gt;&#13;
             &lt;xsl:text&gt;&#13;
&lt;/xsl:text&gt;&#13;
            &lt;/xsl:if&gt;&#13;
            &lt;xsl:apply-templates select="@*|*"/&gt;&#13;
        &lt;/xsl:template&gt;&#13;
&#13;
        &lt;xsl:template match="*" mode="path"&gt;&#13;
            &lt;xsl:value-of select="concat('/',name())"/&gt;&#13;
           &lt;xsl:variable name="vnumSiblings" select="count(../*[name()=name(current())])"/&gt;&#13;
            &lt;xsl:if test="$vnumSiblings &amp;gt; 1"&gt;&#13;
                &lt;xsl:value-of select="concat('[',                          count(preceding-sibling::*                                 [name()=name(current())]) +1,                          ']')"/&gt;&#13;
            &lt;/xsl:if&gt; &#13;
        &lt;/xsl:template&gt;&#13;
&#13;
   &lt;xsl:template match="@*"&gt;&#13;
            &lt;xsl:apply-templates mode="path" select="../ancestor-or-self::*"/&gt;&#13;
            &lt;xsl:value-of select="concat('[@',name(), '=',$vApos,.,$vApos,']')"/&gt;&#13;
            &lt;xsl:text&gt;&#13;
&lt;/xsl:text&gt;&#13;
        &lt;/xsl:template&gt;&#13;
