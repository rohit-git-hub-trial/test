</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Transaction.PostFailedFlag</To><From>false</From></Assign></OutgoingLinks></Action></Actions></Step><Step xsi:type="Catch"><Name>ERROR_HANDLE_POST</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_2</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>UPDATE_ERROR_MSG</Name><Description/><Steps/><Actions><Action><Name>AssignErrorMsg</Name><Description> </Description><Expiration/><IncomingLinks/><OutgoingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Transaction.ResponseErrorMessage</To><From>Catch_Post.Source &amp; " | " &amp; Catch_Post.ActionType &amp; " | " &amp; Catch_Post.Message  &amp; " | " &amp;  OData_Service.StatusText  &amp; " | " &amp; OData_Service.ReturnAsString</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Transaction.PostFailedFlag</To><From>true</From></Assign></OutgoingLinks></Action></Actions></Step></Steps><Actions><Action><Name>LogSaver</Name><Description> </Description><Expiration/><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver.LogModuleId</To><From>"StreamingEngine"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver.LogSeverity</To><From>"E"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver.LogUser</To><From>username</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver.LogTransactionName</To><From>transactionpath</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver.MessageTitle</To><From>"API destination transaction failed"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver.MessageDescription</To><From>"[" &amp; Catch_Post.ExceptionType &amp; "] - " &amp; Catch_Post.Message</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>LogSaver.LogActionBlockName</To><From>Catch_Post.Source</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>Catch_Post</Name><Description>Catches an exception</Description><Expiration>UPDATE_ERROR_MSG</Expiration><IncomingLinks/><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>Init_Variables</Name><Description> </Description><Expiration>Prepare_Req_Properties</Expiration><IncomingLinks/><OutgoingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Transaction.PostFailedFlag</To><From>false</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Transaction.ResponseErrorMessage</To><From>""</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Transaction.ResponseSuccessMessage</To><From>""</From></Assign></OutgoingLinks></Action></Actions></Step></Steps><Actions/></Step></Steps></Transaction>