&lt;/GetDestinationSystemsResponse&gt;</Value><SchemaURI/><SchemaElement/><ValidateXMLOnExecution>1</ValidateXMLOnExecution><ReadOnly>false</ReadOnly><AlertXMLAssigned>false</AlertXMLAssigned></ContextItem><ContextItem><Name>SEDestinations</Name><Description/><MinRange>0</MinRange><MaxRange>0</MaxRange><Value xsi:type="xml"><ReferenceDocumentSource/></Value><SchemaURI/><SchemaElement/><ValidateXMLOnExecution>1</ValidateXMLOnExecution><ReadOnly>false</ReadOnly><AlertXMLAssigned>false</AlertXMLAssigned></ContextItem><ContextItem><Name>StreamingEnginePCoDestinations</Name><Description/><MinRange>0</MinRange><MaxRange>0</MaxRange><Value xsi:type="string"/><ReadOnly>false</ReadOnly><AlertXMLAssigned>false</AlertXMLAssigned></ContextItem><ContextItem><Name>StreamingEngineSavedDestinations</Name><Description/><MinRange>0</MinRange><MaxRange>0</MaxRange><Value xsi:type="string"/><ReadOnly>false</ReadOnly><AlertXMLAssigned>false</AlertXMLAssigned></ContextItem><ContextItem><Name>T_CompareDestinationLists</Name><Description/><MinRange>0</MinRange><MaxRange>0</MaxRange><Value xsi:type="xml"><ReferenceDocumentSource/>&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" version="1.0"&gt;&#13;
&#13;
  &lt;xsl:param name="pcoDestinationsList" select="''"/&gt;&#13;
  &lt;xsl:param name="seDestinationsList" select="''"/&gt;&#13;
&#13;
  &lt;xsl:template match="/"&gt;&#13;
    &lt;result&gt;&#13;
      &lt;xsl:call-template name="comparePcoAndSeDestinations"&gt;&#13;
        &lt;xsl:with-param name="pcoDestinationsList" select="$pcoDestinationsList"/&gt;&#13;
        &lt;xsl:with-param name="seDestinationsList" select="$seDestinationsList"/&gt;&#13;
      &lt;/xsl:call-template&gt;&#13;
    &lt;/result&gt;&#13;
  &lt;/xsl:template&gt;&#13;
&#13;
  &lt;xsl:template name="comparePcoAndSeDestinations"&gt;&#13;
    &lt;xsl:param name="pcoDestinationsList"/&gt;&#13;
    &lt;xsl:param name="seDestinationsList"/&gt;&#13;
&#13;
    &lt;xsl:variable name="pcoDestinations" select="tokenize($pcoDestinationsList, ',')"/&gt;&#13;
    &lt;xsl:variable name="seDestinations" select="tokenize($seDestinationsList, ',')"/&gt;&#13;
&#13;
    &lt;xsl:variable name="commonItems" select="$pcoDestinations[. = $seDestinations]"/&gt;&#13;
    &lt;xsl:variable name="uniqueItemsPcoDestinations" select="$pcoDestinations[not(. = $seDestinations)]"/&gt;&#13;
    &lt;xsl:variable name="uniqueItemsSeDestinations" select="$seDestinations[not(. = $pcoDestinations)]"/&gt;&#13;
&#13;
    &lt;comparison&gt;&#13;
      &lt;commonItems&gt;&#13;
        &lt;xsl:for-each select="$commonItems"&gt;&#13;
          &lt;item&gt;&#13;
             &lt;xsl:value-of select="."/&gt;&#13;
          &lt;/item&gt;&#13;
        &lt;/xsl:for-each&gt;&#13;
      &lt;/commonItems&gt;&#13;
      &lt;uniqueItemsPcoDestinations&gt;&#13;
        &lt;xsl:for-each select="$uniqueItemsPcoDestinations"&gt;&#13;
          &lt;item&gt;&#13;
              &lt;xsl:value-of select="."/&gt;&#13;
          &lt;/item&gt;&#13;
        &lt;/xsl:for-each&gt;&#13;
      &lt;/uniqueItemsPcoDestinations&gt;&#13;
      &lt;uniqueItemsSeDestinations&gt;&#13;
        &lt;xsl:for-each select="$uniqueItemsSeDestinations"&gt;&#13;
          &lt;item&gt;&#13;
              &lt;xsl:value-of select="."/&gt;&#13;
           &lt;/item&gt;&#13;
        &lt;/xsl:for-each&gt;&#13;
      &lt;/uniqueItemsSeDestinations&gt;&#13;
    &lt;/comparison&gt;&#13;
  &lt;/xsl:template&gt;&#13;
&#13;
&lt;/xsl:stylesheet&gt;</Value><SchemaURI/><SchemaElement/><ValidateXMLOnExecution>1</ValidateXMLOnExecution><ReadOnly>false</ReadOnly><AlertXMLAssigned>false</AlertXMLAssigned></ContextItem><ContextItem><Name>T_GetDestinationSystemsResult</Name><Description/><MinRange>0</MinRange><MaxRange>0</MaxRange><Value xsi:type="xml"><ReferenceDocumentSource/>&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:a="urn:sap.com:pco.contracts" exclude-result-prefixes="a" version="1.0"&gt;&#13;
&#13;
  &lt;xsl:output indent="yes" method="xml"/&gt;&#13;
&#13;
  &lt;xsl:template match="/"&gt;&#13;
    &lt;xsl:element name="FilteredDestinationSystems"&gt;&#13;
      &lt;xsl:apply-templates select="//a:DestinationSystemName[starts-with(a:Name, 'StreamingEngine')]"/&gt;&#13;
    &lt;/xsl:element&gt;&#13;
  &lt;/xsl:template&gt;&#13;
&#13;
  &lt;xsl:template match="a:DestinationSystemName"&gt;&#13;
    &lt;DestinationSystemName&gt;&#13;
		&lt;Name&gt; &#13;
			&lt;xsl:value-of select="./a:Name"/&gt; &#13;
		&lt;/Name&gt;&#13;
		&lt;Description&gt;&#13;
			&lt;xsl:value-of select="./a:Description"/&gt; &#13;
		&lt;/Description&gt;&#13;
	&lt;/DestinationSystemName&gt;   &#13;
  &lt;/xsl:template&gt;&#13;
&#13;
