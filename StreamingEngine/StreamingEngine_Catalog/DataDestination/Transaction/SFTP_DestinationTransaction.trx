Transaction.FilePath &amp; lf &amp; 
Local.GUID &amp; lf &amp; 
")" &amp; lf &amp;
"user=$(cat &lt;&lt; " &amp; Local.GUID &amp; lf &amp; 
Transaction.FileCredentialAlias &amp; lf &amp; 
Local.GUID &amp; lf &amp; 
")" &amp; lf &amp;
"sftp -v -i key -o StrictHostKeyChecking=no -q -P " &amp; DestinationSFTPParamsSelectQuery.Results{/Rowsets/Rowset/Row/PORT} &amp; " \"$user\"@" &amp; DestinationSFTPParamsSelectQuery.Results{/Rowsets/Rowset/Row/SERVER}&amp; ":\"$path\" &lt;&lt; EOF" &amp; lf &amp;
stringif(Transaction.MultiFile, "put \"" &amp; stringreplace(Transaction.FileName, lf, "\"" &amp; lf &amp; "put \"") &amp; "\"", "put \"" &amp; Transaction.FileName &amp; "\"" ) &amp; lf &amp;
"bye
EOF
" </From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions><Action><Name>Create_Working_Directory</Name><Description>Simple Process Run</Description><Expiration>Sequence_13</Expiration><IncomingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Create_Working_Directory.DirPath</To><From>"/tmp"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Create_Working_Directory.Process</To><From>"mkdir"</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Create_Working_Directory.Args1</To><From>"SE-SFTP-" &amp; Local.GUID</From></Assign><Assign xsi:type="Assign"><Name/><Description/><To>Create_Working_Directory.Args2</To><From>"key"</From></Assign></IncomingLinks><OutgoingLinks/></Action></Actions></Step></Steps><Actions/></Step><Step xsi:type="ActionSequence"><Name>RUN_SCRIPT</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_16</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_20</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_23</Name><Description/><Steps><Step xsi:type="Conditional"><Name>Sequence_17</Name><Description/><Steps><Step xsi:type="ActionSequence"><Name>Sequence_9</Name><Description/><Steps/><Actions><Action><Name>AssignmentSuccess</Name><Description> </Description><Expiration>Sequence_19</Expiration><IncomingLinks/><OutgoingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Transaction.ResponseSuccessMsg</To><From>"File sent to destination successfully"</From></Assign></OutgoingLinks></Action></Actions></Step><Step xsi:type="ActionSequence"><Name>Sequence_19</Name><Description/><Steps/><Actions><Action><Name>AssignmentError_1</Name><Description> </Description><Expiration>CLEAN_UP</Expiration><IncomingLinks/><OutgoingLinks><Assign xsi:type="Assign"><Name/><Description/><To>Transaction.ResponseErrorMsg</To><From>"SFTP Script Failed! " &amp; lf &amp;
