        &lt;Row&gt;&#13;
            &lt;QUERYMODE&gt;FixedQuery&lt;/QUERYMODE&gt;&#13;
            &lt;PARAM1/&gt;&#13;
            &lt;PARAM2/&gt;&#13;
            &lt;PARAM3/&gt;&#13;
            &lt;PARAM4/&gt;&#13;
            &lt;PARAM5/&gt;&#13;
            &lt;PARAM6/&gt;&#13;
            &lt;PARAM7/&gt;&#13;
            &lt;PARAM8/&gt;&#13;
            &lt;PARAM9/&gt;&#13;
            &lt;PARAM10/&gt;&#13;
            &lt;PARAM11/&gt;&#13;
            &lt;PARAM12/&gt;&#13;
            &lt;PARAM13/&gt;&#13;
            &lt;PARAM14/&gt;&#13;
            &lt;PARAM15/&gt;&#13;
            &lt;PARAM16/&gt;&#13;
            &lt;PARAM17/&gt;&#13;
            &lt;PARAM18/&gt;&#13;
            &lt;PARAM19/&gt;&#13;
            &lt;PARAM20/&gt;&#13;
            &lt;PARAM21/&gt;&#13;
            &lt;PARAM22/&gt;&#13;
            &lt;PARAM23/&gt;&#13;
            &lt;PARAM24/&gt;&#13;
            &lt;PARAM25/&gt;&#13;
            &lt;PARAM26/&gt;&#13;
            &lt;PARAM27/&gt;&#13;
            &lt;PARAM28/&gt;&#13;
            &lt;PARAM29/&gt;&#13;
            &lt;PARAM30/&gt;&#13;
            &lt;PARAM31/&gt;&#13;
            &lt;PARAM32/&gt;&#13;
            &lt;ROWCOUNTER&gt;101&lt;/ROWCOUNTER&gt;&#13;
            &lt;SERVER&gt;Z_OEE&lt;/SERVER&gt;&#13;
            &lt;QUERY&gt;SELECT &#13;
	*&#13;
FROM (&#13;
	SELECT&#13;
		SUM(EFFEC_DURATION) AS TOTAL_DURATION,&#13;
		DESCRIPTION RCM&#13;
	FROM (&#13;
		SELECT&#13;
			SECONDS_BETWEEN(START_TIMESTAMP, IFNULL(END_TIMESTAMP, CURRENT_UTCTIMESTAMP)) REAL_EFFEC_DURATION,&#13;
			SECONDS_BETWEEN(&#13;
				GREATEST(START_TIMESTAMP, ADD_SECONDS(CURRENT_UTCTIMESTAMP,-3600* '[Param.4]')), &#13;
				IFNULL(END_TIMESTAMP, CURRENT_UTCTIMESTAMP)&#13;
			) EFFEC_DURATION, &#13;
		NM_NODE_ID RCM_NODE_ID	&#13;
		FROM&#13;
			EOEE.VW_PROD_EVENT_AND_NODE_MAP &#13;
		WHERE&#13;
			CLIENT = '[Param.1]' AND&#13;
			PLANT =  '[Param.2]' AND&#13;
			NODE_ID = '[Param.3]' AND&#13;
			(&#13;
			(START_TIMESTAMP &amp;lt;= ADD_SECONDS(CURRENT_UTCTIMESTAMP,-3600* '[Param.4]') AND &#13;
				(END_TIMESTAMP  &amp;gt; ADD_SECONDS(CURRENT_UTCTIMESTAMP,-3600* '[Param.4]') OR&#13;
				END_TIMESTAMP IS NULL)&#13;
				) OR&#13;
			START_TIMESTAMP &amp;gt;= ADD_SECONDS(CURRENT_UTCTIMESTAMP,-3600* '[Param.4]') &#13;
			) AND&#13;
			EVENT_TYPE = 'UNSCD_DOWN' AND&#13;
			(&#13;
				(&#13;
					REASON_CODE2 in ('[Param.5]') OR&#13;
					REASON_CODE3 in ('[Param.5]') OR &#13;
					REASON_CODE4 in ('[Param.5]') OR &#13;
					REASON_CODE5 in ('[Param.5]') OR &#13;
					REASON_CODE6 in ('[Param.5]') OR &#13;
					REASON_CODE7 in ('[Param.5]') OR &#13;
					REASON_CODE8 in ('[Param.5]') OR &#13;
					REASON_CODE9 in ('[Param.5]') OR &#13;
					REASON_CODE10 in ('[Param.5]')&#13;
				) OR&#13;
				(&#13;
					(REASON_CODE1 IS NULL) AND &#13;
					('[Param.10]' = 'Y')&#13;
				)&#13;
			)&#13;
		) LV1 &#13;
	JOIN&#13;
			EOEE.MPM_MPH_NODET ON&#13;
				NODE_ID = IFNULL(RCM_NODE_ID, '[Param.3]') AND&#13;
				LANG = '[Param.8]'			&#13;
	WHERE&#13;
		REAL_EFFEC_DURATION &amp;gt;= '[Param.6]' * 60 AND&#13;
		REAL_EFFEC_DURATION &amp;lt;= '[Param.7]' * 60&#13;
	GROUP BY DESCRIPTION&#13;
	ORDER BY TOTAL_DURATION DESC&#13;
) LV2&#13;
WHERE TOTAL_DURATION &amp;gt; '[Param.9]'&lt;/QUERY&gt;&#13;
            &lt;QUERYPATH&gt;/src/eOEE/AlertManagement/Query&lt;/QUERYPATH&gt;&#13;
            &lt;USAGE&gt;eOEE/AlertManagement/Query/AlertRCDurationExceededGroupByRCMSelectQuery.tqsq&lt;/USAGE&gt;&#13;
        &lt;/Row&gt;&#13;
    &lt;/Rowset&gt;&#13;
