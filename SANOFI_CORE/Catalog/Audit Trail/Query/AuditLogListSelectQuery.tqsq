<?xml version="1.0" encoding="UTF-8" standalone="no"?><SQLQuery AllowBuffering="false" AllowFuture="true" AllowNullValues="false" AutoCommit="True" AutoTypeParameters="false" CacheDuration="0" CacheDurationUnits="M" Columns="" Comment="" Connector="" DateColumn="" DateFormat="MM/dd/yyyy HH:mm:ss" Debug="false" Description="" DocType="SQLQuery" Duration="60" DurationUnits="M" EndDate="02/15/2024 07:39:38" FilterExpr="" FixedQuery="" GroupingExpr="" HanaDataSource="False" ID="2500" InlineTransform="" IntervalCount="1" IsCachable="false" JoinExpr="" Mask="" Method="" Mode="FixedQuery" NumberFormat="0.00" Param.1="%%" Param.10="" Param.11="" Param.12="" Param.13="" Param.14="" Param.15="" Param.16="" Param.17="" Param.18="" Param.19="" Param.2="%%" Param.20="*" Param.21="" Param.22="" Param.23="" Param.24="" Param.25="" Param.26="" Param.27="" Param.28="" Param.29="" Param.3="%" Param.30="" Param.31="" Param.32="" Param.4="%" Param.5="%" Param.6="%" Param.7="%" Param.8="%%" Param.9="" ParamDescription.1="ID_PLANT" ParamDescription.10="" ParamDescription.11="" ParamDescription.12="" ParamDescription.13="" ParamDescription.14="" ParamDescription.15="" ParamDescription.16="" ParamDescription.17="" ParamDescription.18="" ParamDescription.19="" ParamDescription.2="DS_ACTION" ParamDescription.20="ID_PLANT_LIST" ParamDescription.21="" ParamDescription.22="" ParamDescription.23="" ParamDescription.24="" ParamDescription.25="" ParamDescription.26="" ParamDescription.27="" ParamDescription.28="" ParamDescription.29="" ParamDescription.3="DS_DB_TABLE" ParamDescription.30="" ParamDescription.31="" ParamDescription.32="" ParamDescription.4="DS_VALUE_OLD" ParamDescription.5="DS_VALUE_NEW" ParamDescription.6="DS_MESSAGE" ParamDescription.7="DS_USERNAME" ParamDescription.8="DS_APP" ParamDescription.9="" ParamType.1="" ParamType.10="" ParamType.11="" ParamType.12="" ParamType.13="" ParamType.14="" ParamType.15="" ParamType.16="" ParamType.17="" ParamType.18="" ParamType.19="" ParamType.2="" ParamType.20="" ParamType.21="" ParamType.22="" ParamType.23="" ParamType.24="" ParamType.25="" ParamType.26="" ParamType.27="" ParamType.28="" ParamType.29="" ParamType.3="" ParamType.30="" ParamType.31="" ParamType.32="" ParamType.4="" ParamType.5="" ParamType.6="" ParamType.7="" ParamType.8="" ParamType.9="" Password="" PathID="714" Query="SELECT&#10;&#9;ID_AUDIT_LOG,&#10;&#9;ID_PLANT,&#10;&#9;DS_ACTION,&#10;&#9;DS_DB_TABLE,&#10;&#9;DS_VALUE_OLD,&#10;&#9;DS_VALUE_NEW,&#10;&#9;DS_MESSAGE,&#10;&#9;DS_USERNAME,&#10;&#9;DS_COMMENT,&#10;&#9;DT_TIMESTAMP &#10;FROM&#10;&#9;SANOFI_CORE.CORE_AUDIT_LOG AUDIT_LOG &#10;WHERE&#10;&#9;ID_PLANT LIKE [Param.1]&#10;&#9;AND  &#10;&#9;(&#10;&#9;([Param.2] != '%' AND DS_ACTION LIKE [Param.2])&#10;&#9;&#9;OR &#10;&#9;&#9;(&#10;&#9;&#9;&#9;[Param.2] = '%' AND DS_ACTION IN ('INSERT', 'UPDATE', 'DELETE')&#10;&#9;&#9;)&#10;&#9;)&#10;&#9;AND  &#10;&#9;(&#10;&#9;&#9;UPPER(DS_DB_TABLE) LIKE UPPER([Param.3])&#10;&#9;&#9;OR&#10;&#9;&#9;(&#10;&#9;&#9;&#9;[Param.3] = '%%' AND (DS_DB_TABLE IS NULL)&#10;&#9;&#9;)&#10;&#9;)&#10;&#9;AND  &#10;&#9;(&#10;&#9;&#9;UPPER(DS_VALUE_OLD) LIKE UPPER([Param.4])&#10;&#9;&#9;OR&#10;&#9;&#9;(&#10;&#9;&#9;&#9;[Param.4] = '%%' AND (DS_VALUE_OLD IS NULL)&#10;&#9;&#9;)&#10;&#9;)&#10;&#9;AND  &#10;&#9;(&#10;&#9;&#9;UPPER(DS_VALUE_NEW) LIKE UPPER([Param.5])&#10;&#9;&#9;OR&#10;&#9;&#9;(&#10;&#9;&#9;&#9;[Param.5] = '%%' AND (DS_VALUE_NEW IS NULL)&#10;&#9;&#9;)&#10;&#9;)&#10;&#9;AND  &#10;&#9;(&#10;&#9;&#9;UPPER(DS_MESSAGE) LIKE UPPER([Param.6])&#10;&#9;&#9;OR&#10;&#9;&#9;(&#10;&#9;&#9;&#9;[Param.6] = '%%' AND (DS_MESSAGE IS NULL)&#10;&#9;&#9;)&#10;&#9;)&#10;&#9;AND  &#10;&#9;(&#10;&#9;&#9;UPPER(DS_USERNAME) LIKE UPPER([Param.7])&#10;&#9;&#9;OR&#10;&#9;&#9;(&#10;&#9;&#9;&#9;[Param.7] = '%%' AND (DS_USERNAME IS NULL)&#10;&#9;&#9;)&#10;&#9;)&#10;&#9;AND  DT_TIMESTAMP &gt;= TO_TIMESTAMP([SD], 'YYYY-MM-DD&quot; &quot;HH24:MI:SS')&#10;&#9;AND  DT_TIMESTAMP &lt; TO_TIMESTAMP([ED], 'YYYY-MM-DD&quot; &quot;HH24:MI:SS')&#10;&#9;AND  &#10;&#9;(&#10;&#9;&#9;ID_PLANT IN(SELECT RESULT FROM SQLSCRIPT_STRING:SPLIT_TO_TABLE([Param.20], ','))&#10;&#9;&#9;OR [Param.20] = '*'&#10;&#9;)&#10;&#9;AND &#10;&#9;(&#10;&#9;&#9;([Param.8] != '%' AND DS_APP LIKE [Param.8])&#10;&#9;)&#10;ORDER BY&#10;&#9;DT_TIMESTAMP DESC,&#10;&#9;ID_PLANT ASC,&#10;&#9;DS_DB_TABLE ASC" QueryParams="" ReaderRoles="SAP_XMII_User" RestrictedPropertyOverride="false" ResultSetMode="false" RowCount="10000" SaveDate="02/15/2024 07:40:46" Schedule="" SelectedColumns="" Server="Z_OEE" Service="" SetMaxRows="true" SortExpr="" StartDate="02/01/2021 07:39:49" Tables="" Time="" TimePeriod="" Trace="false" TransformerLibrary="" UseTypedParams="T" UserName="" Version="15.5.1.41" WriterRoles="SAP_XMII_Super_Administrator,SAP_XMII_Administrator,SAP_XMII_Developer" XParamName.1="" XParamName.10="" XParamName.11="" XParamName.12="" XParamName.13="" XParamName.14="" XParamName.15="" XParamName.16="" XParamName.2="" XParamName.3="" XParamName.4="" XParamName.5="" XParamName.6="" XParamName.7="" XParamName.8="" XParamName.9="" XParamValue.1="" XParamValue.10="" XParamValue.11="" XParamValue.12="" XParamValue.13="" XParamValue.14="" XParamValue.15="" XParamValue.16="" XParamValue.2="" XParamValue.3="" XParamValue.4="" XParamValue.5="" XParamValue.6="" XParamValue.7="" XParamValue.8="" XParamValue.9="" XmlDateFormat="yyyy-MM-dd'T'HH:mm:ss" XmlNumberFormat=""><Tasks/><ETCServers/><ETCObjects/></SQLQuery>