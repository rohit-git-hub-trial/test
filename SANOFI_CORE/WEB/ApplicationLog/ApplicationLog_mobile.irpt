		<!--@@****************************************************************  Your file(s) ends here  ******************************************************************@@-->
		<script type="text/javascript">
			window["Settings"]= {"General":{"Header":{"URL":"","Height":""},"Footer":{"URL":"","Height":""},"ShowAlert":"N","TagRefreshRate":"","PageStyle":{"CSSFile":"/XMII/JavaScript/resources/lightBlue.css","CellStyleClass":"","CellTitleStyleClass":""},"MobilePageView":0,"JsSeparation":false,"Parameters":[],"Events":[],"ParametersSettings":{"SkipUserInput":false,"AllowUserInput":false}}};
			generateGlobalParameters();
				$(document).ready(function (){onPageReady();});
		</script>
		<script type="text/javascript">
				$(document).ready(function (){
					onDocumentReady();
					bindEvent(Settings.General.Events);
				});
		</script>
		<script type="text/javascript" src="/XMII/CompositionEnvironment/js/customControls/tag-color-picker.js"></script>
		<link rel="stylesheet" type="text/css" href="/XMII/CompositionEnvironment/StyleSheets/ssce.css"></link>
	</head>
	<body style="padding:none;width:99%;height:98vh">
	<div id="SSCEheader">
	</div>
	<div id="parentDiv" style="height:99vh;width:100%;overflow: auto;">
		<table id="mobileTable" style="table-layout:fixed;position:absolute;height:98vh;width:98%;border-collapse:collapse;">
			<tr id="mobileTableRow" style="height:100%">
				<td id="swipeCell" class="borderWhite" style="overflow:hidden;height:100%;width:100%">
					<div id="uiElementc0c0" class="formStyle" style="width:100%;height:98vh;">
					<script>
						try{
							jQuery.sap.registerModulePath("CECustomControls", "/XMII/CompositionEnvironment/js/customControls");
							jQuery.sap.require("CECustomControls.UIElementTextField");
							jQuery.sap.require("CECustomControls.UIElementTextView");
							jQuery.sap.require("CECustomControls.UIElementDropDown");
							jQuery.sap.require("CECustomControls.UIElementButton");
							jQuery.sap.require("CECustomControls.UIElementTextFieldM");
							jQuery.sap.require("CECustomControls.UIElementTextViewM");
							jQuery.sap.require("CECustomControls.UIElementLabelM");
							jQuery.sap.require("CECustomControls.UIElementDropDownM");
							jQuery.sap.require("CECustomControls.UIElementButtonM");
							jQuery.sap.require("CECustomControls.UIElementTextAreaM");
							jQuery.sap.require("CECustomControls.UIElementRadioButtonM");
							jQuery.sap.require("CECustomControls.UIElementCheckBoxM");
							jQuery.sap.require("CECustomControls.SSCEValueHelpDialog");
							jQuery.sap.require("CECustomControls.IconComboBox");
							jQuery.sap.require("CECustomControls.UIElementList");

							var form_c0c0 = new com.sap.xmii.ssce.Form(({Columns:10,Rows:1}));

							form_c0c0.draw("c0c0");

						}catch(err){
							sap.ui.core.BusyIndicator.hide();
							console.log("An error has occured: " + err.name + "-" + err.message);
						}
					</script>
						</div>
				<div id="c0c3" style="width:100%;height:98vh;border:none;height:98vh"></div>
				<div id="c0c4" style="width:100%;height:98vh;border:none;height:98vh"></div>
				<div id="c0c7" style="width:100%;height:98vh;border:none;height:98vh"></div>
				<div id="c0c8" style="width:100%;height:98vh;border:none;height:98vh"></div>
				<div id="c0c9" style="width:100%;height:98vh;border:none;height:98vh"></div>
					<div id="gridc1c0" style="width:100%;height:98vh;">
					<script>
						try{
							var grid_c1c0 = new com.sap.xmii.grid.init.i5Grid("SANOFI_CORE/ApplicationLog/Display/ApplicationLogi5Grid","SANOFI_CORE/ApplicationLog/Query/ApplicationLogXquery",true);
						grid_c1c0.registerCreationEventHandler(ceController.addObject("c1c0",grid_c1c0));
							grid_c1c0.draw("gridc1c0");

						}catch(err){
							sap.ui.core.BusyIndicator.hide();
							console.log("An error has occured: " + err.name + "-" + err.message);
