<div id="bottom" style="position:absolute;bottom:0px;left:0px;width:98%; height:-1vh;">
	<div id="SSCEfooter" style="position:absolute;left:0;width:100%">
	</div>
	<div id="errorMessages" style="position:absolute;top:5px;left:0px;width:98%; height:40%;">
	</div>
	<div id="toolBar" style="position:absolute;bottom:0px;left:0px;width:100%; height:50%;text-align:center;">
		<button tabindex="0" style="left:10px;position:absolute" class="sapUiBtn sapUiBtnFixedWidth sapUiBtnNorm sapUiBtnS sapUiBtnStd" onclick="swipeContent('right')">|<<</button>
		<button id="desktopVersion" tabindex="0" style="" class="sapUiBtn sapUiBtnFixedWidth sapUiBtnNorm sapUiBtnS sapUiBtnStd" onclick="requestDesktopSite()"></button>
		<button tabindex="0" style="right:0px;position:absolute" class="sapUiBtn sapUiBtnFixedWidth sapUiBtnNorm sapUiBtnS sapUiBtnStd" onclick="swipeContent('left')">>>|</button>
	</div>
</div>
	<script>
			//@@*****************************************************************  Your code starts here  *****************************************************************@@






			
			
			
			
			
			//@@**************************************************************  Your code ends here  **************************************************************@@
	</script>
	<script>
		jQuery.sap.byId("desktopVersion").text(oBundle.getText("REQUEST_DSKTP_SITE"));
		var charts=["c0c0","c0c3","c0c4","c0c7","c0c8","c0c9","c1c0"];
		var currentChartIndex = 0;
		var changed = 1;
	</script>
	<script>
		function onPageReady() {
			for (var k = 1; k < charts.length; k++) {
				jQuery('div[id$=' + charts[k] + ']').hide();
			}
		}

		function swipeContent(direction) {
			if (direction != "left" && direction != "right")
				return;
			var chartModified = false;
			var oldChartIndex = currentChartIndex;
			if(direction=="left" && currentChartIndex != charts.length-1){
				currentChartIndex++;
				if (changed <= charts.length)
					changed++;
				chartModified = true;
			} else {
				if (direction=="right" && currentChartIndex != 0){
					currentChartIndex--;
					chartModified = true;
				}
			}
			if (chartModified) {
				if (direction == "left") {
					jQuery('div[id$=' + charts[oldChartIndex] + ']').animate({
						'marginRight': '102%'
						}, 'slow',function(){
							jQuery('div[id$=' + charts[oldChartIndex] + ']').hide();
							jQuery('div[id$=' + charts[currentChartIndex] + ']').show();
							jQuery('div[id$=' + charts[currentChartIndex] + ']').animate({marginLeft: '0%'}, 'slow', function () {
								var id = jQuery('div[id$=' + charts[currentChartIndex] + ']')[0].id;
								id = id.match("c[0-9]+c[0-9]+");
								var object = ceController.miiUI5Objects[id];
								if (changed <= charts.length)  {
									if (object !== undefined && object != null) {
										if(object instanceof com.sap.xmii.chart.hchart.i5Chart || (eval('com.sap.xmii.chart.hchart.i5SPCChart') !== undefined && object instanceof com.sap.xmii.chart.hchart.i5SPCChart) || (eval('com.sap.xmii.grid') !== undefined && eval('com.sap.xmii.grid.init.i5Grid') !== undefined && object instanceof com.sap.xmii.grid.init.i5Grid)){
											object.refresh();
										}
										if(eval('com.sap.xmii.ssce') !== undefined && eval('com.sap.xmii.ssce.KPIView') !== undefined && object instanceof com.sap.xmii.ssce.KPIView) {
											ceController.miiUI5Objects[charts[currentChartIndex]].kpiTileView.rerender();
										}
									}
								}
								if (changed == charts.length)
									changed++;
							});
						});
					} else if (direction == "right") {
						jQuery('div[id$=' + charts[oldChartIndex] + ']').animate({
							'marginLeft': '102%'
							}, 'slow',function(){
								jQuery('div[id$=' + charts[oldChartIndex] + ']').hide();
								jQuery('div[id$=' + charts[currentChartIndex] + ']').show();
								jQuery('div[id$=' + charts[currentChartIndex] + ']').animate({marginRight: '0%'}, 'slow', function () {
									var id = jQuery('div[id$=' + charts[currentChartIndex] + ']')[0].id;
									id = id.match("c[0-9]+c[0-9]+");
									var object = ceController.miiUI5Objects[id];
									if (changed <= charts.length)  {
										if (object !== undefined && object != null) {
										if(object instanceof com.sap.xmii.chart.hchart.i5Chart || (eval('com.sap.xmii.chart.hchart.i5SPCChart') !== undefined && object instanceof com.sap.xmii.chart.hchart.i5SPCChart) || (eval('com.sap.xmii.grid') !== undefined && eval('com.sap.xmii.grid.init.i5Grid') !== undefined && object instanceof com.sap.xmii.grid.init.i5Grid)){
												object.refresh();
											}
										}
									}
									if (changed == charts.length)
										changed++;
								});
							});
						}
					}
		}
		$(function() {
			$("#swipeCell").swipe( {
				swipe:function(event, direction, distance, duration, fingerCount) {
					swipeContent(direction);
				}
			});
		});
	</script>
	</body>
</html>