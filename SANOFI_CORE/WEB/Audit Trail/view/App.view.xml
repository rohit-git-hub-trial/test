<mvc:View controllerName="AuditTrail.controller.App"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:html="http://www.w3.org/1999/xhtml" displayBlock="true"
	xmlns="sap.m">
	<Toolbar id="appToolbar" >
		<Image src="image/sanofi_logo.png" width="auto" height="30.5px" visible="true" densityAware="false" class="sapUiSmallMarginBegin" />
		<ToolbarSpacer />
		<Title id="toolbar-appTile" text="{i18n>auditTrail}" level="H2" titleStyle="H2">
			<layoutData>
				<OverflowToolbarLayoutData priority="Disappear" />
			</layoutData>
		</Title>
		<ToolbarSpacer />
	</Toolbar>
	<App id="idAppControl"  height="calc(100% - 3rem)"/>
</mvc:View>